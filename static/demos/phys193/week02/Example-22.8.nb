(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 22.8 - An Accelerated Electron", "Title"],

Cell["PHYS 193 \:00b7 Week 2 \:00b7 Chapter 22 \:00b7 Lecture slide 69 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["An electron enters the region of a uniform electric field as shown in Figure 22.21, with vi = 3.00 x 10^6 m/s and E = 200 N/C. The horizontal length of the plates is l = 0.100 m. (A) Find the acceleration of the electron while it is in the electric field. (B) Assuming the electron enters the field at time t = 0, find the time at which it leaves the field. (C) Assuming the vertical position of the electron as it enters the field is yi = 0, what is its vertical position when it leaves the field?", "Text"],

Cell["(A) ay = -eE/me = -3.51 x 10^13 m/s^2. (B) t = l/vi = 3.33 x 10^-8 s. (C) yf = (1/2) ay t^2 = -0.0195 m = -1.95 cm. Gravity is negligible.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 22.21: an electron is projected horizontally into a uniform electric field produced by two charged plates. The electron undergoes a downward acceleration (opposite E), and its motion is parabolic while it is between the plates. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from Coulomb's law, the electric field and the motion of charged particles in a uniform field; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};

(* a point charge drawn as a disc: red with + for q > 0, blue with - for q < 0 *)
chargeG[p_, q_, r_ : 0.06] := {If[q > 0, RGBColor[0.80, 0.25, 0.30], RGBColor[0.20, 0.40, 0.80]], Disk[p, r],
   White, AbsoluteThickness[2], Line[{p - {0.55 r, 0}, p + {0.55 r, 0}}], If[q > 0, Line[{p - {0, 0.55 r}, p + {0, 0.55 r}}], {}]};
(* a force or field arrow from p along v, in colour col *)
vecG[p_, v_, col_, lab_ : \"\"] := {col, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{p, p + v}],
   If[lab === \"\", {}, Text[Style[lab, 13, Bold, col], p + 1.15 v]]};
e = 1.60*^-19; me = 9.11*^-31; g = 9.80;
ay[ef_] := -e ef/me;
tExit[vi_, l_] := l/vi;
yExit[vi_, ef_, l_] := ay[ef] tExit[vi, l]^2/2;", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 With[{vi = 10^lv, l = len},
  Column[{
    Plot[ay[ef] (x/vi)^2/2 100, {x, 0, l}, Frame -> True, FrameLabel -> {\"x (m)\", \"y (cm)\"}, PlotStyle -> Directive[maroon, Thick],
     GridLines -> {None, {-gap}}, PlotRange -> {Min[-1.2 gap, 1.1 yExit[vi, ef, l] 100], 0.2}, ImageSize -> 420,
     Epilog -> {blue, Thick, Line[{{0, -gap}, {l, -gap}}]}],
    results[{{\"(A) ay\", Row[{NumberForm[ay[ef], 4], \" m/s^2\"}]}, {\"(B) t\", Row[{NumberForm[tExit[vi, l], 4], \" s\"}]},
      {\"(C) yf\", Row[{NumberForm[100 yExit[vi, ef, l], 4], \" cm\"}]},
      {\"fate\", If[-100 yExit[vi, ef, l] > gap, \"strikes the positive plate at x = \" <> ToString[NumberForm[100 vi Sqrt[2 gap/100/-ay[ef]], 3]] <> \" cm\", \"leaves the field\"]}}]}, Spacings -> 1]],
 {{lv, Log10[3*^6], \"log10 vi (m/s)\"}, 5, 7, Appearance -> \"Labeled\"}, {{ef, 200, \"E (N/C)\"}, 10, 2000, Appearance -> \"Labeled\"},
 {{len, 0.1, \"l (m)\"}, 0.02, 0.2, Appearance -> \"Labeled\"}, {{gap, 3, \"plate depth below entry (cm)\"}, 0.5, 5, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {lv, ef, len, gap}]", "Input"],

Cell["Check the numbers - full motion with gravity, by NDSolve", "Section"],

Cell["With[{vi = 3.*^6, ef = 200., l = 0.1},
 With[{sol = NDSolveValue[{y''[t] == ay[ef] - g, y[0] == 0, y'[0] == 0}, y, {t, 0, tExit[vi, l]}]},
  {\"(A) ay (book -3.51e13)\" -> ay[ef], \"(B) t (book 3.33e-8 s)\" -> tExit[vi, l], \"(C) yf (book -0.0195 m)\" -> yExit[vi, ef, l],
   \"NDSolve yf with gravity\" -> sol[tExit[vi, l]], \"mg/(eE)\" -> me g/(e ef)}]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
