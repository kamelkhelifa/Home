(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 31.6 - Oscillations in an LC Circuit", "Title"],

Cell["PHYS 193 \:00b7 Week 12 \:00b7 Chapter 31 \:00b7 Lecture slide 75 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["In Figure 31.11 the battery has emf 12.0 V, L = 2.81 mH and C = 9.00 pF. The switch has been at a for a long time, charging the capacitor, and is then thrown to b, connecting the capacitor across the inductor. (A) Find the frequency of oscillation. (B) Find the maximum charge on the capacitor and the maximum current.", "Text"],

Cell["f = 1/(2 pi sqrt(LC)) = 1.00 MHz; Q_max = C emf = 108 pC; I_max = omega Q_max = 679 microamps. The energy, 648 pJ, moves back and forth between q^2/2C and (1/2) L i^2.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 31.11: a simple LC circuit. The capacitor is charged by the battery with the switch at a; at t = 0 the switch is thrown to b, connecting the capacitor across the inductor. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the inductor laws (self- and mutual inductance, RL and LC circuits); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
omegaLC[l_, c_] := 1/Sqrt[l c];
qLC[t_, q0_, w_] := q0 Cos[w t];
iLC[t_, q0_, w_] := -w q0 Sin[w t];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{l = lmH/1000., c = cpF 10.^-12, w, q0, tt, q, cur, ue, ub, ut, fig},
  w = omegaLC[l, c]; q0 = c e; tt = u 2 Pi/w; q = qLC[tt, q0, w]; cur = iLC[tt, q0, w]; ue = q^2/(2 c); ub = l cur^2/2; ut = q0^2/(2 c);
  fig = Graphics[{
     wire[{{0, 0.9}, {0, 0}, {2.4, 0}, {2.4, 1.2}}], wire[{{2.4, 1.8}, {2.4, 3}, {0, 3}, {0, 2.1}}],
     Table[{RGBColor[0.78, 0.18, 0.23], AbsoluteThickness[2.5], Circle[{0, 1.95 - 0.3 k}, 0.15, {Pi/2, 3 Pi/2}]}, {k, 0, 3}], lbl[\"L\", {-0.45, 1.5}, Italic],
     capacitorG[{2.4, 1.2}, {2.4, 1.8}], lbl[\"C\", {2.85, 1.5}, Italic],
     Text[Style[If[q > 0, \"+\", \"\\[Minus]\"], 14 + 8 Abs[q/q0], Bold, maroon], {2.1, 1.65}], Text[Style[If[q > 0, \"\\[Minus]\", \"+\"], 14 + 8 Abs[q/q0], Bold, blue], {2.1, 1.35}],
     currentG[{0.5, 3}, {1.9, 3}, -cur, Row[{\"i = \", NumberForm[10^6 Abs[cur], 3], \" \\[Mu]A\"}], 0.25],
     Text[Style[Row[{\"q = \", NumberForm[10^12 q, 3], \" pC\"}], 11, maroon], {2.4, 3.35}],
     {maroon, Rectangle[{3.4, 0}, {4.0, 3 ue/ut}]}, {blue, Rectangle[{4.4, 0}, {5.0, 3 ub/ut}]},
     {GrayLevel[0.7], Line[{{3.4, 0}, {3.4, 3}, {4.0, 3}, {4.0, 0}}], Line[{{4.4, 0}, {4.4, 3}, {5.0, 3}, {5.0, 0}}]},
     Text[Style[\"U_E in C\", 10], {3.7, -0.25}], Text[Style[\"U_B in L\", 10], {4.7, -0.25}]},
    PlotRange -> {{-0.9, 5.3}, {-0.5, 3.6}}, AspectRatio -> Automatic, ImageSize -> 440];
  Column[{fig,
    Plot[{Cos[2 Pi x], -Sin[2 Pi x]}, {x, 0, 2}, PlotStyle -> {Directive[maroon, Thick], Directive[RGBColor[0.48, 0.25, 0.69], Thick]},
     PlotLegends -> Placed[{\"q / Q_max\", \"i / I_max\"}, {Right, Top}], Frame -> True, FrameLabel -> {\"t / T\", \"\"}, GridLines -> {{u}, {0}}, ImageSize -> 440],
    Plot[{10^12 ut Cos[2 Pi x]^2, 10^12 ut Sin[2 Pi x]^2, 10^12 ut}, {x, 0, 2}, PlotStyle -> {Directive[maroon, Thick], Directive[blue, Thick], Directive[gold, Dashed]},
     PlotLegends -> Placed[{\"U_E\", \"U_B\", \"U_E + U_B\"}, Below], Frame -> True, FrameLabel -> {\"t / T\", \"energy (pJ)\"}, GridLines -> {{u}, None}, ImageSize -> 440],
    results[{
      {\"(A) f = 1/(2\\[Pi]\\[Sqrt](LC))\", Row[{ScientificForm[w/(2 Pi), 4], \" Hz\"}]},
      {\"(B) Q_max = C\\[CurlyEpsilon]\", Row[{NumberForm[10^12 q0, 4], \" pC\"}]},
      {\"(B) I_max = \\[Omega] Q_max\", Row[{NumberForm[10^6 w q0, 4], \" \\[Mu]A\"}]},
      {\"total energy \\.bd C\\[CurlyEpsilon]\\.b2 = \\.bd L I_max\\.b2\", Row[{NumberForm[10^12 ut, 4], \" pJ\"}]}}]}, Spacings -> 1.2]],
 {{e, 12., \"emf (V)\"}, 1, 24, 0.5, Appearance -> \"Labeled\"},
 {{lmH, 2.81, \"L (mH)\"}, 0.1, 30, 0.01, Appearance -> \"Labeled\"},
 {{cpF, 9., \"C (pF)\"}, 1, 100, 0.5, Appearance -> \"Labeled\"},
 {{u, 0.15, \"time in periods\"}, 0, 2, ControlType -> Animator, AnimationRate -> 0.25, AnimationRunning -> False},
 ControlPlacement -> Left, TrackedSymbols :> {e, lmH, cpF, u}]", "Input"],

Cell["Going further - where the energy is", "Section"],

Cell["(* All in C at t = 0; all in L a quarter period later; the sum q^2/2C + L i^2/2 is constant. *)
Simplify[qLC[t, q0v, 1/Sqrt[lv cv]]^2/(2 cv) + lv iLC[t, q0v, 1/Sqrt[lv cv]]^2/2]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The loop equation L q'' + q/C = 0 integrated numerically (NDSolve) against Q_max cos(omega t); period from the zero crossings. *)
With[{e = 12., l = 2.81*^-3, c = 9.*^-12},
 Module[{w = omegaLC[l, c], q0 = c e, per, sol, zeros},
  per = 2 Pi/w;
  sol = NDSolveValue[{l q''[t] + q[t]/c == 0, q[0] == q0, q'[0] == 0}, q, {t, 0, 2 per}, AccuracyGoal -> 14, PrecisionGoal -> 12, MaxSteps -> 10^6];
  zeros = Table[t /. FindRoot[sol[t] == 0, {t, (2 k - 1) per/4}], {k, 1, 3}];
  Column[{Grid[Prepend[Table[{k, NumberForm[10^12 sol[k per], 8], NumberForm[10^12 qLC[k per, q0, w], 8]}, {k, {0.1, 0.25, 0.4, 0.75, 1.}}], {\"t / T\", \"NDSolve (pC)\", \"formula (pC)\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]],
    Row[{\"period from zero crossings: \", zeros[[3]] - zeros[[1]], \" s;  2\\[Pi]\\[Sqrt](LC) = \", per, \" s;  f = \", 1/per, \" Hz\"}],
    Row[{\"Q_max = \", q0, \" C;  I_max = \", w q0, \" A\"}]}]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
