(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 31.4 - The Coaxial Cable", "Title"],

Cell["PHYS 193 \:00b7 Week 12 \:00b7 Chapter 31 \:00b7 Lecture slide 47 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["Model a long coaxial cable as a thin cylindrical conducting shell of radius b concentric with a solid cylinder of radius a (Figure 31.8). The conductors carry the same current i in opposite directions. Calculate the inductance L of a length l of this cable.", "Text"],

Cell["Between the conductors B = mu0 i/(2 pi r). The flux through a radial slice of length l is the integral of B l dr from a to b, (mu0 i l/2 pi) ln(b/a), and L = Phi/i = (mu0 l/2 pi) ln(b/a): a single geometric turn. The book gives no numbers; the model starts from a = 0.50 mm, b = 3.5 mm, l = 1.0 m, i = 1.0 A.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 31.8: a section of a long coaxial cable. The inner conductor (radius a) and the thin outer shell (radius b) carry equal currents i in opposite directions; the light rectangle is a radial slice of length \:2113. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the inductor laws (self- and mutual inductance, RL and LC circuits); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
mu0 = 4 Pi 10.^-7;
bCoax[r_, i_, a_, b_] := If[a <= r <= b, mu0 i/(2 Pi r), 0];
lCoax[l_, a_, b_] := mu0 l/(2 Pi) Log[b/a];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{a = Min[amm, 0.9 bmm]/1000., b = bmm/1000., ind, pts, fig},
  ind = lCoax[l, a, b];
  pts = Table[{a + k (b - a)/n, Sum[bCoax[a + (j - 1/2) (b - a)/n, i, a, b] l (b - a)/n, {j, k}]}, {k, n}];
  fig = Graphics[{
     Table[{green, Opacity[0.5 a/rr], Disk[{0, 0}, rr + (b - a)/40], White, Opacity[1], Disk[{0, 0}, rr]}, {rr, b, a, -(b - a)/40}] // Reverse,
     Table[{green, Circle[{0, 0}, rr]}, {rr, a + 0.3 (b - a), b, 0.3 (b - a)}],
     {ink, AbsoluteThickness[4], Circle[{0, 0}, b]}, {gold, EdgeForm[ink], Disk[{0, 0}, a]},
     {gold, AbsoluteThickness[4], Line[{{a, 0}, {b, 0}}]}, Table[{ink, Line[{{a + k (b - a)/n, -0.03 b}, {a + k (b - a)/n, 0.03 b}}]}, {k, 0, n}],
     Text[Style[\"\\[CircleDot] i\", 11, Bold], {0, 0}], Text[Style[\"\\[CircleTimes] i (shell)\", 11], {0.7 b, -0.85 b}],
     Text[Style[\"slice, seen edge-on\", 10, Gray], {(a + b)/2, -0.1 b}]},
    PlotRange -> 1.15 b, ImageSize -> 320];
  Column[{fig,
    Show[Plot[10^6 mu0 i l/(2 Pi) Log[r/a], {r, a, b}, PlotStyle -> Directive[maroon, Thick], Frame -> True, FrameLabel -> {\"r (m)\", \"\\[CapitalPhi]_B(a \\[Rule] r) (\\[Mu]Wb)\"},
      GridLines -> {None, {10^6 mu0 i l/(2 Pi) Log[b/a]}}, GridLinesStyle -> Directive[gold, Dashed], PlotRange -> All, ImageSize -> 440],
     ListPlot[Map[{#[[1]], 10^6 #[[2]]} &, pts], PlotStyle -> {maroon, PointSize[0.015]}]],
    results[{
      {\"L = (\\[Mu]0 l/2\\[Pi]) ln(b/a)\", Row[{NumberForm[10^6 ind, 4], \" \\[Mu]H\"}]},
      {\"per metre\", Row[{NumberForm[10^6 ind/l, 4], \" \\[Mu]H/m\"}]},
      {\"flux through the slice\", Row[{NumberForm[10^6 ind i, 4], \" \\[Mu]Wb\"}]},
      {\"B at r = a\", Row[{NumberForm[10^6 bCoax[a, i, a, b], 4], \" \\[Mu]T\"}]}}]}, Spacings -> 1.2]],
 {{amm, 0.5, \"inner radius a (mm)\"}, 0.1, 3, 0.05, Appearance -> \"Labeled\"},
 {{bmm, 3.5, \"outer radius b (mm)\"}, 1, 20, 0.1, Appearance -> \"Labeled\"},
 {{l, 1., \"length l (m)\"}, 0.1, 10, 0.1, Appearance -> \"Labeled\"},
 {{i, 1., \"current i (A)\"}, 0.1, 5, 0.1, Appearance -> \"Labeled\"},
 {{n, 6, \"strips drawn\"}, 2, 16, 1, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {amm, bmm, l, i, n}]", "Input"],

Cell["Going further - why a logarithm?", "Section"],

Cell["(* B falls as 1/r, so every decade of radius adds the same flux: mu0 l ln 10/(2 pi) = 0.46 microhenry per metre. *)
Column[{Integrate[mu0v iv/(2 Pi r) lv, {r, av, bv}, Assumptions -> bv > av > 0], Row[{\"per decade, per metre: \", 10^6 mu0 Log[10]/(2 Pi), \" \\[Mu]H/m\"}]}]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The flux integral numerically, and a second route through the field energy U = integral of B^2/(2 mu0) dV = (1/2) L i^2. *)
With[{a = 0.0005, b = 0.0035, l = 1., i = 1.},
 Module[{flux, u},
  flux = NIntegrate[bCoax[r, i, a, b] l, {r, a, b}];
  u = NIntegrate[bCoax[r, i, a, b]^2/(2 mu0) 2 Pi r l, {r, a, b}];
  Grid[{{\"\\[CapitalPhi]/i (\\[Mu]H)\", 10^6 flux/i}, {\"2U/i\\.b2 (\\[Mu]H)\", 10^6 2 u/i^2}, {\"(\\[Mu]0 l/2\\[Pi]) ln(b/a) (\\[Mu]H)\", 10^6 lCoax[l, a, b]}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
