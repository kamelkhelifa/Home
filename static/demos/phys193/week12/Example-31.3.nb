(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 31.3 - What Happens to the Energy in the Inductor?", "Title"],

Cell["PHYS 193 \:00b7 Week 12 \:00b7 Chapter 31 \:00b7 Lecture slide 43 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["In the RL circuit of Figure 31.5a the current has reached its steady value with S2 at a. When S2 is thrown to b the current decays as i = (emf/R) e^(-t/tau). Show that all the energy initially stored in the magnetic field of the inductor appears as internal energy in the resistor as the current decays to zero.", "Text"],

Cell["dE_int/dt = i^2 R = I_i^2 R e^(-2Rt/L); integrating from 0 to infinity gives I_i^2 R (L/2R) = (1/2) L I_i^2, the stored energy. The starting values are those of Example 31.2 (I_i = 2.00 A, 60.0 mJ). The total does not depend on R; the energy decays with time constant L/2R.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 31.5a: the RL circuit. After the current has reached its steady value, S\:2082 is thrown from a to b, leaving the inductor and the resistor in a loop without the battery. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the inductor laws (self- and mutual inductance, RL and LC circuits); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
stored[l_, ii_] := l ii^2/2;
uField[t_, l_, r_, ii_] := l (ii Exp[-r t/l])^2/2;             (* energy still in the field *)", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{l = lmH/1000., ii = e/r, tau, t, ub, ei, fig},
  tau = l/r; t = u tau; ub = uField[t, l, r, ii]; ei = stored[l, ii] - ub;
  fig = Graphics[{
     wire[{{0, 0}, {0, 0.9}}], resistorG[{0, 0.9}, {0, 2.1}], wire[{{0, 2.1}, {0, 3}, {2.4, 3}, {2.4, 2.1}}], lbl[\"R\", {-0.4, 1.5}, Italic],
     Table[{RGBColor[0.78, 0.18, 0.23], AbsoluteThickness[2.5], Circle[{2.4, 1.95 - 0.3 k}, 0.15, {-Pi/2, Pi/2}]}, {k, 0, 3}], lbl[\"L\", {2.85, 1.5}, Italic],
     wire[{{2.4, 0.9}, {2.4, 0}, {0, 0}}], nodeG[{0, 3}, \"b\", {-0.2, 0.15}],
     currentG[{0.6, 3}, {1.8, 3}, ii Exp[-u], Row[{\"i = \", NumberForm[ii Exp[-u], 3], \" A\"}], 0.25],
     {blue, Rectangle[{3.6, 0}, {4.2, 3 ub/stored[l, ii]}]}, {maroon, Rectangle[{4.6, 0}, {5.2, 3 ei/stored[l, ii]}]},
     {GrayLevel[0.7], Line[{{3.6, 0}, {3.6, 3}, {4.2, 3}, {4.2, 0}}], Line[{{4.6, 0}, {4.6, 3}, {5.2, 3}, {5.2, 0}}]},
     Text[Style[\"in L\", 11], {3.9, -0.25}], Text[Style[\"in R\", 11], {4.9, -0.25}],
     Text[Style[Row[{NumberForm[1000 ub, 3], \" mJ\"}], 10, blue], {3.9, 3 ub/stored[l, ii] + 0.2}], Text[Style[Row[{NumberForm[1000 ei, 3], \" mJ\"}], 10, maroon], {4.9, 3 ei/stored[l, ii] + 0.2}]},
    PlotRange -> {{-0.8, 5.6}, {-0.5, 3.6}}, AspectRatio -> Automatic, ImageSize -> 460];
  Column[{fig,
    Plot[{1000 uField[x tau, l, r, ii], 1000 (stored[l, ii] - uField[x tau, l, r, ii])}, {x, 0, 5}, PlotStyle -> {Directive[blue, Thick], Directive[maroon, Thick]},
     PlotLegends -> Placed[{\"U_B still in the field\", \"E_int delivered to R\"}, {Right, Center}], Frame -> True, FrameLabel -> {\"t / \\[Tau]\", \"energy (mJ)\"},
     GridLines -> {{0.5, u}, {1000 stored[l, ii]}}, GridLinesStyle -> Directive[Gray, Dashed], ImageSize -> 460],
    results[{
      {\"stored at t = 0, \\.bd L I_i\\.b2\", Row[{NumberForm[1000 stored[l, ii], 4], \" mJ  (I_i = \", NumberForm[ii, 3], \" A)\"}]},
      {\"current i(t)\", Row[{NumberForm[ii Exp[-u], 4], \" A\"}]},
      {\"still in the field, \\.bd L i\\.b2\", Row[{NumberForm[1000 ub, 4], \" mJ\"}]},
      {\"delivered to R so far\", Row[{NumberForm[1000 ei, 4], \" mJ\"}]}}]}, Spacings -> 1.2]],
 {{e, 12., \"emf (V), sets I_i = emf/R\"}, 1, 24, 0.5, Appearance -> \"Labeled\"},
 {{r, 6., \"R (ohm)\"}, 0.5, 60, 0.5, Appearance -> \"Labeled\"},
 {{lmH, 30., \"L (mH)\"}, 1, 200, 1, Appearance -> \"Labeled\"},
 {{u, 0.5, \"time after the throw, in units of \\[Tau]\"}, 0, 5, ControlType -> Animator, AnimationRate -> 1, AnimationRunning -> False},
 ControlPlacement -> Left, TrackedSymbols :> {e, r, lmH, u}]", "Input"],

Cell["Going further - does R matter?", "Section"],

Cell["(* Not for the total: R cancels in I_i^2 R (L/2R). It only sets how fast (L/2R) and at what voltage the inductor empties. *)
Integrate[ii^2 rr Exp[-2 rr t/ll], {t, 0, Infinity}, Assumptions -> rr > 0 && ll > 0]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Book values: the integral of i^2 R evaluated numerically for several R against (1/2) L I_i^2. *)
With[{e = 12., l = 0.03},
 Grid[Prepend[Table[{r, 1000 l/r, NumberForm[1000 NIntegrate[(e/r Exp[-r t/l])^2 r, {t, 0, Infinity}], 8], NumberForm[1000 stored[l, e/r], 8]}, {r, {1., 6., 20., 100.}}],
   {\"R (ohm)\", \"\\[Tau] (ms)\", \"\\[Integral] i\\.b2 R dt (mJ)\", \"\\.bd L I_i\\.b2 (mJ)\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
