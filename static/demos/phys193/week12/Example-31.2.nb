(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 31.2 - Time Constant of an RL Circuit", "Title"],

Cell["PHYS 193 \:00b7 Week 12 \:00b7 Chapter 31 \:00b7 Lecture slide 30 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["The circuit of Figure 31.2 has emf 12.0 V, R = 6.00 ohm, L = 30.0 mH. (A) Find the time constant. (B) With S2 at a, S1 is closed at t = 0; find the current at t = 2.00 ms. (C) Compare the voltages across the resistor and the inductor.", "Text"],

Cell["tau = L/R = 5.00 ms; i = (emf/R)(1 - e^(-t/tau)) = 0.659 A at 2.00 ms; dv_R = i R and dv_L = emf e^(-t/tau) always add to 12.0 V, crossing at t_half = tau ln 2 = 3.47 ms. What If?: to move the crossing to 10.0 ms, change R to 2.08 ohm (65 % decrease) or L to 86.4 mH (188 % increase). Extra part (publisher's slides): after a long time S2 goes to b with R2 = 100 ohm in the loop; the 2.00 A cannot change at once, so the inductor must supply 2.00 A x 106 ohm = 212 V.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 31.2: an RL circuit. With S\:2082 at a and S\:2081 closed, the battery drives a current that builds up through the inductor. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the inductor laws (self- and mutual inductance, RL and LC circuits); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
tauRL[l_, r_] := l/r;
iRise[t_, e_, r_, l_] := e/r (1 - Exp[-t/tauRL[l, r]]);
iDecay[t_, e_, r_, l_, r2_] := e/r Exp[-t (r + r2)/l];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{l = lmH/1000., tau, tt = tms/1000., cur, vr, vl, fig},
  tau = tauRL[l, r]; cur = iRise[tt, e, r, l]; vr = cur r; vl = e Exp[-tt/tau];
  fig = Graphics[{
     batteryG[{0, 0}, {0, 1.2}, True], lbl[\"\\[CurlyEpsilon]\", {-0.3, 0.6}, Italic, 14],
     wire[{{0, 1.2}, {0, 1.6}}], {maroon, AbsoluteThickness[2.5], Line[{{0, 1.6}, {0, 2.3}}]}, lbl[\"S\\:2081 closed\", {-0.45, 1.95}, Gray, 10],
     wire[{{0, 2.3}, {0, 3}, {1.6, 3}}], {maroon, AbsoluteThickness[2.5], Line[{{1.6, 3}, {2.1, 3}}]}, lbl[\"S\\:2082 at a\", {1.85, 3.25}, Gray, 10],
     nodeG[{1.6, 3}], nodeG[{2.1, 3}], nodeG[{1.6, 2.6}, \"b\", {0.2, 0}],
     wire[{{2.1, 3}, {2.6, 3}}], resistorG[{2.6, 3}, {3.6, 3}], lbl[\"R\", {3.1, 3.3}, Italic], wire[{{3.6, 3}, {4.4, 3}, {4.4, 2.1}}],
     Table[{RGBColor[0.78, 0.18, 0.23], AbsoluteThickness[2.5], Circle[{4.4, 1.9 - 0.3 k}, 0.15, {-Pi/2, Pi/2}]}, {k, 0, 3}],
     wire[{{4.4, 0.9}, {4.4, 0}, {0, 0}}], lbl[\"L\", {4.85, 1.5}, Italic],
     currentG[{3.7, 3}, {4.3, 3}, cur, Row[{\"i = \", NumberForm[cur, 3], \" A\"}], 0.25]},
    PlotRange -> {{-0.8, 5.4}, {-0.3, 3.6}}, AspectRatio -> Automatic, ImageSize -> 440];
  Column[{fig,
    Plot[iRise[s/1000, e, r, l], {s, 0, 30}, PlotStyle -> Directive[RGBColor[0.48, 0.25, 0.69], Thick], Frame -> True, FrameLabel -> {\"t (ms)\", \"i (A)\"},
     GridLines -> {{1000 tau, tms}, {e/r}}, GridLinesStyle -> Directive[Gray, Dashed], PlotRange -> {0, 1.1 e/r}, Epilog -> {PointSize[0.02], Point[{tms, cur}]}, ImageSize -> 440],
    Plot[{iRise[s/1000, e, r, l] r, e Exp[-s/(1000 tau)]}, {s, 0, 30}, PlotStyle -> {Directive[maroon, Thick], Directive[blue, Thick]},
     PlotLegends -> Placed[{\"\\[CapitalDelta]v_R\", \"\\[CapitalDelta]v_L\"}, {Right, Center}], Frame -> True, FrameLabel -> {\"t (ms)\", \"\\[CapitalDelta]v (V)\"},
     GridLines -> {{1000 tau Log[2], tms}, None}, GridLinesStyle -> Directive[Gray, Dashed], ImageSize -> 440],
    results[{
      {\"(A) \\[Tau] = L/R\", Row[{NumberForm[1000 tau, 4], \" ms\"}]},
      {\"(B) i(t)\", Row[{NumberForm[cur, 4], \" A\"}]},
      {\"(C) \\[CapitalDelta]v_R = iR, \\[CapitalDelta]v_L = \\[CurlyEpsilon] e^(-t/\\[Tau])\", Row[{NumberForm[vr, 4], \" V, \", NumberForm[vl, 4], \" V  (sum \", NumberForm[vr + vl, 4], \" V)\"}]},
      {\"voltages equal at t\\:00bd = \\[Tau] ln 2\", Row[{NumberForm[1000 tau Log[2], 4], \" ms\"}]}}]}, Spacings -> 1.2]],
 {{e, 12., \"emf (V)\"}, 1, 24, 0.5, Appearance -> \"Labeled\"},
 {{r, 6., \"R (ohm)\"}, 0.5, 20, 0.01, Appearance -> \"Labeled\"},
 {{lmH, 30., \"L (mH)\"}, 1, 200, 0.1, Appearance -> \"Labeled\"},
 {{tms, 2., \"t (ms)\"}, 0, 30, ControlType -> Animator, AnimationRate -> 6, AnimationRunning -> False},
 Delimiter, Row[{Button[\"book values\", e = 12.; r = 6.; lmH = 30.], Button[\"t\\:00bd = 10 ms via R\", e = 12.; lmH = 30.; r = 0.03/(0.01/Log[2])], Button[\"t\\:00bd = 10 ms via L\", e = 12.; r = 6.; lmH = 1000 6 0.01/Log[2]]}],
 ControlPlacement -> Left, TrackedSymbols :> {e, r, lmH, tms}]", "Input"],

Cell["What if? Delaying the crossover to 10.0 ms", "Section"],

Cell["(* The crossover is the half-life tau ln 2, so tau must be 10.0 ms / ln 2 = 14.4 ms. *)
With[{tau = 0.01/Log[2]},
 Grid[{{\"required \\[Tau] (ms)\", 1000 tau}, {\"R with L fixed (ohm)\", 0.03/tau}, {\"percentage change in R\", 100 (0.03/tau/6 - 1)},
   {\"L with R fixed (mH)\", 1000 6 tau}, {\"percentage change in L\", 100 (6 tau/0.03 - 1)}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"],

Cell["Going further - the extra part: S2 thrown to b after a long time", "Section"],

Cell["(* The current through the inductor cannot jump: it is still 2.00 A just after the throw, now through R + R2 = 106 ohm. *)
Module[{e = 12., r = 6., r2 = 100., l = 0.03, i0},
 i0 = e/r;
 Column[{Grid[{{\"i just after the throw (A)\", i0}, {\"\\[CapitalDelta]v_R (V)\", i0 r}, {\"\\[CapitalDelta]v_R2 (V)\", i0 r2}, {\"\\[CapitalDelta]v_L (V)\", i0 (r + r2)}, {\"new time constant L/(R + R2) (ms)\", 1000 l/(r + r2)}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]],
   Plot[iDecay[t/1000, e, r, l, r2] (r + r2), {t, 0, 2}, PlotStyle -> Directive[blue, Thick], Frame -> True, FrameLabel -> {\"t (ms) after the throw\", \"|\\[CapitalDelta]v_L| (V)\"}, ImageSize -> 440]}]]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The loop equation emf - i R - L di/dt = 0 solved numerically (NDSolve) against Equation 31.7, and the crossover found by FindRoot against tau ln 2. *)
With[{e = 12., r = 6., l = 0.03},
 Module[{sol = NDSolveValue[{l i'[t] == e - r i[t], i[0] == 0}, i, {t, 0, 0.03}, AccuracyGoal -> 12, PrecisionGoal -> 10], tc},
  tc = t /. FindRoot[sol[t] r == e Exp[-t r/l], {t, 0.003}];
  Column[{Grid[Prepend[Table[{1000 t, NumberForm[sol[t], 8], NumberForm[iRise[t, e, r, l], 8]}, {t, {0.001, 0.002, 0.005, 0.01, 0.02}}], {\"t (ms)\", \"NDSolve (A)\", \"Eq. 31.7 (A)\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]],
    Row[{\"crossover (ms): \", 1000 tc, \"   \\[Tau] ln 2 (ms): \", 1000 l/r Log[2]}]}]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
