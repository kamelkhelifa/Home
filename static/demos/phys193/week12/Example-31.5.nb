(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 31.5 - Wireless Battery Charger", "Title"],

Cell["PHYS 193 \:00b7 Week 12 \:00b7 Chapter 31 \:00b7 Lecture slide 57 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["An electric toothbrush base holds a solenoid of length l with N_B turns, carrying a current i, of cross-sectional area A. The handle coil has N_H turns and completely surrounds the base coil (Figure 31.10). Find the mutual inductance of the system.", "Text"],

Cell["B inside the base coil is mu0 (N_B/l) i; the flux through each handle turn is B A, so M = N_H B A/i = mu0 N_B N_H A/l. The book gives no numbers; the model uses N_B = 600, l = 2.5 cm, A = 1.0 cm^2, N_H = 150, and a base current of amplitude 0.50 A at 20 kHz, so that the induced emf -M di/dt can be plotted.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 31.10b: a coil of N_H turns (the handle) wrapped around the centre of a solenoid of N_B turns and length \:2113 (the base). Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the inductor laws (self- and mutual inductance, RL and LC circuits); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
mu0 = 4 Pi 10.^-7;
mutual[nb_, nh_, l_, a_] := mu0 nb nh a/l;", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{l = lcm/100., a = acm2 10.^-4, m, w = 2 Pi f, t, cur, em, fig},
  m = mutual[nb, nh, l, a]; t = ph Degree/w; cur = imax Cos[ph Degree]; em = -m D[imax Cos[w s], s] /. s -> t;
  fig = Graphics[{
     Table[{green, Arrowheads[0.02], Arrow[If[cur >= 0, {{-1.7, y}, {1.7, y}}, {{1.7, y}, {-1.7, y}}]]}, {y, -0.3, 0.3, 0.15}],
     Table[{RGBColor[0.78, 0.18, 0.23], AbsoluteThickness[1.8], Circle[{x, 0}, {0.06, 0.4}]}, {x, -1.3, 1.3, 0.16}],
     Table[{blue, AbsoluteThickness[2.5], Circle[{x, 0}, {0.08, 0.62}]}, {x, -0.5, 0.5, 0.2}],
     Text[Style[Row[{\"coil 1 (base): N_B = \", nb, \", l = \", NumberForm[lcm, 3], \" cm, A = \", NumberForm[acm2, 3], \" cm\\.b2\"}], 10, RGBColor[0.78, 0.18, 0.23]], {0, -0.85}],
     Text[Style[Row[{\"coil 2 (handle): N_H = \", nh}], 10, blue], {0, 0.85}],
     Text[Style[Row[{\"i = \", NumberForm[cur, 3], \" A\"}], 10, green], {-1.5, -0.6}]},
    PlotRange -> {{-1.9, 1.9}, {-1, 1}}, ImageSize -> 440];
  Column[{fig,
    Plot[{imax Cos[w s], m w imax Sin[w s]/(m w imax)}, {s, 0, 2 (2 Pi/w)}, PlotStyle -> {Directive[green, Thick], Directive[blue, Thick]},
     PlotLegends -> Placed[{\"i_B / I_max\", \"\\[CurlyEpsilon]_H / (M \\[Omega] I_max)\"}, Below], Frame -> True, FrameLabel -> {\"t (s)\", \"\"}, GridLines -> {{t}, {0}}, ImageSize -> 440],
    results[{
      {\"M = \\[Mu]0 N_B N_H A/l\", Row[{NumberForm[10^6 m, 4], \" \\[Mu]H\"}]},
      {\"B in the base coil now\", Row[{NumberForm[1000 mu0 nb/l cur, 4], \" mT\"}]},
      {\"emf in the handle -M di/dt\", Row[{NumberForm[em, 4], \" V (amplitude \", NumberForm[m w imax, 4], \" V)\"}]},
      {\"M/L_B = N_H/N_B\", NumberForm[nh/nb, 4]}}]}, Spacings -> 1.2]],
 {{nb, 600, \"base turns N_B\"}, 50, 2000, 10, Appearance -> \"Labeled\"},
 {{nh, 150, \"handle turns N_H\"}, 10, 1000, 10, Appearance -> \"Labeled\"},
 {{lcm, 2.5, \"length l (cm)\"}, 0.5, 10, 0.1, Appearance -> \"Labeled\"},
 {{acm2, 1., \"area A (cm\\.b2)\"}, 0.1, 5, 0.1, Appearance -> \"Labeled\"},
 {{imax, 0.5, \"I_max (A)\"}, 0.05, 2, 0.05, Appearance -> \"Labeled\"},
 {{f, 20000., \"frequency (Hz)\"}, 50, 100000, Appearance -> \"Labeled\"},
 {{ph, 60, \"phase \\[Omega]t (degrees)\"}, 0, 360, ControlType -> Animator, AnimationRate -> 60, AnimationRunning -> False},
 ControlPlacement -> Left, TrackedSymbols :> {nb, nh, lcm, acm2, imax, f, ph}]", "Input"],

Cell["Going further - the symmetry M_HB = M_BH", "Section"],

Cell["(* Driving the handle coil instead gives a field that is awkward to write down, yet the flux it sends through the base coil gives exactly the same M. M/L_B = N_H/N_B here. *)
Simplify[mutual[nbv, nhv, lv, av]/(mu0 nbv^2 av/lv)]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* M from the definition with the flux integrated over the cross-section, against mu0 N_B N_H A/l; and the emf against the numerical derivative of the flux linkage. *)
With[{nb = 600, nh = 150, l = 0.025, a = 10.^-4, imax = 0.5, w = 2 Pi 20000., t0 = (60 Degree)/(2 Pi 20000.)},
 Module[{r0 = Sqrt[a/Pi], flux1, link},
  flux1 = NIntegrate[mu0 nb/l 2 Pi r, {r, 0, r0}];
  link[t_] := nh mu0 nb/l imax Cos[w t] a;
  Grid[{{\"M = N_H \\[CapitalPhi]/i (\\[Mu]H)\", 10^6 nh flux1}, {\"\\[Mu]0 N_B N_H A/l (\\[Mu]H)\", 10^6 mutual[nb, nh, l, a]},
    {\"emf numerical (V)\", -(link[t0 + 10.^-10] - link[t0 - 10.^-10])/(2 10.^-10)}, {\"-M di/dt (V)\", -mutual[nb, nh, l, a] (-imax w Sin[w t0])}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
