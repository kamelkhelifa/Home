(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 29.5 - The Magnetic Field Created by a Long Current-Carrying Wire", "Title"],

Cell["PHYS 193 \:00b7 Week 9 \:00b7 Chapter 29 \:00b7 Lecture slide 52 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A long straight wire of radius R carries a steady current I uniformly distributed over its cross-section. Calculate the magnetic field a distance r from the centre for r >= R and r < R.", "Text"],

Cell["Ampere's law on a concentric circle: B 2 Pi r = mu0 I_enc. Outside, I_enc = I and B = mu0 I/2 Pi r (Eq. 29.14); inside, I_enc = (r^2/R^2) I and B = (mu0 I/2 Pi R^2) r (Eq. 29.15). The two agree at r = R, where the field is largest.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 29.13: a long, straight wire of radius R carrying a steady current I uniformly distributed over its cross-section. Circle 1 (radius r > R) and circle 2 (r < R) are the amperian paths, concentric with the wire. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the Biot\:2013Savart law, Amp\:00e8re\:2019s law and the definition of magnetic flux; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
(* current-density profiles in units of I/(Pi R^2), as functions of u = r/R; each integrates to the total current *)
jOf[\"uniform\", u_] := 1;
jOf[\"surface\", u_] := 1.5 u;                      (* J proportional to r *)
jOf[\"hollow\", u_] := If[u < 0.5, 0, 4/3];         (* tube with inner radius R/2 *)
fracEnc[p_, u_] := If[u >= 1, 1, NIntegrate[jOf[p, v] 2 v, {v, 0, u}]];
bOf[p_, r_, rw_, i_] := If[r <= 0, 0, mu0 i fracEnc[p, r/rw]/(2 Pi r)];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{rw = rmm/1000., r = rmmA/1000., ienc, b, bs, fig},
  ienc = i fracEnc[prof, r/rw]; b = bOf[prof, r, rw, i]; bs = mu0 i/(2 Pi rw);
  fig = Graphics[{{GrayLevel[0.92], Disk[{0, 0}, rw]}, If[prof === \"hollow\", {White, Disk[{0, 0}, rw/2]}, {}],
     {gold, Opacity[0.25], Disk[{0, 0}, Min[r, rw]]}, {ink, Circle[{0, 0}, rw]},
     (* current out of the page, spaced to suggest the density *)
     Table[If[Norm[{xx, yy}] < 0.97 rw && jOf[prof, Norm[{xx, yy}]/rw] > 0.05, dotG[{xx, yy}, 0.035 rw, RGBColor[0.48, 0.25, 0.69]], {}], {xx, -rw, rw, rw/4.5}, {yy, -rw, rw, rw/4.5}],
     {ink, Line[{{0, 0}, rw {1, 1}/Sqrt[2]}]}, Text[Style[\"R\", Italic, 12], 0.7 rw {1, 1}/Sqrt[2] + {0.1 rw, -0.08 rw}],
     {blue, Dashed, AbsoluteThickness[1.5], Circle[{0, 0}, r]}, {blue, Line[{{0, 0}, r {-1, 1}/Sqrt[2]}]}, Text[Style[\"r\", Italic, 12, blue], 0.5 r {-1, 1}/Sqrt[2] + {-0.1 rw, 0.08 rw}],
     Table[With[{q = r {Cos[ph], Sin[ph]}}, {green, AbsoluteThickness[2], Arrowheads[0.03], Arrow[{q, q + 0.35 rw (b/bs) {-Sin[ph], Cos[ph]}}]}], {ph, 0, 2 Pi - 0.1, Pi/4}],
     Text[Style[Row[{\"B = \", NumberForm[1000 b, 3], \" mT\"}], 11, Bold, green], {0, -1.3 Max[rw, r]}],
     Text[Style[Row[{\"I_enc = \", NumberForm[ienc, 3], \" A of \", i, \" A\"}], 10, gold], {0, 1.3 Max[rw, r]}]},
    PlotRange -> 1.45 Max[rw, r], AspectRatio -> Automatic, ImageSize -> 400];
  Column[{fig,
    Plot[1000 bOf[prof, rr/1000., rw, i], {rr, 0.01, 20}, PlotStyle -> Directive[green, Thick], Frame -> True, FrameLabel -> {\"r (mm)\", \"B (mT)\"}, PlotRange -> {0, 1.15 1000 bs},
     GridLines -> {{rmm, rmmA}, {1000 bs}}, GridLinesStyle -> Directive[gold, Dashed], Epilog -> {gold, PointSize[0.02], Point[{rmmA, 1000 b}]}, PlotPoints -> 100, ImageSize -> 420],
    results[{
      {\"enclosed current I_enc\", Row[{NumberForm[ienc, 4], \" A (fraction \", NumberForm[fracEnc[prof, r/rw], 4], \")\"}]},
      {\"B = \\[Mu]0 I_enc/2\\[Pi]r\", Row[{NumberForm[1000 b, 4], \" mT\"}]},
      {\"B at the surface \\[Mu]0 I/2\\[Pi]R\", Row[{NumberForm[1000 bs, 4], \" mT\"}]},
      {\"region\", If[r < rw, Row[{\"inside, r = \", NumberForm[r/rw, 3], \" R\"}], Row[{\"outside, r = \", NumberForm[r/rw, 3], \" R: B \\[Proportional] 1/r\"}]]}}]}, Spacings -> 1]],
 {{i, 20., \"current I (A)\"}, 1, 100, 1, Appearance -> \"Labeled\"},
 {{rmm, 4., \"wire radius R (mm)\"}, 1, 10, 0.5, Appearance -> \"Labeled\"},
 {{rmmA, 2.5, \"amperian radius r (mm)\"}, 0.1, 20, 0.1, Appearance -> \"Labeled\"},
 {{prof, \"uniform\", \"current-density profile\"}, {\"uniform\", \"surface\", \"hollow\"}},
 ControlPlacement -> Left, TrackedSymbols :> {i, rmm, rmmA, prof}]", "Input"],

Cell["Ampere's law inside and outside, symbolically", "Section"],

Cell["(* I_enc = (r/R)^2 I for a uniform current; the two expressions meet at r = R. *)
{Solve[b 2 Pi r == mu0v I0 r^2/R0^2, b], Solve[b 2 Pi r == mu0v I0, b], (mu0v I0/(2 Pi R0^2) r /. r -> R0) == (mu0v I0/(2 Pi r) /. r -> R0)}", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Ampere's law against an independent Biot-Savart sum over the cross-section (a polar grid of straight filaments), for the uniform wire at r = R/2 and r = 2R. *)
With[{rw = 0.004, i = 20.},
 Module[{bfil, nr = 120, na = 180},
  bfil[r_] := Module[{bx = 0., by = 0., u0, u1, um, dI, fx, fy, dx, dy, d2},
    Do[u0 = k/nr; u1 = (k + 1)/nr; um = (u0 + u1)/2; dI = i (u1^2 - u0^2);
     Do[fx = um rw Cos[2 Pi (j + 0.5)/na]; fy = um rw Sin[2 Pi (j + 0.5)/na]; dx = r - fx; dy = -fy; d2 = dx^2 + dy^2;
      bx += -mu0 dI/na/(2 Pi d2) dy; by += mu0 dI/na/(2 Pi d2) dx, {j, 0, na - 1}], {k, 0, nr - 1}]; Sqrt[bx^2 + by^2]];
  Grid[{{\"r = R/2: Biot-Savart (mT)\", 1000 bfil[rw/2]}, {\"r = R/2: Eq. 29.15 (mT)\", 1000 mu0 i/(2 Pi rw^2) (rw/2)},
    {\"r = 2R: Biot-Savart (mT)\", 1000 bfil[2 rw]}, {\"r = 2R: Eq. 29.14 (mT)\", 1000 mu0 i/(2 Pi 2 rw)}, {\"surface, 29.14 and 29.15 (mT)\", 1000 {mu0 i/(2 Pi rw), mu0 i/(2 Pi rw^2) rw}}},
   Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
