(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 29.4 - Suspending a Wire", "Title"],

Cell["PHYS 193 \:00b7 Week 9 \:00b7 Chapter 29 \:00b7 Lecture slide 37 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["Two infinitely long parallel wires lie on the ground a = 1.00 cm apart. A third wire of length L = 10.0 m and mass 400 g carries I1 = 100 A and is levitated midway above them; the long wires carry equal currents I2 opposite to I1. What I2 makes the three wires form an equilateral triangle?", "Text"],

Cell["Each repulsion is mu0 I1 I2 L/2 Pi a; the horizontal parts cancel and the vertical parts add to (mu0 I1 I2 L/Pi a) cos(theta). Setting this equal to mg with theta = 30 degrees gives I2 = mg Pi a/(mu0 I1 L cos 30) = 113 A. Vertically the equilateral equilibrium is stable (the upward force falls with height there); sideways it is unstable.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 29.9: (a) two current-carrying wires lying on the ground, a distance a apart, suspend a third wire of length L by magnetic forces. (b) End view: the three wires form an equilateral triangle; the two magnetic forces F_B,L and F_B,R on the levitated wire and its weight F_g. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the Biot\:2013Savart law, Amp\:00e8re\:2019s law and the definition of magnetic flux; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
g = 9.80; Lw = 10.;
(* total magnetic force on the top wire at (x, h) from the ground wires at (-a/2, 0) and (a/2, 0): repulsion along the joining line, magnitude mu0 I1 I2 L/2 Pi d *)
forceOn[x_, h_, a_, i1_, i2_] := Sum[With[{d = {x - xw, h}}, mu0 i1 i2 Lw/(2 Pi Norm[d]) d/Norm[d]], {xw, {-a/2, a/2}}];
fUp[h_, a_, i1_, i2_] := mu0 i1 i2 Lw h/(Pi (h^2 + a^2/4));
i2Eq[m_, a_, i1_] := m g Pi a/(mu0 i1 Lw Cos[30 Degree]);", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{a = acm/100., h = hcm/100., m = mg/1000., x = If[offset, 0.001, 0.], f, th, k, fig},
  f = forceOn[x, h, a, i1, i2]; th = ArcTan[h, a/2 - x]; k = 0.012/(m g);   (* drawing scale: mg = 1.2 cm *)
  fig = Graphics[{{GrayLevel[0.85], Rectangle[{-1.2 a, -0.4 a}, {1.2 a, 0}]}, {GrayLevel[0.7], Dashed, Line[{{-a/2, 0}, {x, h}, {a/2, 0}, {-a/2, 0}}]},
     Text[Style[\"a\", Italic, 12], {0, -0.12 a}], Text[Style[\"a\", Italic, 12], {-a/4 + x/2 - 0.12 a, h/2}], Text[Style[\"a\", Italic, 12], {a/4 + x/2 + 0.12 a, h/2}],
     crossG[{-a/2, 0}, 0.06 a, RGBColor[0.48, 0.25, 0.69]], crossG[{a/2, 0}, 0.06 a, RGBColor[0.48, 0.25, 0.69]], dotG[{x, h}, 0.06 a, RGBColor[0.48, 0.25, 0.69]],
     Text[Style[\"I2\", Italic, 11, Bold, RGBColor[0.48, 0.25, 0.69]], {-a/2 - 0.15 a, 0}], Text[Style[\"I2\", Italic, 11, Bold, RGBColor[0.48, 0.25, 0.69]], {a/2 + 0.15 a, 0}], Text[Style[\"I1\", Italic, 11, Bold, RGBColor[0.48, 0.25, 0.69]], {x + 0.15 a, h + 0.08 a}],
     {gold, Circle[{x, h}, 0.25 a, {-Pi/2 - th, -Pi/2 + th}]}, Text[Style[Row[{\"\\[Theta] = \", NumberForm[th/Degree, 3], \"\\[Degree]\"}], 10, gold], {x, h - 0.38 a}],
     Table[With[{d = {x - xw, h}}, {blue, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{{x, h}, {x, h} + k mu0 i1 i2 Lw/(2 Pi Norm[d]) d/Norm[d]}]}], {xw, {-a/2, a/2}}],
     Text[Style[\"F_B,L\", 10, Bold, blue], {x - 0.5 a, h + 0.75 a}], Text[Style[\"F_B,R\", 10, Bold, blue], {x + 0.5 a, h + 0.75 a}],
     {maroon, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{{x, h}, {x, h - k m g}}]}, Text[Style[\"F_g\", 10, Bold, maroon], {x + 0.18 a, h - k m g}],
     {green, AbsoluteThickness[2], Arrowheads[0.035], Arrow[{{x - 0.2 a, h}, {x - 0.2 a, h + k f[[2]]}}]}, Text[Style[\"\\[CapitalSigma]F_B\", 10, Bold, green], {x - 0.42 a, h + k f[[2]]}]},
    PlotRange -> {{-1.2 a, 1.2 a}, {-0.4 a, Max[1.9 a, h + 1.1 a]}}, AspectRatio -> Automatic, ImageSize -> 400];
  Column[{fig,
    Plot[{fUp[hh, a, i1, i2], m g}, {hh, 0, 0.03}, PlotStyle -> {Directive[green, Thick], Directive[maroon, Dashed]}, Frame -> True, FrameLabel -> {\"h (m)\", \"force (N)\"}, PlotRange -> {0, All},
     GridLines -> {{h, a Sqrt[3]/2, a/2}, None}, GridLinesStyle -> Directive[gold, Dashed], PlotLegends -> {\"upward magnetic force\", \"mg\"}, Epilog -> {gold, PointSize[0.02], Point[{h, fUp[h, a, i1, i2]}]}, ImageSize -> 420],
    results[{
      {\"I2 for the equilateral triangle\", Row[{NumberForm[i2Eq[m, a, i1], 4], \" A\"}]},
      {\"upward magnetic force at this h\", Row[{NumberForm[f[[2]], 4], \" N\"}]},
      {\"weight mg\", Row[{NumberForm[m g, 4], \" N\"}]},
      {\"net vertical force\", Row[{NumberForm[f[[2]] - m g, 3], \" N  \", Which[Abs[f[[2]] - m g] < 0.02 m g, \"(balanced)\", f[[2]] > m g, \"(wire rises)\", True, \"(wire falls)\"]}]},
      {\"sideways force\", If[offset, Row[{NumberForm[f[[1]], 3], \" N, away from the centre\"}], \"0 by symmetry\"]},
      {\"vertical stability\", If[h > a/2, \"above the force peak at a/2: stable\", \"below the peak: unstable\"]}}]}, Spacings -> 1]],
 {{i2, 113., \"ground-wire current I2 (A)\"}, 20, 300, 1, Appearance -> \"Labeled\"},
 {{i1, 100., \"levitated-wire current I1 (A)\"}, 20, 300, 1, Appearance -> \"Labeled\"},
 {{mg, 400., \"mass of the levitated wire (g)\"}, 50, 1000, 10, Appearance -> \"Labeled\"},
 {{acm, 1., \"spacing a (cm)\"}, 0.5, 3, 0.05, Appearance -> \"Labeled\"},
 {{hcm, 0.866, \"height h (cm)\"}, 0.1, 3, 0.01, Appearance -> \"Labeled\"},
 {{offset, False, \"sideways offset of 1 mm\"}, {True, False}},
 ControlPlacement -> Left, TrackedSymbols :> {i2, i1, mg, acm, hcm, offset}]", "Input"],

Cell["Stability - the question the book leaves open", "Section"],

Cell["(* The upward force as a function of height, its peak, and the slope at the equilateral point (negative = stable). The horizontal stiffness at the same point is positive (unstable sideways). *)
With[{a = 0.01, i1 = 100., i2 = i2Eq[0.4, 0.01, 100.]},
 {Solve[D[fUp[h, a, i1, i2], h] == 0 && h > 0, h] // N, D[fUp[h, a, i1, i2], h] /. h -> a Sqrt[3]/2, D[forceOn[x, a Sqrt[3]/2, a, i1, i2][[1]], x] /. x -> 0}]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Book values: I2 from the equilibrium condition, the two equilibrium heights from the force curve and the slope at each. *)
With[{a = 0.01, i1 = 100., m = 0.4},
 Module[{i2 = i2Eq[m, a, i1], h1, h2},
  h1 = h /. FindRoot[fUp[h, a, i1, i2] == m g, {h, 0.3 a}]; h2 = h /. FindRoot[fUp[h, a, i1, i2] == m g, {h, 0.9 a}];
  Grid[{{\"I2 = mg\\[Pi]a/(\\[Mu]0 I1 L cos 30\\[Degree]) (A)\", i2}, {\"force at the equilateral height (N)\", fUp[a Sqrt[3]/2, a, i1, i2]}, {\"mg (N)\", m g},
    {\"equilibrium heights (cm)\", 100 {h1, h2}}, {\"dF/dh there (N/m)\", {D[fUp[hh, a, i1, i2], hh] /. hh -> h1, D[fUp[hh, a, i1, i2], hh] /. hh -> h2}},
    {\"a\\[Sqrt]3/2 (cm)\", 100 a Sqrt[3]/2}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
