(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 29.2 - Magnetic Field Due to a Curved Wire Segment", "Title"],

Cell["PHYS 193 \:00b7 Week 9 \:00b7 Chapter 29 \:00b7 Lecture slide 20 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["Calculate the magnetic field at point O for a wire made of two straight portions pointing at O and a circular arc of radius a subtending an angle theta.", "Text"],

Cell["The straight legs give nothing (ds parallel to r-hat); on the arc every element is at distance a with ds perpendicular to r-hat, so B = (mu0 I/4 Pi a^2) s = mu0 I theta/4 Pi a (Eq. 29.6), into the page. What if? For a full loop, theta = 2 Pi, B = mu0 I/2a.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 29.5: a portion of a wire forms an arc of a circle of radius a about O, subtending an angle \:03b8; the straight portions A\:2032A and CC\:2032 point at O. The length of the curved segment AC is s. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the Biot\:2013Savart law, Amp\:00e8re\:2019s law and the definition of magnetic flux; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
bArc[a_, i_, th_] := mu0 i th/(4 Pi a);
(* numerical Biot-Savart at the origin for a polyline (z component), the wire in the plane z = 0 *)
biotO[pts_, i_, n_ : 200] := Sum[Module[{p0 = pts[[k]], p1 = pts[[k + 1]], q, ds, rr},
    Sum[q = p0 + (p1 - p0) (j + 0.5)/n; ds = (p1 - p0)/n; rr = Norm[q]; mu0 i/(4 Pi) (ds[[1]] (-q[[2]]) - ds[[2]] (-q[[1]]))/rr^3, {j, 0, n - 1}]], {k, Length[pts] - 1}];
arcPts[a_, th_, m_ : 360] := Table[a {Cos[ph], Sin[ph]}, {ph, th/2, -th/2, -th/m}];     (* A (top) to C (bottom): current clockwise *)", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{a = acm/100., L = Lcm/100., th = thdeg Degree, b, pA, pC, Ap, Cp, pts, fig},
  b = bArc[a, i, th]; pA = a {Cos[th/2], Sin[th/2]}; pC = a {Cos[th/2], -Sin[th/2]}; Ap = (a + L) {Cos[th/2], Sin[th/2]}; Cp = (a + L) {Cos[th/2], -Sin[th/2]};
  pts = Join[{Ap}, arcPts[a, th, 90], {Cp}];
  fig = Graphics[{{GrayLevel[0.6], AbsoluteThickness[7], Line[pts]}, {GrayLevel[0.7], Dashed, Line[{{0, 0}, pA}], Line[{{0, 0}, pC}]},
     Text[Style[\"a\", Italic, 12], 0.5 pA + {-0.1 a, 0.05 a}], Text[Style[\"a\", Italic, 12], 0.5 pC + {-0.1 a, -0.05 a}],
     {gold, Circle[{0, 0}, 0.3 a, {-th/2, th/2}]}, Text[Style[\"\\[Theta]\", Italic, 12, gold], {0.42 a, 0}],
     Text[Style[\"A\", Italic, 12], pA + {-0.1 a, 0.05 a}], Text[Style[\"C\", Italic, 12], pC + {-0.1 a, -0.05 a}],
     If[L > 0.01, {{green, Arrowheads[0.04], Arrow[{(a + 0.7 L) {Cos[th/2], Sin[th/2]}, (a + 0.4 L) {Cos[th/2], Sin[th/2]}}], Arrow[{(a + 0.4 L) {Cos[th/2], -Sin[th/2]}, (a + 0.7 L) {Cos[th/2], -Sin[th/2]}}]},
       Text[Style[\"I\", Italic, 12, Bold, green], (a + 0.55 L) {Cos[th/2], Sin[th/2]} + {0.12 a, 0}], Text[Style[\"I\", Italic, 12, Bold, green], (a + 0.55 L) {Cos[th/2], -Sin[th/2]} + {0.12 a, 0}]}, {}],
     (* a sample element on the arc with ds (tangent) and r-hat (toward O) *)
     With[{ph = 0.15 th}, {{maroon, Arrowheads[0.035], Arrow[{a {Cos[ph], Sin[ph]}, a {Cos[ph], Sin[ph]} + 0.25 a {Sin[ph], -Cos[ph]}}]}, Text[Style[\"ds\", Italic, 11, Bold, maroon], a {Cos[ph], Sin[ph]} + 0.36 a {Sin[ph], -Cos[ph]}],
       {ink, Arrowheads[0.035], Arrow[{a {Cos[ph], Sin[ph]}, 0.75 a {Cos[ph], Sin[ph]}}]}, Text[Style[\"r\\[Hat]\", 11, Bold], 0.62 a {Cos[ph], Sin[ph]}]}],
     crossG[{0, 0}, 0.06 a + 0.1 a th/(2 Pi), green], Text[Style[\"O\", Italic, 12], {-0.18 a, -0.1 a}],
     Text[Style[Row[{\"B = \", NumberForm[10^6 b, 3], \" \\[Mu]T into the page\"}], 11, green], {0, -0.35 a - 0.1 a th/(2 Pi)}]},
    PlotRange -> All, PlotRangePadding -> 0.15 a, AspectRatio -> Automatic, ImageSize -> 400];
  Column[{fig,
    Plot[10^6 bArc[a, i, t Degree], {t, 0, 360}, PlotStyle -> Directive[green, Thick], Frame -> True, FrameLabel -> {\"\\[Theta] (\\[Degree])\", \"B at O (\\[Mu]T)\"}, PlotRange -> {0, 1.15 10^6 mu0 i/(2 a)},
     GridLines -> {{thdeg}, {10^6 mu0 i/(2 a)}}, GridLinesStyle -> Directive[gold, Dashed], Epilog -> {gold, PointSize[0.02], Point[{thdeg, 10^6 b}], Text[Style[\"full loop \\[Mu]0 I/2a\", 10, maroon], {300, 1.07 10^6 mu0 i/(2 a)}]}, ImageSize -> 420],
    results[{
      {\"arc length s = a\\[Theta]\", Row[{NumberForm[100 a th, 4], \" cm\"}]},
      {\"B at O = \\[Mu]0 I \\[Theta]/4\\[Pi]a\", Row[{NumberForm[10^6 b, 4], \" \\[Mu]T (into the page)\"}]},
      {\"full loop \\[Mu]0 I/2a\", Row[{NumberForm[10^6 mu0 i/(2 a), 4], \" \\[Mu]T\"}]}}]}, Spacings -> 1]],
 {{i, 5., \"current I (A)\"}, 0.5, 20, 0.5, Appearance -> \"Labeled\"},
 {{acm, 5., \"radius a (cm)\"}, 1, 20, 0.5, Appearance -> \"Labeled\"},
 {{thdeg, 60, \"angle \\[Theta] (\\[Degree])\"}, 5, 360, 1, Appearance -> \"Labeled\"},
 {{Lcm, 10., \"length of each straight leg (cm)\"}, 0, 30, 1, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {i, acm, thdeg, Lcm}]", "Input"],

Cell["What if? - the full loop", "Section"],

Cell["(* Setting theta = 2 Pi in Equation 29.6 gives the field at the centre of a circular loop. *)
Simplify[bArc[R, I0, 2 Pi]]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The Biot-Savart law summed numerically over the whole wire with the full cross product: the legs must give zero and the arc Equation 29.6. *)
With[{a = 0.05, i = 5., th = 60. Degree, L = 0.10},
 Module[{pA = a {Cos[th/2], Sin[th/2]}, pC = a {Cos[th/2], -Sin[th/2]}, Ap = (a + L) {Cos[th/2], Sin[th/2]}, Cp = (a + L) {Cos[th/2], -Sin[th/2]}},
  Grid[{{\"arc AC, numerical (\\[Mu]T)\", -10^6 biotO[arcPts[a, th], i]}, {\"\\[Mu]0 I \\[Theta]/4\\[Pi]a (\\[Mu]T)\", 10^6 bArc[a, i, th]},
    {\"legs A'A and CC', numerical (\\[Mu]T)\", Chop[10^6 (biotO[{Ap, pA}, i] + biotO[{pC, Cp}, i]), 10^-9]},
    {\"full loop, numerical (\\[Mu]T)\", -10^6 biotO[arcPts[a, 2 Pi], i]}, {\"\\[Mu]0 I/2a (\\[Mu]T)\", 10^6 mu0 i/(2 a)}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
