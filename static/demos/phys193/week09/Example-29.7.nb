(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 29.7 - Magnetic Flux Through a Rectangular Loop", "Title"],

Cell["PHYS 193 \:00b7 Week 9 \:00b7 Chapter 29 \:00b7 Lecture slide 71 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A rectangular loop of width a and length b lies beside a long wire carrying a current I, its near side a distance c from the wire and its long side parallel to the wire. Find the total magnetic flux through the loop.", "Text"],

Cell["B = mu0 I/2 Pi r varies across the loop, so the flux is integrated strip by strip with dA = b dr: Phi_B = (mu0 I b/2 Pi) Log[(a + c)/c] = (mu0 I b/2 Pi) Log[1 + a/c]. It grows with a and b, vanishes for c -> infinity and diverges logarithmically as c -> 0.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 29.21: a long wire carrying a current I upward and a rectangular loop of width a and length b beside it, its near side a distance c from the wire. The field (into the page) is not uniform over the loop; the tan strip of width dr at distance r is the area element dA = b dr. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the Biot\:2013Savart law, Amp\:00e8re\:2019s law and the definition of magnetic flux; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
bWire[i_, r_] := mu0 i/(2 Pi r);
flux[i_, a_, b_, c_] := mu0 i b/(2 Pi) Log[1 + a/c];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{a = acm/100., b = bcm/100., c = ccm/100., r, ph, naive, fig},
  r = c + a frac; ph = flux[i, a, b, c]; naive = bWire[i, c + a/2] a b;
  fig = Graphics[{
     (* field into the page, denser near the wire *)
     Table[crossG[{rr, yy}, 0.004, RGBColor[0.18, 0.49, 0.31, 0.5]], {rr, Table[0.012 1.35^k, {k, 0, 12}]}, {yy, -0.75 b, 0.75 b, 0.05}],
     {GrayLevel[0.6], AbsoluteThickness[7], Line[{{0, -0.8 b}, {0, 0.8 b}}]}, {RGBColor[0.48, 0.25, 0.69], AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{{-0.015, -0.2 b}, {-0.015, 0.2 b}}]},
     Text[Style[\"I\", Italic, 12, Bold, RGBColor[0.48, 0.25, 0.69]], {-0.03, 0}],
     {ink, AbsoluteThickness[2], Line[{{c, -b/2}, {c + a, -b/2}, {c + a, b/2}, {c, b/2}, {c, -b/2}}]},
     {gold, Opacity[0.6], Rectangle[{r - 0.02 a, -b/2}, {r + 0.02 a, b/2}]}, Text[Style[\"dr\", Italic, 11, gold], {r, b/2 + 0.04 b}],
     {ink, Arrowheads[{-0.02, 0.02}], Arrow[{{0, -b/2 - 0.08 b}, {c, -b/2 - 0.08 b}}], Arrow[{{c, -b/2 - 0.08 b}, {c + a, -b/2 - 0.08 b}}], Arrow[{{c + a + 0.015, -b/2}, {c + a + 0.015, b/2}}]},
     Text[Style[\"c\", Italic, 12], {c/2, -b/2 - 0.16 b}], Text[Style[\"a\", Italic, 12], {c + a/2, -b/2 - 0.16 b}], Text[Style[\"b\", Italic, 12], {c + a + 0.03, 0}],
     {gold, Arrowheads[0.02], Arrow[{{0, b/2 + 0.12 b}, {r, b/2 + 0.12 b}}]}, Text[Style[\"r\", Italic, 12, gold], {r/2, b/2 + 0.2 b}]},
    PlotRange -> {{-0.05, c + a + 0.05}, {-0.8 b - 0.02, 0.8 b + 0.02}}, AspectRatio -> Automatic, ImageSize -> 400];
  Column[{fig,
    Plot[10^6 bWire[i, rr], {rr, c, c + a}, PlotStyle -> Directive[green, Thick], Filling -> Axis, Frame -> True, FrameLabel -> {\"r (m)\", \"B (\\[Mu]T)\"}, PlotRange -> {0, All},
     GridLines -> {{r}, {10^6 bWire[i, c + a/2]}}, GridLinesStyle -> Directive[gold, Dashed], Epilog -> {gold, PointSize[0.02], Point[{r, 10^6 bWire[i, r]}]}, ImageSize -> 420],
    Plot[10^6 flux[i, rr - c, b, c], {rr, c, c + a}, PlotStyle -> Directive[blue, Thick], Frame -> True, FrameLabel -> {\"r (m)\", \"flux from c to r (\\[Mu]Wb)\"}, PlotRange -> {0, 1.15 10^6 Max[ph, naive]},
     GridLines -> {{r}, {10^6 ph, 10^6 naive}}, GridLinesStyle -> Directive[gold, Dashed], ImageSize -> 420],
    results[{
      {\"\\[CapitalPhi]_B = (\\[Mu]0 I b/2\\[Pi]) ln(1 + a/c)\", Row[{NumberForm[10^6 ph, 4], \" \\[Mu]Wb\"}]},
      {\"B at the near and far edges\", Row[{NumberForm[10^6 bWire[i, c], 4], \" \\[Mu]T, \", NumberForm[10^6 bWire[i, c + a], 4], \" \\[Mu]T\"}]},
      {\"this strip: r, B, d\\[CapitalPhi]/dr = B b\", Row[{NumberForm[100 r, 3], \" cm, \", NumberForm[10^6 bWire[i, r], 4], \" \\[Mu]T, \", NumberForm[10^6 bWire[i, r] b, 4], \" \\[Mu]Wb/m\"}]},
      {\"naive B(c + a/2) a b\", Row[{NumberForm[10^6 naive, 4], \" \\[Mu]Wb  (\", NumberForm[100 (naive/ph - 1), 3], \" % off)\"}]}}]}, Spacings -> 1]],
 {{i, 10., \"current I (A)\"}, 1, 50, 1, Appearance -> \"Labeled\"},
 {{acm, 6., \"width a (cm)\"}, 1, 20, 0.5, Appearance -> \"Labeled\"},
 {{bcm, 10., \"length b (cm)\"}, 1, 30, 0.5, Appearance -> \"Labeled\"},
 {{ccm, 2., \"distance c (cm)\"}, 0.2, 20, 0.1, Appearance -> \"Labeled\"},
 {{frac, 0.3, \"strip position across the loop\"}, 0, 1, 0.01, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {i, acm, bcm, ccm, frac}]", "Input"],

Cell["The integral, and the two limits", "Section"],

Cell["(* The strip integral in closed form, then c -> infinity (flux -> 0) and c -> 0 (flux -> infinity, logarithmically). *)
{Integrate[mu0v iv/(2 Pi r) bv, {r, cv, cv + av}, Assumptions -> cv > 0 && av > 0], Limit[mu0v iv bv/(2 Pi) Log[1 + av/cv], cv -> Infinity], Limit[mu0v iv bv/(2 Pi) Log[1 + av/cv], cv -> 0, Direction -> \"FromAbove\", Assumptions -> av > 0]}", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The flux by two-dimensional numerical integration of B over the loop against the logarithm, and the naive mid-loop estimate, for I = 10 A, a = 6 cm, b = 10 cm, c = 2 cm. *)
With[{i = 10., a = 0.06, b = 0.10, c = 0.02},
 Grid[{{\"\\[CapitalPhi]_B, 2-D numerical (\\[Mu]Wb)\", 10^6 NIntegrate[bWire[i, r], {r, c, c + a}, {y, -b/2, b/2}]}, {\"(\\[Mu]0 I b/2\\[Pi]) ln(1 + a/c) (\\[Mu]Wb)\", 10^6 flux[i, a, b, c]},
   {\"naive B(c + a/2) a b (\\[Mu]Wb)\", 10^6 bWire[i, c + a/2] a b}, {\"c = 10a, 100a, 1000a (\\[Mu]Wb)\", 10^6 {flux[i, a, b, 10 a], flux[i, a, b, 100 a], flux[i, a, b, 1000 a]}},
   {\"c = a/10, a/100, a/1000 (\\[Mu]Wb)\", 10^6 {flux[i, a, b, a/10], flux[i, a, b, a/100], flux[i, a, b, a/1000]}}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
