(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 29.1 - Magnetic Field Surrounding a Thin, Straight Conductor", "Title"],

Cell["PHYS 193 \:00b7 Week 9 \:00b7 Chapter 29 \:00b7 Lecture slide 15 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A thin, straight wire of finite length carries a constant current I along the x axis. Determine the magnitude and direction of the magnetic field at a point P a distance a from the wire.", "Text"],

Cell["Every element I ds contributes dB = (mu0 I/4 Pi) cos(theta) dx/r^2 out of the page; with r = a/cos(theta) and dx = -a d(theta)/cos^2(theta) the integral gives B = (mu0 I/4 Pi a)(sin(theta1) - sin(theta2)) (Eq. 29.4), and for an infinite wire (theta1 = Pi/2, theta2 = -Pi/2) B = mu0 I/2 Pi a (Eq. 29.5).", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 29.4: (a) a thin, straight wire carrying a current I along the x axis; the element ds at x is a distance r from the point P on the y axis, a height a above O. (b) The angles \:03b8\:2081 and \:03b8\:2082, from P to the ends of the wire, determine the net field. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the Biot\:2013Savart law, Amp\:00e8re\:2019s law and the definition of magnetic flux; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
(* contribution per unit length at P = (0, a) from the element at x: cos(theta)/r^2 = a/r^3 *)
dBdx[x_, a_, i_] := mu0 i/(4 Pi) a/(x^2 + a^2)^(3/2);
(* Equation 29.4 with theta measured from the y axis, tan(theta) = -x/a *)
bWire[a_, i_, x1_, x2_] := mu0 i/(4 Pi a) (Sin[ArcTan[a, -x1]] - Sin[ArcTan[a, -x2]]);", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{a = acm/100., x1 = x1cm/100., x2 = x2cm/100., xe, r, th, b, binf, fig},
  xe = x1 + (x2 - x1) frac; r = Sqrt[xe^2 + a^2]; th = ArcTan[a, -xe];
  b = bWire[a, i, x1, x2]; binf = mu0 i/(2 Pi a);
  fig = Graphics[{
     {GrayLevel[0.6], AbsoluteThickness[7], Line[{{x1, 0}, {x2, 0}}]}, {GrayLevel[0.75], Line[{{x1 - 0.05, 0}, {x2 + 0.05, 0}}], Line[{{0, -0.02}, {0, 1.25 a}}]},
     Text[Style[\"x\", Italic, 12], {x2 + 0.05, -0.02}], Text[Style[\"y\", Italic, 12], {0.012, 1.25 a}], Text[Style[\"O\", Italic, 12], {0.012, -0.02}],
     {GrayLevel[0.7], Dashed, Line[{{x1, 0}, {0, a}}], Line[{{x2, 0}, {0, a}}]},
     {maroon, Rectangle[{xe - 0.006, -0.004}, {xe + 0.006, 0.004}]}, Text[Style[\"ds\", Italic, 12, Bold, maroon], {xe, -0.025}],
     {gold, Line[{{xe, 0}, {0, a}}]}, Text[Style[\"r\", Italic, 12, gold], {xe/2 - 0.012, a/2}],
     {ink, Arrowheads[0.03], Arrow[{{xe, 0}, {xe, 0} + 0.12 a {-xe, a}/r}]},
     {green, Arrowheads[0.04], Arrow[{{x2 - 0.05, -0.03 a}, {x2 - 0.01, -0.03 a}}]}, Text[Style[\"I\", Italic, 12, Bold, green], {x2 - 0.03, -0.07 a}],
     {Black, PointSize[0.015], Point[{0, a}]}, Text[Style[\"P\", Italic, 13, Bold], {-0.015, a + 0.03 a}],
     Text[Style[Row[{\"\\[Theta] = \", NumberForm[th/Degree, 4], \"\\[Degree]   dB out of the page\"}], 11], {0, 1.42 a}]},
    PlotRange -> {{Min[x1, -0.3 a] - 0.06, Max[x2, 0.3 a] + 0.06}, {-0.15 a, 1.5 a}}, AspectRatio -> Automatic, ImageSize -> 440];
  Column[{fig,
    Plot[10^6 dBdx[x, a, i], {x, x1, x2}, PlotStyle -> Directive[green, Thick], Filling -> Axis, Frame -> True, FrameLabel -> {\"x (m)\", \"dB/dx (\\[Mu]T/m)\"}, PlotRange -> {0, All},
     GridLines -> {{xe}, None}, GridLinesStyle -> Directive[gold, Dashed], Epilog -> {gold, PointSize[0.02], Point[{xe, 10^6 dBdx[xe, a, i]}]}, ImageSize -> 440],
    Plot[10^6 bWire[a, i, x1, x], {x, x1, x2}, PlotStyle -> Directive[blue, Thick], Frame -> True, FrameLabel -> {\"x (m)\", \"running sum (\\[Mu]T)\"}, PlotRange -> {0, 1.15 10^6 Max[b, binf]},
     GridLines -> {{xe}, {10^6 b, 10^6 binf}}, GridLinesStyle -> Directive[gold, Dashed], PlotLegends -> {\"\\[Integral] dB from x1\"}, ImageSize -> 440],
    results[{
      {\"\\[Theta]1, \\[Theta]2\", Row[{NumberForm[ArcTan[a, -x1]/Degree, 4], \"\\[Degree], \", NumberForm[ArcTan[a, -x2]/Degree, 4], \"\\[Degree]\"}]},
      {\"B = \\[Mu]0 I (sin \\[Theta]1 - sin \\[Theta]2)/4\\[Pi]a\", Row[{NumberForm[10^6 b, 4], \" \\[Mu]T  (\", NumberForm[100 b/binf, 3], \" % of the infinite wire)\"}]},
      {\"infinite wire \\[Mu]0 I/2\\[Pi]a\", Row[{NumberForm[10^6 binf, 4], \" \\[Mu]T\"}]}}]}, Spacings -> 1]],
 {{i, 5., \"current I (A)\"}, 0.5, 20, 0.5, Appearance -> \"Labeled\"},
 {{acm, 4., \"distance a (cm)\"}, 1, 20, 0.5, Appearance -> \"Labeled\"},
 {{x1cm, -12., \"left end x1 (cm)\"}, -60, 0, 1, Appearance -> \"Labeled\"},
 {{x2cm, 6., \"right end x2 (cm)\"}, 0, 60, 1, Appearance -> \"Labeled\"},
 {{frac, 0.35, \"element position (fraction along)\"}, 0, 1, 0.01, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {i, acm, x1cm, x2cm, frac}]", "Input"],

Cell["The integral done symbolically", "Section"],

Cell["(* Changing variable to theta turns the integrand into -(mu0 I/4 Pi a) cos(theta); Mathematica does it directly in x as well. *)
{Integrate[mu0v iv/(4 Pi) av/(x^2 + av^2)^(3/2), {x, x1v, x2v}, Assumptions -> av > 0] // Simplify,
 Integrate[mu0v iv/(4 Pi) av/(x^2 + av^2)^(3/2), {x, -Infinity, Infinity}, Assumptions -> av > 0]}", "Input"],

Cell["Going further - how long is \"infinite\"?", "Section"],

Cell["(* Fraction of the infinite-wire field for a wire extending L on each side of O, at distance a. *)
Table[{L, NumberForm[100 bWire[1., 1., -L, L]/(mu0 1./(2 Pi 1.)), 4]}, {L, {1, 2, 5, 10, 100}}] // TableForm", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The Biot-Savart integral by numerical integration in x against Equation 29.4, and the long-wire limit against Equation 29.5. *)
With[{a = 0.04, i = 5., x1 = -0.12, x2 = 0.06},
 Grid[{{\"B numerical (\\[Mu]T)\", 10^6 NIntegrate[dBdx[x, a, i], {x, x1, x2}]}, {\"Equation 29.4 (\\[Mu]T)\", 10^6 bWire[a, i, x1, x2]},
   {\"wire of \\[PlusMinus]1000 a (\\[Mu]T)\", 10^6 bWire[a, i, -1000 a, 1000 a]}, {\"Equation 29.5 (\\[Mu]T)\", 10^6 mu0 i/(2 Pi a)}, {\"semi-infinite wire from O (\\[Mu]T)\", 10^6 bWire[a, i, 0, 1000 a]}},
  Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
