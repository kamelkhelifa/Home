(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 29.6 - The Magnetic Field Created by a Toroid", "Title"],

Cell["PHYS 193 \:00b7 Week 9 \:00b7 Chapter 29 \:00b7 Lecture slide 56 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A toroid has N closely spaced turns of wire on a ring (inner radius b, outer radius c, cross-section radius a). Calculate the magnetic field in the region occupied by the torus, a distance r from the centre.", "Text"],

Cell["The circular amperian loop of radius r inside the torus is threaded by all N turns: B 2 Pi r = mu0 N I, so B = mu0 N I/2 Pi r (Eq. 29.16), nonuniform (1/r) across the ring but nearly uniform when a << r. A loop in the hole or outside the ring encloses zero net current; the weak external field comes from the one effective turn of current circulating round the ring.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 29.15: a toroid of N closely spaced turns wound on a ring of inner radius b, outer radius c and cross-sectional radius a. Inside the ring the field is tangent to the dashed circle (loop 1) of radius r; loop 2, perpendicular to the page, is threaded by the current circulating round the ring. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the Biot\:2013Savart law, Amp\:00e8re\:2019s law and the definition of magnetic flux; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
bTor[n_, i_, r_, b_, c_] := If[b <= r <= c, mu0 n i/(2 Pi r), 0];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{rb = rbcm/100., a = acm/100., r = rcm/100., b, c, bb, bc, bm, bOn, nShow, fig},
  b = rb - a; c = rb + a; bb = mu0 n i/(2 Pi b); bc = mu0 n i/(2 Pi c); bm = mu0 n i/(2 Pi rb); bOn = bTor[n, i, r, b, c]; nShow = Min[n, 36];
  fig = Graphics[{{gold, Opacity[0.3], Disk[{0, 0}, c]}, {White, Disk[{0, 0}, b]}, {ink, Circle[{0, 0}, c], Circle[{0, 0}, b]},
     Table[With[{u = {Cos[ph], Sin[ph]}}, {{RGBColor[0.48, 0.25, 0.69], Opacity[0.7], Line[{b u, c u}]}, dotG[(b - 0.012) u, 0.006, RGBColor[0.48, 0.25, 0.69]], crossG[(c + 0.012) u, 0.006, RGBColor[0.48, 0.25, 0.69]]}], {ph, 0, 2 Pi - 0.01, 2 Pi/nShow}],
     {blue, Dashed, AbsoluteThickness[1.5], Circle[{0, 0}, r]}, Text[Style[\"loop 1\", 10, blue], 0.72 r {1, -1} + {0, -0.015}],
     If[bOn > 0, Table[With[{q = r {Cos[ph], Sin[ph]}}, {green, AbsoluteThickness[2], Arrowheads[0.03], Arrow[{q, q + 0.08 (bOn/bb) {-Sin[ph], Cos[ph]}}]}], {ph, 0.26, 2 Pi, Pi/6}], {}],
     {blue, Line[{{0, 0}, r {1, -1}/Sqrt[2]}]}, Text[Style[\"r\", Italic, 12, blue], 0.4 r {1, -1}/Sqrt[2] + {0.012, 0.01}],
     {ink, Line[{{0, 0}, {0, b}}]}, Text[Style[\"b\", Italic, 12], {-0.012, b/2}], {ink, Line[{{0, 0}, c {-1, 1}/Sqrt[2]}]}, Text[Style[\"c\", Italic, 12], 0.5 c {-1, 1}/Sqrt[2] + {-0.015, -0.006}],
     {ink, Line[{{rb, 0}, {c, 0}}]}, Text[Style[\"a\", Italic, 12], {rb + a/2, 0.015}],
     Text[Style[If[bOn > 0, Row[{\"B = \", NumberForm[1000 bOn, 3], \" mT\"}], \"B = 0 on loop 1 (no net current enclosed)\"], 11, Bold, green], {0, -1.2 Max[c, r]}]},
    PlotRange -> 1.3 Max[c, r], AspectRatio -> Automatic, ImageSize -> 420];
  Column[{fig,
    Plot[1000 bTor[n, i, rr/100., b, c], {rr, 0, 30}, PlotStyle -> Directive[green, Thick], Frame -> True, FrameLabel -> {\"r (cm)\", \"B (mT)\"}, PlotRange -> {0, 1.15 1000 bb}, Exclusions -> None, PlotPoints -> 300,
     Prolog -> {Opacity[0.08], Black, Rectangle[{100 b, 0}, {100 c, 2000 bb}]}, GridLines -> {{rcm}, {1000 bm}}, GridLinesStyle -> Directive[gold, Dashed], Epilog -> {gold, PointSize[0.02], Point[{rcm, 1000 bOn}]}, ImageSize -> 420],
    results[{
      {\"turns enclosed by loop 1\", If[bOn > 0, Row[{n, \" turns, N I = \", NumberForm[n i, 4], \" A\"}], \"0 net\"]},
      {\"B on loop 1\", Row[{NumberForm[1000 bOn, 4], \" mT\"}]},
      {\"B across the cross-section (c to b)\", Row[{NumberForm[1000 bc, 4], \" mT to \", NumberForm[1000 bb, 4], \" mT\"}]},
      {\"relative non-uniformity (c - b)/r\\[Macron]\", Row[{NumberForm[100 2 a/rb, 3], \" %\"}]}}]}, Spacings -> 1]],
 {{n, 500, \"number of turns N\"}, 20, 2000, 10, Appearance -> \"Labeled\"},
 {{i, 2., \"current I (A)\"}, 0.1, 10, 0.1, Appearance -> \"Labeled\"},
 {{rbcm, 10., \"mean radius of the ring (cm)\"}, 3, 20, 0.5, Appearance -> \"Labeled\"},
 {{acm, 2., \"cross-section radius a (cm)\"}, 0.5, 5, 0.1, Appearance -> \"Labeled\"},
 {{rcm, 10., \"radius r of loop 1 (cm)\"}, 0, 30, 0.1, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {n, i, rbcm, acm, rcm}]", "Input"],

Cell["Going further - how uniform is \"almost uniform\"?", "Section"],

Cell["(* The relative spread of B across the cross-section, exactly and to first order in a/r. *)
Simplify[(mu0v nv iv/(2 Pi (rv - av)) - mu0v nv iv/(2 Pi (rv + av)))/(mu0v nv iv/(2 Pi rv))] // Together", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Equation 29.16 for N = 500, I = 2.0 A, mean radius 10 cm, a = 2 cm; the field at the three radii, the spread, and the one-loop estimate of the stray field at the centre of the hole. *)
With[{n = 500, i = 2., rb = 0.10, a = 0.02},
 Grid[{{\"B at b, r\\[Macron], c (mT)\", 1000 {mu0 n i/(2 Pi (rb - a)), mu0 n i/(2 Pi rb), mu0 n i/(2 Pi (rb + a))}},
   {\"(B_b - B_c)/B_r\\[Macron]\", (1/(rb - a) - 1/(rb + a)) rb}, {\"(c - b)/r\\[Macron]\", 2 a/rb},
   {\"stray field of one loop at the centre, \\[Mu]0 I/2r\\[Macron] (\\[Mu]T)\", 10^6 mu0 i/(2 rb)}, {\"ratio B_inside/stray\", (mu0 n i/(2 Pi rb))/(mu0 i/(2 rb))}},
  Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
