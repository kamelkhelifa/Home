(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 29.3 - Magnetic Field on the Axis of a Circular Current Loop", "Title"],

Cell["PHYS 193 \:00b7 Week 9 \:00b7 Chapter 29 \:00b7 Lecture slide 23 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A circular loop of radius a in the yz plane carries a steady current I. Calculate the magnetic field at an axial point P a distance x from the centre.", "Text"],

Cell["Every element is at the same distance r = Sqrt[a^2 + x^2] from P with ds perpendicular to r-hat; the perpendicular components cancel in pairs and the axial ones add: B_x = mu0 I a^2/2(a^2 + x^2)^(3/2) (Eq. 29.7), mu0 I/2a at the centre (Eq. 29.8). What if? Far away, B ~ mu0 mu/2 Pi x^3 with mu = I Pi a^2, the field of a magnetic dipole.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 29.6: geometry for calculating the magnetic field at a point P on the axis of a current loop of radius a lying in the yz plane. The element ds at the top of the loop gives dB at P, resolved into dB_x along the axis and dB_\:22a5; by symmetry the total field B is along the axis. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the Biot\:2013Savart law, Amp\:00e8re\:2019s law and the definition of magnetic flux; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
bAxis[a_, i_, x_] := mu0 i a^2/(2 (a^2 + x^2)^(3/2));
(* full three-dimensional Biot-Savart sum round the loop (in the yz plane, current counter-clockwise seen from +x) at the point {x, 0, 0} *)
biot3[a_, i_, x_, n_ : 2000] := Module[{ph, p, ds, r},
  Sum[ph = 2 Pi (k + 0.5)/n; p = {0, a Cos[ph], a Sin[ph]}; ds = 2 Pi a/n {0, -Sin[ph], Cos[ph]}; r = {x, 0, 0} - p;
   mu0 i/(4 Pi) Cross[ds, r]/Norm[r]^3, {k, 0, n - 1}]];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{a = acm/100., x = xcm/100., ph = phdeg Degree, r, b, mu, fig, E1, E2, P, dBdir, len},
  r = Sqrt[a^2 + x^2]; b = bAxis[a, i, x]; mu = i Pi a^2;
  (* side view: the loop edge-on as a thin ellipse, the element at angle ph and its mirror element *)
  E1 = {0.22 a Sin[ph], a Cos[ph]}; E2 = {0.22 a Sin[ph + Pi], a Cos[ph + Pi]}; P = {x, 0}; len = 0.9 a;
  fig = Graphics[{{GrayLevel[0.75], Line[{{-0.5 a, 0}, {Max[1.3 x, 2 a] + 0.3 a, 0}}]}, Text[Style[\"x\", Italic, 12], {Max[1.3 x, 2 a] + 0.4 a, 0}],
     {GrayLevel[0.6], AbsoluteThickness[6], Circle[{0, 0}, {0.22 a, a}]}, Text[Style[\"O\", Italic, 12], {-0.1 a, -0.12 a}], Text[Style[\"I\", Italic, 12, Bold, green], {-0.32 a, -0.75 a}],
     {GrayLevel[0.7], Dashed, Line[{{0, 0}, {0, a}}]}, Text[Style[\"a\", Italic, 12], {0.08 a, 0.5 a}],
     Table[With[{e = ee[[1]], col = ee[[2]], u = (P - ee[[1]])/Norm[P - ee[[1]]]},
       {{gold, Dashed, Line[{e, P}]}, {col, PointSize[0.018], Point[e]},
        (* dB is perpendicular to r-hat in the plane of r and the axis, with its axial part along +x *)
        With[{d = If[e[[2]] >= 0, {-u[[2]], u[[1]]}, {u[[2]], -u[[1]]}]},
         {{col, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{P, P + len d}]}, {green, AbsoluteThickness[2], Arrowheads[0.035], Arrow[{P, P + len {d[[1]], 0}}]},
          {col, Dashed, Arrowheads[0.03], Arrow[{P, P + len {0, d[[2]]}}]}, {GrayLevel[0.6], Dashed, Line[{P + len d, P + len {d[[1]], 0}}]}}]}], {ee, {{E1, maroon}, {E2, blue}}}],
     Text[Style[\"ds\", Italic, 11, Bold, maroon], E1 + {-0.15 a, 0}], Text[Style[\"ds'\", Italic, 11, Bold, blue], E2 + {-0.15 a, 0}],
     {Black, PointSize[0.014], Point[P]}, Text[Style[\"P\", Italic, 12, Bold], P + {0.05 a, -0.12 a}],
     Text[Style[\"dB_x (add)\", 10, green], P + {len a/r + 0.1 a, -0.1 a}], Text[Style[\"dB_\\[Perpendicular] (cancel)\", 10, Gray], P + {0.1 a, len x/r + 0.12 a}],
     Text[Style[Row[{\"r = \", NumberForm[100 r, 3], \" cm,  cos \\[Theta] = a/r = \", NumberForm[a/r, 3]}], 10], {0.5 Max[1.3 x, 2 a], -1.25 a}]},
    PlotRange -> {{-0.6 a, Max[1.3 x, 2 a] + 0.5 a}, {-1.4 a, 1.4 a}}, AspectRatio -> Automatic, ImageSize -> 440];
  Column[{fig,
    Plot[{10^6 bAxis[a, i, xx], If[xx > 0.01, Min[2 10^6 mu0 i/(2 a), 10^6 mu0 mu/(2 Pi xx^3)], None]}, {xx, 0, Max[3 a, 1.3 x]}, PlotStyle -> {Directive[green, Thick], Directive[maroon, Dashed]},
     Frame -> True, FrameLabel -> {\"x (m)\", \"B_x (\\[Mu]T)\"}, PlotRange -> {0, 1.15 10^6 mu0 i/(2 a)}, GridLines -> {{x, a}, {10^6 mu0 i/(2 a)}}, GridLinesStyle -> Directive[gold, Dashed],
     PlotLegends -> {\"Eq. 29.7\", \"dipole \\[Mu]0 \\[Mu]/2\\[Pi]x\\.b3\"}, Epilog -> {gold, PointSize[0.02], Point[{x, 10^6 b}]}, ImageSize -> 440],
    results[{
      {\"B_x at P = \\[Mu]0 I a\\.b2/2(a\\.b2 + x\\.b2)^(3/2)\", Row[{NumberForm[10^6 b, 4], \" \\[Mu]T\"}]},
      {\"centre \\[Mu]0 I/2a\", Row[{NumberForm[10^6 mu0 i/(2 a), 4], \" \\[Mu]T\"}]},
      {\"dipole form \\[Mu]0 \\[Mu]/2\\[Pi]x\\.b3\", If[x > 0, Row[{NumberForm[10^6 mu0 mu/(2 Pi x^3), 4], \" \\[Mu]T  (x = \", NumberForm[x/a, 3], \" a)\"}], \"- (x = 0)\"]},
      {\"magnetic moment \\[Mu] = I \\[Pi] a\\.b2\", Row[{NumberForm[mu, 4], \" A m\\.b2\"}]}}]}, Spacings -> 1]],
 {{i, 5., \"current I (A)\"}, 0.5, 20, 0.5, Appearance -> \"Labeled\"},
 {{acm, 5., \"radius a (cm)\"}, 1, 20, 0.5, Appearance -> \"Labeled\"},
 {{xcm, 8., \"distance x of P (cm)\"}, 0, 60, 0.5, Appearance -> \"Labeled\"},
 {{phdeg, 20, \"element position on the loop (\\[Degree])\"}, 0, 360, 2, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {i, acm, xcm, phdeg}]", "Input"],

Cell["What if? - far from the loop", "Section"],

Cell["(* The series of Equation 29.7 for x >> a: the leading term is the dipole field mu0 mu/2 Pi x^3 with mu = I Pi a^2. *)
{Series[mu0v iv av^2/(2 (av^2 + xv^2)^(3/2)), {xv, Infinity, 5}], mu0v (iv Pi av^2)/(2 Pi xv^3)}", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The full 3-D Biot-Savart sum round the loop: the axial component against Equation 29.7, the transverse components (zero by symmetry), the centre value against Equation 29.8. *)
With[{a = 0.05, i = 5., x = 0.08},
 Module[{b = biot3[a, i, x], b0 = biot3[a, i, 0.]},
  Grid[{{\"B_x numerical (\\[Mu]T)\", 10^6 b[[1]]}, {\"Equation 29.7 (\\[Mu]T)\", 10^6 bAxis[a, i, x]}, {\"B_y, B_z numerical (\\[Mu]T)\", Chop[10^6 b[[2 ;; 3]], 10^-9]},
    {\"centre, numerical (\\[Mu]T)\", 10^6 b0[[1]]}, {\"Equation 29.8 (\\[Mu]T)\", 10^6 mu0 i/(2 a)}, {\"at x = 10 a: Eq. 29.7 vs dipole (\\[Mu]T)\", {10^6 bAxis[a, i, 10 a], 10^6 mu0 (i Pi a^2)/(2 Pi (10 a)^3)}}},
   Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
