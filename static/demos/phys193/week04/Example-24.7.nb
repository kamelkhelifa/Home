(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 24.7 - Electric Potential Due to a Finite Line of Charge", "Title"],

Cell["PHYS 193 \:00b7 Week 4 \:00b7 Chapter 24 \:00b7 Lecture slide 74 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A rod of length l located along the x axis has a total charge Q and a uniform linear charge density lambda. Find the electric potential at a point P located on the y axis a distance a from the origin (Fig. 24.16).", "Text"],

Cell["V = ke (Q/l) Log[(l + Sqrt[a^2 + l^2])/a] (Eq. 24.25), which tends to ke Q/a when l << a. What if the field is wanted? Ey = -dV/da from Eq. 24.25; Ex needs V off the y axis, or a direct integration.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 24.16: a uniform line charge of length \:2113 located along the x axis. To calculate the electric potential at P, the line charge is divided into segments each of length dx and each carrying a charge dq = \:03bb dx. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from electric potential, potential energy and the potential of charge distributions and conductors; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
ke = 8.99*^9;
vRod[q_, l_, a_] := ke q/l Log[(l + Sqrt[a^2 + l^2])/a];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{qq = q 10^-9, ll = l/100, aa = a/100},
  Column[{
    LogLogPlot[{Log[(1 + Sqrt[t^2 + 1])/t], 1/t}, {t, 0.01, 10}, Frame -> True, FrameLabel -> {\"a/l\", \"V (ke Q/l)\"}, PlotLegends -> {\"rod\", \"point charge\"},
     GridLines -> {{aa/ll}, {}}, ImageSize -> 380],
    results[{{\"V at P\", Row[{NumberForm[vRod[qq, ll, aa], 4], \" V\"}]}, {\"ke Q/a\", Row[{NumberForm[ke qq/aa, 4], \" V\"}]},
      {\"Ey = -dV/da\", Row[{NumberForm[-D[vRod[qq, ll, s], s] /. s -> aa, 4], \" V/m\"}]},
      {\"Ex (direct)\", Row[{NumberForm[NIntegrate[-ke qq/ll x/(aa^2 + x^2)^(3/2), {x, 0, ll}], 4], \" V/m\"}]}}]}, Spacings -> 1]],
 {{q, 10, \"Q (nC)\"}, 1, 100, 1, Appearance -> \"Labeled\"}, {{l, 30, \"l (cm)\"}, 1, 100, 1, Appearance -> \"Labeled\"},
 {{a, 20, \"a (cm)\"}, 0.5, 300, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {q, l, a}]", "Input"],

Cell["Check the numbers", "Section"],

Cell["With[{q = 10.*^-9, l = 0.3, a = 0.2},
 {\"NIntegrate\" -> NIntegrate[ke q/l/Sqrt[a^2 + x^2], {x, 0, l}], \"Eq. 24.25\" -> vRod[q, l, a],
  \"short-rod limit\" -> Series[Log[(l + Sqrt[a^2 + l^2])/a] /. l -> eps, {eps, 0, 1}]}]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
