(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 25.1 - The Cylindrical Capacitor", "Title"],

Cell["PHYS 193 \:00b7 Week 5 \:00b7 Chapter 25 \:00b7 Lecture slide 22 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A solid cylindrical conductor of radius a is coaxial with a cylindrical shell of negligible thickness and radius b > a (Fig. 25.4a). Find the capacitance of this cylindrical capacitor if its length is l >> b.", "Text"],

Cell["Delta V = 2 k_e lambda ln(b/a), so C = l/(2 k_e ln(b/a)) (Eq. 25.4). What if b = 2.00a: increasing a by 10% raises C by 16%, more than increasing l by 10%; for b > 2.85a the length wins.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 25.4: (a) a cylindrical capacitor consists of a solid cylindrical conductor of radius a and length \:2113 surrounded by a coaxial cylindrical shell of radius b. (b) End view of the capacitor if it is charged. The electric field lines are radial. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from capacitance, combinations of capacitors, stored energy and dielectrics; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
ke = 8.99*^9; e0 = 1/(4 Pi ke);
cCyl[a_, b_, l_] := l/(2 ke Log[b/a]);
gainA[x_] := Log[x]/Log[x/1.1] - 1;   (* fractional gain from a -> 1.1 a at fixed b, x = b/a *)", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{aa = a/100, bb = Max[b, 1.05 a]/100, ll = l/100, c},
  c = cCyl[aa, bb, ll];
  Column[{
    Graphics[{{Lighter[Blue, 0.85], EdgeForm[{Thick, Black}], Disk[{0, 0}, bb]},
      {Dashed, Gray, Table[Circle[{0, 0}, aa (bb/aa)^(k/6)], {k, 1, 5}]},
      {Orange, Arrowheads[0.025], Table[Arrow[{1.02 aa {Cos[t], Sin[t]}, 0.98 bb {Cos[t], Sin[t]}}], {t, Pi/16, 2 Pi, Pi/8}]},
      {Lighter[Red, 0.5], EdgeForm[Black], Disk[{0, 0}, aa]}}, PlotRange -> 0.085, ImageSize -> 260],
    Plot[{10, 100 gainA[x]}, {x, 1.2, 6}, Frame -> True, FrameLabel -> {\"b/a\", \"increase in C (%)\"}, PlotRange -> {0, 60},
     PlotLegends -> {\"l + 10 %\", \"a + 10 %\"}, GridLines -> {{2.853}, {}}, ImageSize -> 400,
     Epilog -> {Red, PointSize[0.02], Point[{Min[6, bb/aa], 100 gainA[bb/aa]}]}],
    results[{{\"capacitance C\", Row[{NumberForm[10^12 c, 4], \" pF\"}]}, {\"C/l\", Row[{NumberForm[10^12 c/ll, 4], \" pF/m\"}]},
      {\"gain from a + 10 %\", Row[{NumberForm[100 gainA[bb/aa], 3], \" %\"}]}}]}, Spacings -> 1]],
 {{a, 1.0, \"inner radius a (cm)\"}, 0.1, 4, 0.01, Appearance -> \"Labeled\"},
 {{b, 2.0, \"shell radius b (cm)\"}, 0.2, 8, 0.01, Appearance -> \"Labeled\"},
 {{l, 50, \"length l (cm)\"}, 10, 200, 1, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {a, b, l}]", "Input"],

Cell["What If - the crossover", "Section"],

Cell["{\"C'/C at b = 2a\" -> 1 + gainA[2.], \"b/a where both choices tie\" -> x /. FindRoot[gainA[x] == 0.1, {x, 2.5}]}", "Input"],

Cell["Check the numbers - Laplace's equation", "Section"],

Cell["(* (1/r)(r V')' = 0 with V(a) = 1, V(b) = 0, solved numerically; lambda = 2 pi e0 a E(a) gives C/l *)
With[{a = 0.01, b = 0.02},
 Module[{v},
  v = NDSolveValue[{D[r v'[r], r] == 0, v[a] == 1, v[b] == 0}, v, {r, a, b}];
  {\"C/l numerical (pF/m)\" -> 10^12 2 Pi e0 a (-v'[a]), \"1/(2 ke ln(b/a)) (pF/m)\" -> 10^12/(2 ke Log[b/a])}]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
