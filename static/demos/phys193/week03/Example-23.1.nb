(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 23.1 - The Electric Field Due to a Charged Rod", "Title"],

Cell["PHYS 193 \:00b7 Week 3 \:00b7 Chapter 23 \:00b7 Lecture slide 12 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A rod of length l has a uniform positive charge per unit length lambda and a total charge Q. Calculate the electric field at a point P that is located along the long axis of the rod and a distance a from one end.", "Text"],

Cell["The rod is cut into N pieces; each piece is treated as a point charge at its centre and their fields at P are added. As N grows the sum becomes the integral of the slide, E = k_e Q/[a(l + a)]. The What If? panel compares the exact field with the point-charge field k_e Q/a^2.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 23.2: the uniformly charged rod and the point P on its axis, a distance a from one end. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation \[Rule] Evaluate Notebook). Every number and figure is computed from Coulomb's law; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["kE = 8.9875517873681764*^9;            (* N m^2/C^2 *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31];

(* exact result, Eq. (1) of the slide *)
eRod[q_, l_, a_] := kE q/(a (l + a));
(* N point charges q/N at the midpoints of N equal pieces *)
eSum[q_, l_, a_, n_Integer] := Sum[kE (q/n)/(a + (i - 1/2) l/n)^2, {i, 1, n}];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{q = qq 10.^-6, a = 10.^la, ad, parts, tot, dir, ltot, cum, col, geo, plot, x0, x1, dots},
  col[i_] := If[OddQ[i], blue, gold];
  ad = Min[a, 1.4 l];                                   (* displayed gap; axis not to scale when a is large *)
  parts = Table[Abs[kE (q/n)/(a + (i - 1/2) l/n)^2], {i, n}];
  tot = Max[Total[parts], 10.^-300];
  dir = If[q >= 0, -1, 1]; ltot = 1.2 l;
  cum = Prepend[Accumulate[parts/tot ltot], 0];
  geo = Graphics[{
     {GrayLevel[0.6], Line[{{-1.4 l, 0}, {ad + 1.1 l, 0}}]},
     Table[{col[i], Rectangle[{ad + (i - 1) l/n, -0.03 l}, {ad + i l/n, 0.03 l}]}, {i, n}],
     {Black, PointSize[0.02], Point[{0, 0}], Text[Style[\"P\", Italic, Bold, 14], {0, -0.09 l}]},
     If[q != 0, {
       Table[{col[i], Rectangle[{Min[dir cum[[i]], dir cum[[i + 1]]], 0.12 l}, {Max[dir cum[[i]], dir cum[[i + 1]]], 0.16 l}]}, {i, n}],
       Text[Style[\"dE from each piece, tip to tail\", 11, Gray], {dir ltot/2, 0.20 l}],
       {maroon, Thickness[0.006], Arrowheads[0.04], Arrow[{{0, 0.28 l}, {dir ltot, 0.28 l}}]},
       Text[Style[\"E = \\[Sum] dE\", 13, Bold, maroon], {dir ltot/2, 0.34 l}]}, {}],
     Text[Style[Row[{\"a = \", NumberForm[a, 3], \" m\", If[a > 1.4 l, \" (not to scale)\", \"\"]}], 11, Gray], {ad/2, -0.15 l}],
     Text[Style[Row[{\"\\[ScriptL] = \", NumberForm[l, 3], \" m\"}], 11, Gray], {ad + l/2, -0.15 l}]},
    PlotRange -> {{-1.45 l, ad + 1.15 l}, {-0.22 l, 0.4 l}}, AspectRatio -> Automatic, ImageSize -> 560];
  x0 = Min[l/100, a/2]; x1 = Max[100 l, 2 a];
  dots = Table[{x, eSum[Max[Abs[q], 10.^-15], l, x, n]}, {x, x0 (x1/x0)^Range[0, 1, 1/22]}];
  plot = Show[
    LogLogPlot[{kE Max[Abs[q], 10.^-15]/x^2, eRod[Max[Abs[q], 10.^-15], l, x]}, {x, x0, x1},
     PlotStyle -> {Directive[gold, Dashed], Directive[maroon, Thick]},
     PlotLegends -> Placed[{\"point charge k\:2091Q/a\:00b2\", \"exact, Eq. (1)\"}, {Right, Top}],
     Frame -> True, FrameLabel -> {\"a (m)\", \"E (N/C)\"}, GridLines -> Automatic, GridLinesStyle -> GrayLevel[0.9], ImageSize -> 560],
    ListLogLogPlot[dots, PlotStyle -> {blue, PointSize[0.012]}],
    Graphics[{maroon, PointSize[0.02], Point[{Log[a], Log[eRod[Max[Abs[q], 10.^-15], l, a]]}]}]];
  Column[{geo, plot,
    Grid[{
      {\"E exact, Eq. (1)\", Row[{ScientificForm[Abs[eRod[q, l, a]], 4], \" N/C  \", If[q > 0, \"(\\[Minus]x, away from rod)\", If[q < 0, \"(+x, towards rod)\", \"\"]]}]},
      {Row[{\"sum of N = \", n, \" pieces\"}], Row[{ScientificForm[Abs[eSum[q, l, a, n]], 4], \" N/C\"}]},
      {\"error of the sum\", If[q != 0, Row[{NumberForm[100 Abs[eSum[q, l, a, n] - eRod[q, l, a]]/Abs[eRod[q, l, a]], 3], \" %\"}], \"\\[LongDash]\"]},
      {\"point charge k\:2091Q/a\:00b2\", Row[{ScientificForm[Abs[kE q/a^2], 4], \" N/C\"}]}},
     Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}]}, Spacings -> 1.5]],
 {{l, 0.50, \"rod length \\[ScriptL] (m)\"}, 0.05, 2, 0.01, Appearance -> \"Labeled\"},
 {{la, Log10[0.20], \"log\:2081\:2080(a / m)\"}, Log10[0.005], Log10[50], Appearance -> \"Labeled\"},
 {{qq, 5.0, \"total charge Q (\\[Mu]C)\"}, -10, 10, 0.1, Appearance -> \"Labeled\"},
 {{n, 8, \"number of pieces N\"}, 1, 40, 1, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {l, la, qq, n}]", "Input"],

Cell["What if? Point P very far from the rod", "Section"],

Cell["(* E / (k_e Q/a^2) = a/(a + l): the point-charge formula overestimates the field by the fraction l/a. *)
Manipulate[
 Column[{
   LogLinearPlot[r/(r + 1), {r, 0.01, 1000}, PlotRange -> {0, 1.08}, PlotStyle -> Directive[maroon, Thick],
    Frame -> True, FrameLabel -> {\"a / \\[ScriptL]\", \"E / (k\:2091Q/a\:00b2)\"}, ImageSize -> 560,
    GridLines -> {{99}, {1}}, GridLinesStyle -> Directive[green, Dashed],
    Epilog -> {maroon, PointSize[0.02], Point[{Log[10.^lr], 10.^lr/(10.^lr + 1)}]}],
   Grid[{{\"a / \\[ScriptL]\", NumberForm[10.^lr, 4]}, {\"E / (k\:2091Q/a\:00b2) = a/(a+\\[ScriptL])\", NumberForm[10.^lr/(10.^lr + 1), 5]},
     {\"point-charge formula too large by\", Row[{NumberForm[100/10.^lr, 3], \" %\"}]}}, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8]],
   Style[\"Within 1 % once a > 99 \\[ScriptL].\", Italic]}],
 {{lr, Log10[0.4], \"log\:2081\:2080(a / \\[ScriptL])\"}, -2, 3, Appearance -> \"Labeled\"}]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The integral is the limit of the sum: error ~ 1/N^2 (midpoint rule). Values for l = 0.50 m, a = 0.20 m, Q = 5.00 uC. *)
With[{q = 5.00*^-6, l = 0.50, a = 0.20},
 Grid[Prepend[
   Table[{n, ScientificForm[eSum[q, l, a, n], 7], ScientificForm[eRod[q, l, a], 7], ScientificForm[Abs[eSum[q, l, a, n]/eRod[q, l, a] - 1], 2]}, {n, {1, 10, 100, 1000, 10000}}],
   {\"N pieces\", \"sum (N/C)\", \"exact (N/C)\", \"relative error\"}], Frame -> All, Alignment -> Right]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
