(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 26.2 - The Resistance of Nichrome Wire", "Title"],

Cell["PHYS 193 \:00b7 Week 6 \:00b7 Chapter 26 \:00b7 Lecture slide 34 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["The radius of 22-gauge Nichrome wire is 0.32 mm. (A) Calculate the resistance per unit length of this wire. (B) If a potential difference of 10 V is maintained across a 1.0-m length of the Nichrome wire, what is the current in the wire?", "Text"],

Cell["(A) R/l = rho/(pi r^2) = 3.1 ohm/m. (B) I = Delta V/((R/l) l) = 3.2 A. What if the wire were copper? 0.053 ohm/m and 190 A: the resistivity is two orders of magnitude smaller.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 26.5: a uniform conductor of length \:2113 and cross-sectional area A. A potential difference \:0394V = V_b \:2212 V_a maintained across the conductor sets up an electric field E, and this field produces a current I that is proportional to the potential difference. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the laws of current and resistance (drift speed, resistivity, Ohm's law and electrical power); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* Table 26.2, resistivity at 20 C (ohm m) *)
rhoOf = <|\"Nichrome\" -> 1.00*^-6, \"copper\" -> 1.7*^-8, \"aluminium\" -> 2.82*^-8, \"tungsten\" -> 5.6*^-8, \"iron\" -> 10*^-8, \"carbon\" -> 3.5*^-5|>;", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{rho = rhoOf[mat], a = Pi (r 10^-3)^2, res, cur},
  res = rho l/a; cur = dv/res;
  Column[{
    Graphics[{EdgeForm[Black], FaceForm[Lighter[Orange, 0.7]], Rectangle[{0, -r/2}, {6, r/2}], Orange,
      Table[Arrow[{{x, 0}, {x + 0.5, 0}}], {x, 0.4, 5.2, 0.8}], Black,
      Text[Style[\"V_b\", Italic, 14], {-0.4, 0}], Text[Style[\"V_a\", Italic, 14], {6.4, 0}],
      Purple, Thick, Arrow[{{6.6, 0.3}, {7.4, 0.3}}], Text[Style[Row[{\"I = \", NumberForm[cur, 3], \" A\"}], 12, Purple], {7.0, 0.7}]},
     PlotRange -> {{-0.8, 8}, {-1.2, 1.2}}, ImageSize -> 420],
    LogLogPlot[Evaluate[Table[rhoOf[k]/(Pi (x 10^-3)^2), {k, Keys[rhoOf]}]], {x, 0.05, 2}, Frame -> True,
     FrameLabel -> {\"radius r (mm)\", \"R/l (\\[CapitalOmega]/m)\"}, PlotLegends -> Keys[rhoOf], ImageSize -> 420,
     Epilog -> {Red, PointSize[0.02], Point[{Log[r], Log[rho/a]}]}],
    results[{{\"R/l = \\[Rho]/A\", Row[{NumberForm[rho/a, 4], \" \\[CapitalOmega]/m\"}]}, {\"resistance R\", Row[{NumberForm[res, 4], \" \\[CapitalOmega]\"}]},
      {\"current I\", Row[{NumberForm[cur, 4], \" A\"}]}}]}, Spacings -> 1]],
 {{mat, \"Nichrome\", \"material\"}, Keys[rhoOf]},
 {{r, 0.32, \"radius r (mm)\"}, 0.05, 2, 0.01, Appearance -> \"Labeled\"},
 {{l, 1.0, \"length l (m)\"}, 0.1, 5, 0.1, Appearance -> \"Labeled\"},
 {{dv, 10., \"\\[CapitalDelta]V (V)\"}, 0, 20, 0.5, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {mat, r, l, dv}]", "Input"],

Cell["Book values and the What If", "Section"],

Cell["Grid[{{\"\", \"R/l (\\[CapitalOmega]/m)\", \"I for 10 V over 1.0 m (A)\"},
  {\"Nichrome\", rhoOf[\"Nichrome\"]/(Pi 0.32*^-3^2), 10/(rhoOf[\"Nichrome\"]/(Pi 0.32*^-3^2))},
  {\"copper\", rhoOf[\"copper\"]/(Pi 0.32*^-3^2), 10/(rhoOf[\"copper\"]/(Pi 0.32*^-3^2))}}, Frame -> All, FrameStyle -> GrayLevel[0.8]]", "Input"],

Cell["Check the numbers - the wire as a resistor network", "Section"],

Cell["(* 24 slices x 6 strands with cross links; node voltages from Kirchhoff's junction rule, then R = Delta V / I. *)
With[{rho = 1.00*^-6, r = 0.32*^-3, l = 1.0, dv = 10., nS = 24, mS = 6},
 Module[{a = Pi r^2, gl, gt, idx, eqs, vars, sol, cur},
  gl = (a/mS)/(rho l/nS); gt = gl/2;
  vars = Flatten[Table[v[i, j], {i, 1, nS - 1}, {j, 0, mS - 1}]];
  vv[0, j_] := dv; vv[nS, j_] := 0; vv[i_, j_] := v[i, Mod[j, mS]];
  eqs = Flatten[Table[gl (vv[i - 1, j] - v[i, j]) + gl (vv[i + 1, j] - v[i, j]) + gt (vv[i, j - 1] - v[i, j]) + gt (vv[i, j + 1] - v[i, j]) == 0,
     {i, 1, nS - 1}, {j, 0, mS - 1}]];
  sol = Solve[eqs, vars][[1]];
  cur = Total[Table[gl (dv - v[1, j]), {j, 0, mS - 1}] /. sol];
  Grid[{{\"R from the network (\\[CapitalOmega])\", dv/cur}, {\"\\[Rho]l/A (\\[CapitalOmega])\", rho l/a}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
