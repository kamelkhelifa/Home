(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 26.1 - Drift Speed in a Copper Wire", "Title"],

Cell["PHYS 193 \:00b7 Week 6 \:00b7 Chapter 26 \:00b7 Lecture slide 14 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["The 12-gauge copper wire in a typical residential building has a cross-sectional area of 3.31 x 10^-6 m^2. It carries a constant current of 10.0 A. What is the drift speed of the electrons in the wire? Assume each copper atom contributes one free electron to the current. The density of copper is 8.92 g/cm^3.", "Text"],

Cell["n = N_A rho/M = 8.46 x 10^28 m^-3 and v_d = I/(n q A) = I M/(q A N_A rho) = 2.23 x 10^-4 m/s: about 75 min to drift 1 m. The light still comes on at once because the field, not the electrons, travels along the wire at nearly the speed of light.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 26.3: (a) the random motion of two charge carriers in a conductor in the absence of an electric field; the drift velocity is zero. (b) In an electric field the random motion is modified and the carriers have a drift velocity opposite the field (negative carriers). Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the laws of current and resistance (drift speed, resistivity, Ohm's law and electrical power); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
nA = 6.02*^23; q = 1.60*^-19; me = 9.11*^-31;
(* density (kg/m^3), molar mass (kg/mol), free electrons per atom, resistivity (ohm m, Table 26.2) *)
metal[\"copper\"] = {8920., 0.0635, 1, 1.7*^-8};
metal[\"aluminum\"] = {2700., 0.02698, 3, 2.82*^-8};
metal[\"silver\"] = {10500., 0.10787, 1, 1.59*^-8};
(* American wire gauge: diameter 0.127 mm x 92^((36 - g)/39); the book's value for 12 gauge *)
awgArea[g_] := If[g == 12, 3.31*^-6, Pi/4 (0.127*^-3 92^((36 - g)/39))^2];
density[m_] := With[{d = metal[m]}, d[[3]] nA d[[1]]/d[[2]]];
vDrift[i_, g_, m_] := i/(density[m] q awgArea[g]);", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{n = density[m], a = awgArea[g], vd},
  vd = i/(n q a);
  Column[{
    Plot[Evaluate[Table[1000 vDrift[x, gg, m], {gg, {10, 12, 14, 18, 22}}]], {x, 0, 30}, Frame -> True,
     FrameLabel -> {\"current I (A)\", \"drift speed (mm/s)\"}, PlotLegends -> (Row[{\"gauge \", #}] & /@ {10, 12, 14, 18, 22}),
     PlotRange -> {0, Automatic}, ImageSize -> 420, Epilog -> {Red, PointSize[0.02], Point[{i, 1000 vd}]}],
    results[{
      {\"cross-section A\", Row[{ScientificForm[a, 3], \" m\\.b2\"}]},
      {\"electron density n\", Row[{ScientificForm[n, 4], \" m\\:207b\\.b3\"}]},
      {\"drift speed v_d = I/(n q A)\", Row[{ScientificForm[vd, 4], \" m/s\"}]},
      {\"time to drift 1 m\", Row[{NumberForm[1/vd/60, 4], \" min\"}]}}]}, Spacings -> 1]],
 {{i, 10., \"current I (A)\"}, 0.5, 30, 0.5, Appearance -> \"Labeled\"},
 {{g, 12, \"wire gauge\"}, 8, 24, 1, Appearance -> \"Labeled\"},
 {{m, \"copper\", \"metal\"}, {\"copper\", \"aluminum\", \"silver\"}},
 ControlPlacement -> Left, TrackedSymbols :> {i, g, m}]", "Input"],

Cell["Book values", "Section"],

Cell["(* V = M/rho for one mole, n = N_A/V, then v_d *)
With[{rho = 8920., mm = 0.0635, i = 10.0, a = 3.31*^-6},
 Grid[{{\"volume of 1 mol (cm\\.b3)\", 10^6 mm/rho}, {\"n (m\\:207b\\.b3)\", nA rho/mm}, {\"v_d (m/s)\", i mm/(q a nA rho)},
   {\"time to drift 1 m (min)\", (q a nA rho)/(i mm)/60}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"],

Cell["Check the numbers - the model of conduction", "Section"],

Cell["(* Electrons accelerated by E = rho_e I/A between collisions; free times exponential with mean tau = m_e/(n q^2 rho_e).
   Mean velocity = Sum[a T^2/2]/Sum[T], compared with I/(n q A). *)
With[{m = \"copper\", i = 10., g = 12},
 Module[{d = metal[m], n = density[m], a = awgArea[g], tau, e, acc, ts},
  tau = me/(n q^2 d[[4]]); e = d[[4]] i/a; acc = q e/me;
  SeedRandom[1]; ts = RandomVariate[ExponentialDistribution[1/tau], 400000];
  Grid[{{\"field E (V/m)\", e}, {\"tau (s)\", tau}, {\"v_d Monte Carlo (m/s)\", Total[acc ts^2/2]/Total[ts]}, {\"v_d = I/(n q A) (m/s)\", i/(n q a)}},
   Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
