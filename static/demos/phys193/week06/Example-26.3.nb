(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 26.3 - The Radial Resistance of a Coaxial Cable", "Title"],

Cell["PHYS 193 \:00b7 Week 6 \:00b7 Chapter 26 \:00b7 Lecture slide 37 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A coaxial cable consists of two concentric cylindrical conductors; the region between them is completely filled with polyethylene plastic (Figure 26.8a). Current leakage through the plastic, in the radial direction, is unwanted. The radius of the inner conductor is a = 0.500 cm, the radius of the outer conductor is b = 1.75 cm, and the length is L = 15.0 cm. The resistivity of the plastic is 1.0 x 10^13 ohm m. Calculate the radial resistance of the plastic between the two conductors.", "Text"],

Cell["A shell of thickness dr has dR = rho dr/(2 pi r L); integrating from a to b gives R = (rho/(2 pi L)) ln(b/a) = 1.33 x 10^13 ohm, 18 orders of magnitude more than the copper core (3.2 x 10^-5 ohm). What if the cable is made twice as wide? With b/a fixed R does not change; with b - a fixed R decreases and the leakage grows.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 26.8: a coaxial cable. (a) Polyethylene plastic fills the gap between the two conductors. (b) End view, showing current leakage through the plastic in the radial direction; dr is the thickness of a thin cylindrical shell of plastic at radius r. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the laws of current and resistance (drift speed, resistivity, Ohm's law and electrical power); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
rCoax[rho_, a_, b_, l_] := rho/(2 Pi l) Log[b/a];
(* the same resistance as a sum of n thin shells in series, each with the area at its mid-radius *)
rShells[rho_, a_, b_, l_, n_] := With[{dr = (b - a)/n}, Sum[rho dr/(2 Pi (a + (k - 1/2) dr) l), {k, 1, n}]];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{aa = a/100, bb = Max[b, a + 0.1]/100, ll = l/100, res, dr},
  res = rCoax[rho, aa, bb, ll]; dr = (bb - aa)/n;
  Column[{
    Graphics[{{GrayLevel[0.75], Disk[{0, 0}, 1.15 bb]}, {Lighter[Darker[Green], 0.6], Disk[{0, 0}, bb]},
      {GrayLevel[0.55], Disk[{0, 0}, aa]}, {Dashed, Gray, Table[Circle[{0, 0}, aa + k dr], {k, 1, n - 1}]},
      {Purple, Arrowheads[0.03], Table[Arrow[{1.05 aa {Cos[t], Sin[t]}, 0.95 bb {Cos[t], Sin[t]}}], {t, Pi/8, 2 Pi, Pi/4}]}},
     PlotRange -> 0.06, ImageSize -> 300],
    Plot[rho/(2 Pi r ll)/100, {r, aa 100, bb 100}, Filling -> Axis, Frame -> True, PlotRange -> {{0, 5}, {0, Automatic}},
     FrameLabel -> {\"r (cm)\", \"dR/dr (\\[CapitalOmega] per cm)\"}, ImageSize -> 420],
    results[{{\"radial resistance R\", Row[{ScientificForm[res, 4], \" \\[CapitalOmega]\"}]}, {\"ln(b/a)\", NumberForm[Log[bb/aa], 4]},
      {\"leakage current at \" <> ToString[v] <> \" V\", Row[{ScientificForm[v/res, 3], \" A\"}]},
      {\"copper core, same length\", Row[{ScientificForm[1.7*^-8 ll/(Pi aa^2), 3], \" \\[CapitalOmega]\"}]}}]}, Spacings -> 1]],
 {{a, 0.5, \"inner radius a (cm)\"}, 0.1, 3, 0.05, Appearance -> \"Labeled\"},
 {{b, 1.75, \"outer radius b (cm)\"}, 0.2, 5, 0.05, Appearance -> \"Labeled\"},
 {{l, 15., \"length L (cm)\"}, 1, 100, 0.5, Appearance -> \"Labeled\"},
 {{rho, 1.*^13, \"resistivity (\\[CapitalOmega] m)\"}, {1.*^11, 1.*^12, 1.*^13, 1.*^14, 1.*^15}},
 {{n, 6, \"shells drawn\"}, 2, 40, 1, Appearance -> \"Labeled\"},
 {{v, 120, \"voltage between conductors (V)\"}, 0, 1000, 10, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {a, b, l, rho, n, v}]", "Input"],

Cell["What if? Twice the overall diameter", "Section"],

Cell["Grid[{{\"\", \"a (cm)\", \"b (cm)\", \"R (\\[CapitalOmega])\"},
  {\"book\", 0.5, 1.75, rCoax[1.*^13, 0.005, 0.0175, 0.15]},
  {\"(1) b/a fixed\", 1.0, 3.5, rCoax[1.*^13, 0.010, 0.035, 0.15]},
  {\"(2) b - a fixed\", 2.25, 3.5, rCoax[1.*^13, 0.0225, 0.035, 0.15]}}, Frame -> All, FrameStyle -> GrayLevel[0.8]]", "Input"],

Cell["Check the numbers", "Section"],

Cell["With[{rho = 1.*^13, a = 0.005, b = 0.0175, l = 0.15},
 Grid[{{\"(\\[Rho]/2\\[Pi]L) ln(b/a)\", rCoax[rho, a, b, l]}, {\"NIntegrate\", NIntegrate[rho/(2 Pi r l), {r, a, b}]},
   {\"10 shells\", rShells[rho, a, b, l, 10]}, {\"100 shells\", rShells[rho, a, b, l, 100]}, {\"1000 shells\", rShells[rho, a, b, l, 1000]},
   {\"copper core (\\[CapitalOmega])\", 1.7*^-8 l/(Pi a^2)}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
