(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 27.1 - Terminal Voltage of a Battery", "Title"],

Cell["PHYS 193 \:00b7 Week 7 \:00b7 Chapter 27 \:00b7 Lecture slide 14 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A battery has an emf of 12.0 V and an internal resistance of 0.050 0 \:03a9. Its terminals are connected to a load resistance of 3.00 \:03a9. (A) Find the current in the circuit and the terminal voltage of the battery. (B) Calculate the power delivered to the load resistor, the power delivered to the internal resistance of the battery, and the power delivered by the battery.", "Text"],

Cell["The battery is modelled as an ideal emf \:03b5 in series with its internal resistance r. Walking once around the loop gives \:03b5 \:2212 I r \:2212 I R = 0, so I = \:03b5/(R + r), and the terminal voltage is \:0394V = \:03b5 \:2212 I r. The What If? cell ages the battery (r = 2.00 \:03a9).", "Text"],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the circuit laws (Ohm\:2019s law, Kirchhoff\:2019s rules, energy conservation); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
current[e_, r_, R_] := e/(R + r);                 (* loop rule: e - I r - I R = 0 *)
termV[e_, r_, R_] := e - current[e, r, R] r;      (* terminal voltage V_b - V_a *)", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{r = 10.^lr, R = 10.^lR, cur, dv, pR, pr, pB, circ, pot},
  cur = current[e, r, R]; dv = termV[e, r, R];
  pR = cur^2 R; pr = cur^2 r; pB = e cur;
  circ = Graphics[{
     {GrayLevel[0.6], Dashed, Line[{{-0.45, 0.2}, {0.45, 0.2}, {0.45, 2.8}, {-0.45, 2.8}, {-0.45, 0.2}}]},
     lbl[\"battery\", {-0.95, 2.65}, Gray],
     batteryG[{0, 0}, {0, 1.4}, True], wire[{{0, 1.4}, {0, 1.6}}], resistorG[{0, 1.6}, {0, 3}, maroon, 0.6, 0.1],
     lbl[Row[{\"\\[CurlyEpsilon] = \", NumberForm[e, {3, 1}], \" V\"}], {-1.15, 0.75}],
     lbl[Row[{\"r = \", NumberForm[r, 3], \" \:03a9\"}], {-1.15, 2.3}],
     wire[{{0, 3}, {3, 3}, {3, 2.0}}], resistorG[{3, 2.0}, {3, 1.0}], wire[{{3, 1.0}, {3, 0}, {0, 0}}],
     lbl[Row[{\"R = \", NumberForm[R, 3], \" \:03a9\"}], {3.85, 1.5}],
     nodeG[{0, 0}, \"a\", {-0.22, -0.15}], nodeG[{0, 3}, \"b\", {-0.22, 0.15}], nodeG[{3, 3}, \"c\", {0.22, 0.15}], nodeG[{3, 0}, \"d\", {0.22, -0.15}],
     currentG[{0.6, 3}, {2.4, 3}, cur, Row[{\"I = \", NumberForm[cur, 3], \" A\"}], 0.22],
     lbl[Row[{\"\:0394V = V_b \:2212 V_a = \", NumberForm[dv, 4], \" V\"}], {1.5, 1.5}, Bold, blue]},
    PlotRange -> {{-1.8, 4.7}, {-0.5, 3.7}}, AspectRatio -> Automatic, ImageSize -> 460];
  (* potential at each point, walking clockwise from a (V_a = 0) *)
  pot = ListLinePlot[{{0, 0}, {1, e}, {2, dv}, {3, dv}, {4, dv - cur R}, {5, 0}},
    PlotStyle -> Directive[maroon, Thick], Mesh -> All, Frame -> True,
    FrameTicks -> {{Automatic, None}, {{{0, \"a\"}, {1, \"after \:03b5\"}, {2, \"b\"}, {3, \"c\"}, {4, \"d\"}, {5, \"a\"}}, None}},
    FrameLabel -> {\"walking around the loop, starting at a\", \"V (V)\"}, PlotRange -> {Automatic, {-0.05 e, 1.12 e}},
    GridLines -> {None, {dv, e}}, GridLinesStyle -> Directive[blue, Dashed], ImageSize -> 460];
  Column[{circ, pot,
    BarChart[{pR, pr}, BarOrigin -> Left, ChartLabels -> {\"load R\", \"inside the battery r\"}, ChartStyle -> {maroon, gold},
     LabelingFunction -> After, PlotLabel -> \"power (W)\", ImageSize -> 460],
    results[{
      {\"current I = \:03b5/(R + r)\", Row[{NumberForm[cur, 4], \" A\"}]},
      {\"terminal voltage \:0394V = \:03b5 \:2212 I r\", Row[{NumberForm[dv, 4], \" V\"}]},
      {\"power to the load, I\:00b2R\", Row[{NumberForm[pR, 4], \" W\"}]},
      {\"power to the internal resistance, I\:00b2r\", Row[{NumberForm[pr, 4], \" W\"}]},
      {\"power delivered by the battery, I \:03b5\", Row[{NumberForm[pB, 4], \" W\"}]}}]}, Spacings -> 1.2]],
 {{e, 12.0, \"emf \:03b5 (V)\"}, 1, 24, 0.1, Appearance -> \"Labeled\"},
 {{lr, Log10[0.05], \"log\:2081\:2080(r / \:03a9)\"}, -3, 1, Appearance -> \"Labeled\"},
 {{lR, Log10[3.], \"log\:2081\:2080(R / \:03a9)\"}, -2, 3, Appearance -> \"Labeled\"},
 Delimiter,
 Row[{Button[\"New battery: r = 0.0500 \:03a9\", e = 12.; lr = Log10[0.05]; lR = Log10[3.]],
   Button[\"Aged battery: r = 2.00 \:03a9\", e = 12.; lr = Log10[2.]; lR = Log10[3.]]}],
 ControlPlacement -> Left, TrackedSymbols :> {e, lr, lR}]", "Input"],

Cell["What if? The battery ages - r = 2.00 \:03a9", "Section"],

Cell["(* The emf stays 12.0 V while the internal resistance grows: more of the emf is used up inside the battery and less power reaches the load. *)
Column[{
  With[{e = 12.0, R = 3.00},
   Grid[Prepend[
     Table[With[{cur = current[e, r, R]}, {r, NumberForm[cur, 4], NumberForm[termV[e, r, R], 4], NumberForm[cur^2 R, 4], NumberForm[cur^2 r, 4], NumberForm[e cur, 4]}], {r, {0.0500, 2.00}}],
     {\"r (\:03a9)\", \"I (A)\", \"\:0394V (V)\", \"P to R (W)\", \"P to r (W)\", \"P from battery (W)\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]]],
  Plot[{current[12., r, 3.]^2 3., current[12., r, 3.]^2 r}, {r, 0, 5},
   PlotStyle -> {Directive[maroon, Thick], Directive[gold, Thick]},
   PlotLegends -> Placed[{\"power to the load\", \"power lost inside the battery\"}, {Right, Top}],
   Frame -> True, FrameLabel -> {\"internal resistance r (\:03a9)\", \"power (W)\"}, GridLines -> {{0.05, 2.}, None}, ImageSize -> 460]}, Spacings -> 1.2]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Book values: e = 12.0 V, r = 0.0500 \:03a9, R = 3.00 \:03a9. Exact current: 12/(3 + 1/20) = 240/61 A. *)
With[{e = 12.0, r = 0.0500, R = 3.00},
 With[{cur = current[e, r, R]},
  Grid[{{\"check\", \"value\", \"should be\"},
    {\"loop rule: \:03b5 \:2212 I r \:2212 I R (V)\", Chop[e - cur r - cur R], 0},
    {\"terminal voltage two ways: \:03b5 \:2212 I r and I R (V)\", Row[{termV[e, r, R], \"   \", cur R}], \"equal\"},
    {\"energy: I \:03b5 \:2212 (I\:00b2R + I\:00b2r) (W)\", Chop[e cur - (cur^2 R + cur^2 r)], 0},
    {\"I, exact (A)\", 12/(3 + 1/20), N[12/(3 + 1/20), 6]}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
