(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 32.5 - Average Power in an RLC Series Circuit", "Title"],

Cell["PHYS 193 \:00b7 Week 13 \:00b7 Chapter 32 \:00b7 Lecture slide 69 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["Calculate the average power delivered to the series RLC circuit of Example 32.4: R = 425 ohm, L = 1.25 H, C = 3.50 microfarad, driven at 60.0 Hz with Delta V_max = 150 V.", "Text"],

Cell["Delta V_rms = 150/Sqrt[2] = 106 V, I_rms = 0.292/Sqrt[2] = 0.206 A, and P_avg = I_rms Delta V_rms Cos[phi] = (0.206)(106) Cos[-34.0 degrees] = 18.1 W, the same as I_rms^2 R. Only the resistor dissipates: the inductor and the capacitor return every joule they take.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 32.13a: the series RLC circuit of Example 32.4, connected to the same AC source. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the AC circuit laws (reactance, impedance, phasors and average power); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
rlc[r_, l_, c_, f_, vm_] := Module[{w = 2 Pi f, xl, xc, z, im, phi},
  xl = w l; xc = 1/(w c); z = Sqrt[r^2 + (xl - xc)^2]; im = vm/z; phi = ArcTan[r, xl - xc];
  <|\"w\" -> w, \"XL\" -> xl, \"XC\" -> xc, \"Z\" -> z, \"Imax\" -> im, \"phi\" -> phi, \"Vrms\" -> vm/Sqrt[2], \"Irms\" -> im/Sqrt[2], \"P\" -> im vm Cos[phi]/2, \"f0\" -> 1/(2 Pi Sqrt[l c])|>];
pAvg[r_, l_, c_, f_, vm_] := rlc[r, l, c, f, vm][\"P\"];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{s = rlc[r, l, c 10.^-6, f, vm], th = deg Degree, aI, phs, fmax},
  aI = th - s[\"phi\"];
  (* only the component of Delta V_max along the current, Delta V_max Cos[phi] = Delta V_R, delivers power *)
  phs = Graphics[{{GrayLevel[0.8], Dashed, Line[{-1.3 {Cos[aI], Sin[aI]}, 1.3 {Cos[aI], Sin[aI]}}]}, {GrayLevel[0.6], Dashed, Line[{{Cos[th], Sin[th]}, Cos[s[\"phi\"]] {Cos[aI], Sin[aI]}}]},
     {RGBColor[0.54, 0.08, 0.22], AbsoluteThickness[3.5], Arrowheads[0.07], Arrow[{{0, 0}, {Cos[th], Sin[th]}}]}, {maroon, AbsoluteThickness[3], Arrowheads[0.06], Arrow[{{0, 0}, Cos[s[\"phi\"]] {Cos[aI], Sin[aI]}}]},
     Text[Style[\"\\[CapitalDelta]V_max\", 10, Bold, RGBColor[0.54, 0.08, 0.22]], 1.2 {Cos[th], Sin[th]}], Text[Style[\"\\[CapitalDelta]V_R = \\[CapitalDelta]V_max cos \\[CurlyPhi]\", 10, Bold, maroon], (Cos[s[\"phi\"]] + 0.3) {Cos[aI], Sin[aI]}],
     Text[Style[\"current direction\", 10, RGBColor[0.48, 0.25, 0.69]], 1.45 {Cos[aI], Sin[aI]}],
     Text[Style[Row[{\"\\[CurlyPhi] = \", NumberForm[s[\"phi\"]/Degree, 4], \"\\[Degree],  cos \\[CurlyPhi] = \", NumberForm[Cos[s[\"phi\"]], 4]}], 11, Bold, gold], {0, -1.5}]},
    PlotRange -> {{-1.7, 1.7}, {-1.7, 1.6}}, ImageSize -> 320];
  fmax = Max[400, 2.5 s[\"f0\"], 1.5 f];
  Column[{
    Plot[{Sin[t Degree], Sin[t Degree - s[\"phi\"]]}, {t, 0, 720}, PlotStyle -> {Directive[RGBColor[0.54, 0.08, 0.22], Thick], Directive[RGBColor[0.48, 0.25, 0.69], Thick]},
     Frame -> True, FrameLabel -> {\"\\[Omega]t (\\[Degree])\", \"fraction of max\"}, PlotRange -> {-1.2, 1.2}, GridLines -> {{deg}, None}, GridLinesStyle -> Directive[gold, Dashed], PlotLegends -> {\"\\[CapitalDelta]v\", \"i\"}, ImageSize -> 460],
    (* instantaneous power p = Delta v i, negative where energy flows back into the source, and its running average (closed form of the integral) *)
    Plot[{vm Sin[t Degree] s[\"Imax\"] Sin[t Degree - s[\"phi\"]], If[t > 1, vm s[\"Imax\"] (Cos[s[\"phi\"]]/2 - (Sin[2 t Degree - s[\"phi\"]] + Sin[s[\"phi\"]])/(4 t Degree)), 0], s[\"P\"]}, {t, 0, 720},
     PlotStyle -> {Directive[green, Thick], Directive[blue, Thick], Directive[gold, Dashed]}, Filling -> {1 -> Axis}, Frame -> True, FrameLabel -> {\"\\[Omega]t (\\[Degree])\", \"p = \\[CapitalDelta]v i (W)\"},
     PlotRange -> {-0.6 vm s[\"Imax\"], 1.5 vm s[\"Imax\"]}, GridLines -> {{deg}, None}, GridLinesStyle -> Directive[gold, Dashed], PlotLegends -> {\"p(t)\", \"running average\", \"P_avg\"}, ImageSize -> 460],
    Row[{phs,
      Plot[pAvg[r, l, c 10.^-6, ff, vm], {ff, 0.5, fmax}, PlotStyle -> Directive[green, Thick], Frame -> True, FrameLabel -> {\"f (Hz)\", \"P_avg (W)\"}, PlotRange -> {0, 1.2 vm^2/(2 r)},
       GridLines -> {{s[\"f0\"], f}, {vm^2/(2 r)}}, GridLinesStyle -> Directive[gold, Dashed], Epilog -> {green, PointSize[0.02], Point[{f, s[\"P\"]}], Text[Style[Row[{\"f0 = \", NumberForm[s[\"f0\"], 4], \" Hz\"}], 10, gold], {s[\"f0\"], 1.1 vm^2/(2 r)}, {-1.1, 0}]}, ImageSize -> 300]}],
    results[{
      {\"\\[CapitalDelta]V_rms, I_rms\", Row[{NumberForm[s[\"Vrms\"], 4], \" V,  \", NumberForm[s[\"Irms\"], 4], \" A\"}]},
      {\"\\[CurlyPhi], power factor cos \\[CurlyPhi]\", Row[{NumberForm[s[\"phi\"]/Degree, 4], \"\\[Degree],  \", NumberForm[Cos[s[\"phi\"]], 4]}]},
      {\"P_avg = I_rms \\[CapitalDelta]V_rms cos \\[CurlyPhi]\", Row[{NumberForm[s[\"P\"], 4], \" W\"}]},
      {\"P_avg = I_rms\\.b2 R\", Row[{NumberForm[s[\"Irms\"]^2 r, 4], \" W\"}]},
      {\"resonance frequency f_0 = 1/(2\\[Pi] Sqrt[LC])\", Row[{NumberForm[s[\"f0\"], 4], \" Hz\"}]}}]}, Spacings -> 1]],
 {{r, 425., \"R (\\[CapitalOmega])\"}, 20, 1000, 5, Appearance -> \"Labeled\"},
 {{l, 1.25, \"L (H)\"}, 0.05, 3, 0.01, Appearance -> \"Labeled\"},
 {{c, 3.5, \"C (\\[Mu]F)\"}, 0.5, 20, 0.05, Appearance -> \"Labeled\"},
 {{vm, 150., \"\\[CapitalDelta]V_max (V)\"}, 10, 300, 5, Appearance -> \"Labeled\"},
 {{f, 60., \"frequency f (Hz)\"}, 10, 400, 1, Appearance -> \"Labeled\"},
 {{deg, 400, \"phase \\[Omega]t (\\[Degree])\"}, 0, 720, 2, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {r, l, c, vm, f, deg}]", "Input"],

Cell["Going further - why L and C dissipate nothing", "Section"],

Cell["(* The average of sin(wt) cos(wt) over a cycle vanishes: an element whose current is 90 degrees out of phase with its voltage stores and returns energy but never keeps any. *)
{Integrate[Sin[t] Cos[t], {t, 0, 2 Pi}]/(2 Pi), Integrate[Sin[t] Sin[t - phi], {t, 0, 2 Pi}]/(2 Pi) // Simplify}", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Book values: <Delta v i> over a cycle by numerical integration against I_rms Delta V_rms Cos[phi] and I_rms^2 R; the average powers into L and C alone, which must vanish. *)
With[{r = 425., l = 1.25, c = 3.5*^-6, f = 60., vm = 150.},
 Module[{s = rlc[r, l, c, f, vm], w, per, i, pS, pR, pL, pC},
  w = s[\"w\"]; per = 2 Pi/w; i[t_] := s[\"Imax\"] Sin[w t - s[\"phi\"]];
  pS = NIntegrate[vm Sin[w t] i[t], {t, 0, per}]/per; pR = NIntegrate[r i[t]^2, {t, 0, per}]/per;
  pL = NIntegrate[s[\"Imax\"] s[\"XL\"] Sin[w t - s[\"phi\"] + Pi/2] i[t], {t, 0, per}]/per; pC = NIntegrate[s[\"Imax\"] s[\"XC\"] Sin[w t - s[\"phi\"] - Pi/2] i[t], {t, 0, per}]/per;
  Grid[{{\"I_rms \\[CapitalDelta]V_rms cos \\[CurlyPhi] (W)\", s[\"P\"]}, {\"<\\[CapitalDelta]v i> numerical (W)\", pS}, {\"I_rms\\.b2 R (W)\", s[\"Irms\"]^2 r}, {\"<i\\.b2 R> numerical (W)\", pR},
    {\"<p> into L, into C (W)\", {Chop[pL, 10^-9], Chop[pC, 10^-9]}}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
