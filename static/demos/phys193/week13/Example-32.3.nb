(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 32.3 - A Purely Capacitive AC Circuit", "Title"],

Cell["PHYS 193 \:00b7 Week 13 \:00b7 Chapter 32 \:00b7 Lecture slide 45 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["An 8.00-microfarad capacitor is connected to the terminals of a 60.0-Hz AC source whose rms voltage is 150 V. Find the capacitive reactance and the rms current in the circuit.", "Text"],

Cell["X_C = 1/(omega C) = 1/(2 Pi f C) = 332 ohm and I_rms = Delta V_rms/X_C = 0.452 A. The current leads the voltage by 90 degrees. What if? Doubling the frequency halves the reactance and doubles the current, to 0.904 A.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 32.9: a circuit consisting of a capacitor of capacitance C connected to an AC source. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the AC circuit laws (reactance, impedance, phasors and average power); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
react[f_, x_] := 1/(2 Pi f x);                                   (* reactance at frequency f *)
(* the current driven by Delta v = Vm sin(omega t): the capacitor law solved exactly *)
iOf[t_, vm_, w_, x_] := x vm w Cos[w t];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{x = xs 10.^-6, w = 2 Pi f, xr, irms, vm, im, th = deg Degree, fig, phs},
  xr = react[f, x]; irms = vrms/xr; vm = Sqrt[2] vrms; im = Sqrt[2] irms;
  fig = Graphics[{wire[{{-1.5, -1}, {-1.5, 1}, {-0.5, 1}}], capacitorG[{-0.5, 1}, {0.5, 1}], wire[{{0.5, 1}, {1.5, 1}, {1.5, -1}, {0.4, -1}}],
     acSourceG[{0, -1}], wire[{{-0.4, -1}, {-1.5, -1}}],
     Text[Style[Row[{\"C = \", NumberForm[xs, 3], \" \\[Mu]F\"}], 12], {0, 1.35}],
     Text[Style[Row[{\"\\[CapitalDelta]v = \", NumberForm[vm Sin[th], 3], \" V\"}], 11], {0, -1.4}],
     currentG[{-0.6, 0.6}, {0.6, 0.6}, iOf[th/w, vm, w, x], Row[{\"i = \", NumberForm[Abs[iOf[th/w, vm, w, x]], 3], \" A\"}], -0.12, 0.6]},
    PlotRange -> {{-1.9, 1.9}, {-1.7, 1.6}}, ImageSize -> 380];
  (* phasors: the voltage at angle omega t, the current leads by 90 degrees *)
  phs = Graphics[{{GrayLevel[0.8], Line[{{-1.2, 0}, {1.2, 0}}], Line[{{0, -1.2}, {0, 1.2}}]},
     {blue, AbsoluteThickness[2.5], Arrowheads[0.06], Arrow[{{0, 0}, {Cos[th], Sin[th]}}]}, Text[Style[\"\\[CapitalDelta]V_max\", 11, Bold, blue], 1.22 {Cos[th], Sin[th]}],
     {RGBColor[0.48, 0.25, 0.69], AbsoluteThickness[2.5], Arrowheads[0.06], Arrow[{{0, 0}, 0.8 {Cos[th + Pi/2], Sin[th + Pi/2]}}]},
     Text[Style[\"I_max\", 11, Bold, RGBColor[0.48, 0.25, 0.69]], 1.02 {Cos[th + Pi/2], Sin[th + Pi/2]}],
     Text[Style[\"current leads by 90\\[Degree]\", 11], {0, -1.4}]}, PlotRange -> {{-1.5, 1.5}, {-1.6, 1.5}}, ImageSize -> 260];
  Column[{Row[{fig, phs}],
    Plot[{Sin[t Degree], iOf[t Degree/w, vm, w, x]/im}, {t, 0, 720}, PlotStyle -> {Directive[blue, Thick], Directive[RGBColor[0.48, 0.25, 0.69], Thick]},
     Frame -> True, FrameLabel -> {\"\\[Omega]t (\\[Degree])\", \"fraction of max\"}, PlotRange -> {-1.2, 1.2}, GridLines -> {{deg}, None}, GridLinesStyle -> Directive[gold, Dashed],
     PlotLegends -> {\"\\[CapitalDelta]v/\\[CapitalDelta]V_max\", \"i/I_max\"}, ImageSize -> 440],
    Plot[react[ff, x], {ff, 1, Max[200, 2.5 f]}, PlotStyle -> Directive[maroon, Thick], Frame -> True, FrameLabel -> {\"f (Hz)\", \"X_C (\\[CapitalOmega])\"},
     PlotRange -> {0, All}, GridLines -> {{f}, {xr}}, GridLinesStyle -> Directive[gold, Dashed], Epilog -> {maroon, PointSize[0.02], Point[{f, xr}]}, ImageSize -> 440],
    results[{
      {\"X_C = 1/(\\[Omega]C) = 1/(2\\[Pi]fC)\", Row[{NumberForm[xr, 4], \" \\[CapitalOmega]\"}]},
      {\"I_rms = \\[CapitalDelta]V_rms/X_C\", Row[{NumberForm[irms, 4], \" A  (I_max = \", NumberForm[im, 4], \" A)\"}]},
      {\"phase\", \"current leads the voltage by 90\\[Degree]\"},
      {\"average power\", \"0 - energy goes in and out, none is dissipated\"}}]}, Spacings -> 1]],
 {{xs, 8., \"C (\\[Mu]F)\"}, 0.5, 50, 0.25, Appearance -> \"Labeled\"},
 {{vrms, 150., \"\\[CapitalDelta]V_rms (V)\"}, 10, 300, 5, Appearance -> \"Labeled\"},
 {{f, 60., \"frequency f (Hz)\"}, 10, 6000, 10, Appearance -> \"Labeled\"},
 {{deg, 70, \"phase \\[Omega]t (\\[Degree])\"}, 0, 720, 2, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {xs, vrms, f, deg}]", "Input"],

Cell["What if? - doubling the frequency", "Section"],

Cell["(* Twice the frequency gives half the reactance and twice the current: {f, X_C, I_rms}. *)
With[{x = 8. 10.^-6, vrms = 150.}, Table[{f, react[f, x], vrms/react[f, x]}, {f, {60., 120.}}]] // TableForm", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Book values: the rms of the current obtained from the element's own law, by numerical integration over one cycle, against Delta V_rms/X; and the average of Delta v i over a cycle, which must vanish. *)
With[{x = 8. 10.^-6, vrms = 150., f = 60.},
 Module[{w = 2 Pi 60., vm = Sqrt[2] 150., per, irmsNum, pavg},
  per = 2 Pi/w;
  irmsNum = Sqrt[NIntegrate[iOf[t, vm, w, x]^2, {t, 0, per}]/per];
  pavg = NIntegrate[vm Sin[w t] iOf[t, vm, w, x], {t, 0, per}]/per;
  Grid[{{\"X_C (\\[CapitalOmega])\", react[f, x]}, {\"I_rms = \\[CapitalDelta]V_rms/X_C (A)\", vrms/react[f, x]}, {\"I_rms from the element law (A)\", irmsNum}, {\"<\\[CapitalDelta]v i> over a cycle (W)\", Chop[pavg, 10^-9]}},
   Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
