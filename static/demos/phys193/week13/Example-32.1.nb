(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 32.1 - What Is the rms Current?", "Title"],

Cell["PHYS 193 \:00b7 Week 13 \:00b7 Chapter 32 \:00b7 Lecture slide 21 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["The voltage output of an AC source is given by Delta v = 200 sin(omega t) (volts). Find the rms current in the circuit when this source is connected to a 47.0-ohm resistor.", "Text"],

Cell["I_rms = I_max/Sqrt[2] = Delta V_max/(Sqrt[2] R) = 3.01 A. The factor 1/Sqrt[2] belongs to the sine wave: the average of sin^2 over a cycle is exactly 1/2; a square wave gives I_rms = I_max and a triangle wave I_max/Sqrt[3].", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 32.2: a circuit consisting of a resistor of resistance R connected to an AC source, designated by the symbol of a sine wave in a circle. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the AC circuit laws (reactance, impedance, phasors and average power); the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
wave[\"sine\", th_] := Sin[th];
wave[\"square\", th_] := If[Mod[th, 2 Pi] < Pi, 1, -1];
wave[\"triangle\", th_] := With[{u = Mod[th, 2 Pi]/(2 Pi)}, Which[u < 1/4, 4 u, u < 3/4, 2 - 4 u, True, 4 u - 4]];
f2[\"sine\"] = 1/2; f2[\"square\"] = 1; f2[\"triangle\"] = 1/3;   (* average of the squared waveform over a cycle *)", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{im = vmax/r, irms, th = deg Degree, fig, i, v},
  irms = im Sqrt[f2[kind]]; i = im wave[kind, th]; v = vmax wave[kind, th];
  fig = Graphics[{wire[{{-1.5, -1}, {-1.5, 1}, {-0.5, 1}}], resistorG[{-0.5, 1}, {0.5, 1}], wire[{{0.5, 1}, {1.5, 1}, {1.5, -1}, {0.4, -1}}],
     acSourceG[{0, -1}], wire[{{-0.4, -1}, {-1.5, -1}}],
     Text[Style[Row[{\"R = \", NumberForm[r, 3], \" \\[CapitalOmega]\"}], 12], {0, 1.3}],
     Text[Style[Row[{\"\\[CapitalDelta]v = \", NumberForm[v, 3], \" V\"}], 11], {0, -1.4}],
     currentG[{-0.6, 0.6}, {0.6, 0.6}, i, Row[{\"i = \", NumberForm[Abs[i], 3], \" A\"}], -0.12, 0.6],
     Text[Style[Row[{\"\\[Omega]t = \", deg, \"\\[Degree]\"}], 10, Gray], {1.2, 1.45}]},
    PlotRange -> {{-1.9, 1.9}, {-1.7, 1.6}}, ImageSize -> 400];
  Column[{fig,
    Plot[im wave[kind, t Degree], {t, 0, 720}, PlotStyle -> Directive[RGBColor[0.48, 0.25, 0.69], Thick], Frame -> True, FrameLabel -> {\"\\[Omega]t (\\[Degree])\", \"i (A)\"},
     PlotRange -> {-1.3 im, 1.3 im}, GridLines -> {{deg}, {irms, -irms}}, GridLinesStyle -> Directive[gold, Dashed], PlotPoints -> 200, MaxRecursion -> 2, ImageSize -> 400,
     Epilog -> {RGBColor[0.48, 0.25, 0.69], PointSize[0.02], Point[{deg, i}], Text[Style[\"\\[PlusMinus]I_rms\", 10, gold], {660, irms + 0.12 im}]}],
    Plot[{(im wave[kind, t Degree])^2, f2[kind] im^2}, {t, 0, 720}, PlotStyle -> {Directive[green, Thick], Directive[gold, Dashed]}, Frame -> True, FrameLabel -> {\"\\[Omega]t (\\[Degree])\", \"i\\.b2 (A\\.b2)\"},
     PlotRange -> {0, 1.15 im^2}, Filling -> {1 -> Axis}, PlotPoints -> 200, MaxRecursion -> 2, ImageSize -> 400, PlotLegends -> {\"i\\.b2\", \"average = f I_max\\.b2\"}],
    results[{
      {\"I_max = \\[CapitalDelta]V_max/R\", Row[{NumberForm[im, 4], \" A\"}]},
      {\"I_rms\", Row[{NumberForm[irms, 4], \" A  (= I_max \\[Times] \", NumberForm[Sqrt[f2[kind]] // N, 4], \")\"}]},
      {\"average power I_rms\\.b2 R\", Row[{NumberForm[irms^2 r, 4], \" W\"}]}}]}, Spacings -> 1]],
 {{vmax, 200., \"\\[CapitalDelta]V_max (V)\"}, 10, 400, 5, Appearance -> \"Labeled\"},
 {{r, 47., \"resistance R (\\[CapitalOmega])\"}, 5, 200, 0.5, Appearance -> \"Labeled\"},
 {{kind, \"sine\", \"waveform\"}, {\"sine\", \"square\", \"triangle\"}},
 {{deg, 60, \"phase \\[Omega]t (\\[Degree])\"}, 0, 720, 2, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {vmax, r, kind, deg}]", "Input"],

Cell["Going further - why 1/Sqrt[2]?", "Section"],

Cell["(* The average of sin^2 over a cycle is exactly one half; a square wave averages to 1 and a triangle wave to 1/3. *)
{Integrate[Sin[t]^2, {t, 0, 2 Pi}]/(2 Pi), Integrate[wave[\"square\", t]^2, {t, 0, 2 Pi}]/(2 Pi), NIntegrate[wave[\"triangle\", t]^2, {t, 0, 2 Pi}]/(2 Pi)}", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Book values: <i^2> over one cycle by numerical integration against I_max^2/2, and the rms current and power two ways. *)
With[{vmax = 200., r = 47.},
 Module[{im = vmax/r, avg},
  avg = NIntegrate[(im Sin[t])^2, {t, 0, 2 Pi}]/(2 Pi);
  Grid[{{\"<i\\.b2> numerical (A\\.b2)\", avg}, {\"I_max\\.b2/2 (A\\.b2)\", im^2/2}, {\"I_rms = Sqrt[<i\\.b2>] (A)\", Sqrt[avg]}, {\"\\[CapitalDelta]V_max/(Sqrt[2] R) (A)\", vmax/(Sqrt[2] r)},
    {\"<i\\.b2 R> (W)\", avg r}, {\"I_rms\\.b2 R (W)\", vmax^2/(2 r)}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
