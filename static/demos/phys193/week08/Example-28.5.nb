(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 28.5 - Rotating a Coil", "Title"],

Cell["PHYS 193 \:00b7 Week 8 \:00b7 Chapter 28 \:00b7 Lecture slide 73 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A rectangular loop (mass 50.0 g, sides a = 0.200 m along the pivot and b = 0.100 m) hangs from side 4 and carries 3.50 A in a vertical field of 0.0100 T. What angle does its plane make with the vertical?", "Text"],

Cell["About side 4 the magnetic torque is I a b B cos(theta) (clockwise) and the gravitational torque is m g (b/2) sin(theta) (counterclockwise). Equilibrium: tan(theta) = 2 I a B/(m g) = 0.0286, theta = 1.64 degrees. (The publisher's slide swaps a and b and prints 0.82 degrees; the deck follows the printed textbook.)", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 28.25: (a) the rectangular loop of sides a and b with the current I. (b) Edge view sighting down sides \:2461 and \:2463: the loop hangs vertically from side \:2463, its magnetic moment \:03bc to the left. (c) In the vertical field B the loop rotates clockwise about side \:2463 to an angle \:03b8 from the vertical; the magnetic torque and the gravitational torque, with lever arm (b/2) sin \:03b8, balance. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the magnetic force on moving charges and currents, circular motion in a field, the torque on a current loop and the Hall effect; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
qe = 1.602 10.^-19; me = 9.109 10.^-31; mp = 1.673 10.^-27; cLight = 2.998 10.^8;
particleG[p_, sign_, r_ : 0.08] := {{If[sign < 0, blue, maroon], Disk[p, r]}, {ink, Circle[p, r]}, Text[Style[If[sign < 0, \"\\[Minus]\", \"+\"], White, Bold, 12], p]};
g = 9.80;
tauB[i_, a_, b_, bf_, th_] := i a b bf Cos[th];        (* magnetic torque about side 4 *)
tauG[m_, b_, th_] := m g b/2 Sin[th];                 (* gravitational torque about side 4 *)
thetaEq[i_, a_, bf_, m_] := ArcTan[2 i a bf/(m g)];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{m = mg/1000., th = thdeg Degree, eq, tb, tg, e, mid, fig},
  eq = thetaEq[i, a, bf, m]; tb = tauB[i, a, b, bf, th]; tg = tauG[m, b, th]; e = {Sin[th], -Cos[th]}; mid = e/2;
  fig = Graphics[{Table[{green, Opacity[0.4], Arrowheads[0.02], Arrow[{{x, -1.3}, {x, 0.3}}]}, {x, -0.9, 0.9, 0.3}], Text[Style[\"B\", Italic, Bold, 13, green], {0.95, 0.3}],
     {GrayLevel[0.7], Dashed, Line[{{0, 0}, {0, -1.1}}]}, {GrayLevel[0.6], AbsoluteThickness[7], Line[{{0, 0}, e}]},
     crossG[{0, 0}, 0.05, RGBColor[0.48, 0.25, 0.69]], dotG[e, 0.05, RGBColor[0.48, 0.25, 0.69]], Text[Style[\"4\", 11], {0.12, 0.02}], Text[Style[\"2\", 11], e + {0.12, 0}],
     {gold, Circle[{0, 0}, 0.3, {-Pi/2, -Pi/2 + th}]}, Text[Style[Row[{\"\\[Theta] = \", NumberForm[thdeg, 3], \"\\[Degree]\"}], 10, gold], 0.42 {Sin[th/2], -Cos[th/2]} + {0.14, 0}],
     {maroon, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{mid, mid - 0.3 {Cos[th], Sin[th]}}]}, Text[Style[\"\\[Mu]\", Italic, Bold, 13, maroon], mid - 0.4 {Cos[th], Sin[th]}],
     {blue, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{mid, mid + {0, -0.35}}]}, Text[Style[\"mg\", Italic, Bold, 12, blue], mid + {0.14, -0.35}],
     {GrayLevel[0.7], Dashed, Line[{{0, mid[[2]]}, mid}]}, Text[Style[\"b/2 sin \\[Theta]\", 9], {mid[[1]]/2, mid[[2]] - 0.08}],
     Text[Style[Row[{\"equilibrium at \", NumberForm[eq/Degree, 3], \"\\[Degree]\"}], 10], {0, -1.25}]},
    PlotRange -> {{-1.1, 1.1}, {-1.35, 0.4}}, AspectRatio -> Automatic, ImageSize -> 400];
  Column[{fig,
    Plot[{1000 tauB[i, a, b, bf, t Degree], 1000 tauG[m, b, t Degree]}, {t, 0, 60}, PlotStyle -> {Directive[maroon, Thick], Directive[blue, Thick]}, Frame -> True, FrameLabel -> {\"\\[Theta] (\\[Degree])\", \"torque (mN m)\"},
     PlotRange -> {0, All}, GridLines -> {{thdeg, eq/Degree}, None}, GridLinesStyle -> Directive[gold, Dashed], PlotLegends -> {\"magnetic I a b B cos \\[Theta]\", \"gravitational m g (b/2) sin \\[Theta]\"}, ImageSize -> 420],
    results[{
      {\"equilibrium \\[Theta] = ArcTan[2IaB/mg]\", Row[{NumberForm[eq/Degree, 4], \"\\[Degree]  (tan \\[Theta] = \", NumberForm[2 i a bf/(m g), 4], \")\"}]},
      {\"magnetic torque at the trial angle\", Row[{ScientificForm[tb, 3], \" N m\"}]},
      {\"gravitational torque at the trial angle\", Row[{ScientificForm[tg, 3], \" N m\"}]},
      {\"net\", Which[Abs[tg - tb] < 10^-3 Max[tb, tg], \"balanced\", tb > tg, \"magnetic wins: swings out further\", True, \"gravity wins: swings back\"]}}]}, Spacings -> 1]],
 {{i, 3.5, \"current I (A)\"}, 0.5, 50, 0.5, Appearance -> \"Labeled\"},
 {{bf, 0.01, \"field B (T)\"}, 0.001, 0.2, 0.001, Appearance -> \"Labeled\"},
 {{a, 0.2, \"side a along the pivot (m)\"}, 0.05, 0.5, 0.01, Appearance -> \"Labeled\"},
 {{b, 0.1, \"hanging side b (m)\"}, 0.05, 0.5, 0.01, Appearance -> \"Labeled\"},
 {{mg, 50., \"mass (g)\"}, 10, 200, 1, Appearance -> \"Labeled\"},
 {{thdeg, 10., \"trial angle \\[Theta] (\\[Degree])\"}, 0, 60, 0.1, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {i, bf, a, b, mg, thdeg}]", "Input"],

Cell["The equilibrium condition, symbolically", "Section"],

Cell["(* b cancels: the hanging side enters both torques in the same way. *)
Solve[tauB[I0, a0, b0, B0, t] == tauG[m0, b0, t] && 0 < t < Pi/2, t]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The book's substitution (a = 0.200 m) and the publisher's slide (a = 0.100 m); the root of the torque balance found numerically; the stability slope. *)
With[{i = 3.5, bf = 0.01, m = 0.05, b = 0.1},
 Module[{root = t /. FindRoot[tauB[i, 0.2, b, bf, t] == tauG[m, b, t], {t, 0.03}]},
  Grid[{{\"\\[Theta] with a = 0.200 m (\\[Degree])\", thetaEq[i, 0.2, bf, m]/Degree}, {\"root of \\[Tau]B = \\[Tau]g (\\[Degree])\", root/Degree}, {\"torques at the root (N m)\", {tauB[i, 0.2, b, bf, root], tauG[m, b, root]}},
    {\"d(\\[Tau]g - \\[Tau]B)/d\\[Theta] at the root (N m/rad)\", D[tauG[m, b, t] - tauB[i, 0.2, b, bf, t], t] /. t -> root}, {\"publisher's slide, a = 0.100 m (\\[Degree])\", thetaEq[i, 0.1, bf, m]/Degree}},
   Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
