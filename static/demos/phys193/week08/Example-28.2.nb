(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 28.2 - A Proton Moving Perpendicular to a Uniform Magnetic Field", "Title"],

Cell["PHYS 193 \:00b7 Week 8 \:00b7 Chapter 28 \:00b7 Lecture slide 34 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A proton moves in a circular orbit of radius 14 cm in a uniform 0.35-T field perpendicular to its velocity. Find its speed.", "Text"],

Cell["The magnetic force is the centripetal force, q v B = m v^2/r, so r = m v/q B (Eq. 28.3) and v = q B r/m_p = 4.7 x 10^6 m/s, well below c. What if? An electron at the same speed in the same field has a radius smaller by m_e/m_p: 0.076 mm instead of 14 cm.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 28.8: when the velocity of a charged particle is perpendicular to a uniform magnetic field (into the page), the particle moves in a circular path in a plane perpendicular to B; the magnetic force F_B always points toward the centre of the circle. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the magnetic force on moving charges and currents, circular motion in a field, the torque on a current loop and the Hall effect; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
qe = 1.602 10.^-19; me = 9.109 10.^-31; mp = 1.673 10.^-27; cLight = 2.998 10.^8;
particleG[p_, sign_, r_ : 0.08] := {{If[sign < 0, blue, maroon], Disk[p, r]}, {ink, Circle[p, r]}, Text[Style[If[sign < 0, \"\\[Minus]\", \"+\"], White, Bold, 12], p]};
vOrbit[q_, b_, r_, m_] := q b r/m;
periodT[q_, b_, m_] := 2 Pi m/(q b);", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{q, m, sign, r = rcm/100., v, T, ph = phdeg Degree, p, fig},
  {q, m, sign} = Switch[part, \"proton\", {qe, mp, 1}, \"electron\", {qe, me, -1}, \"alpha\", {2 qe, 4 1.6605 10.^-27, 1}];
  v = vOrbit[q, b, r, m]; T = periodT[q, b, m]; p = r {Cos[sign ph], Sin[sign ph]};
  fig = Graphics[{Table[crossG[{x, y}, 0.035 r, RGBColor[0.18, 0.49, 0.31, 0.5]], {x, -1.4 r, 1.4 r, 0.35 r}, {y, -1.4 r, 1.4 r, 0.35 r}],
     {Gray, Dashed, Circle[{0, 0}, r]}, {GrayLevel[0.7], Line[{{0, 0}, r {Cos[0.6], Sin[0.6]}}]}, Text[Style[\"r\", Italic, 12], 0.55 r {Cos[0.6], Sin[0.6]} + {0.08 r, 0.06 r}], {Black, PointSize[0.012], Point[{0, 0}]},
     {maroon, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{p, p + 0.45 r sign {-Sin[sign ph], Cos[sign ph]}}]}, Text[Style[\"v\", Italic, Bold, 13, maroon], p + 0.58 r sign {-Sin[sign ph], Cos[sign ph]}],
     {blue, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{p, 0.55 p}]}, Text[Style[\"F_B\", Bold, 12, blue], 0.45 p + 0.12 r {1, 0}],
     particleG[p, sign, 0.07 r], Text[Style[\"B into the page\", 11, green], {0, 1.3 r}]},
    PlotRange -> 1.45 r, AspectRatio -> Automatic, ImageSize -> 380];
  Column[{fig,
    Plot[vOrbit[q, b, rr/100., m]/10^6, {rr, 0, Max[50, 1.3 rcm]}, PlotStyle -> Directive[maroon, Thick], Frame -> True, FrameLabel -> {\"r (cm)\", \"v (10^6 m/s)\"}, PlotRange -> {0, All},
     GridLines -> {{rcm}, None}, GridLinesStyle -> Directive[gold, Dashed], Epilog -> {gold, PointSize[0.02], Point[{rcm, v/10^6}]}, ImageSize -> 400],
    results[{
      {\"v = qBr/m\", Row[{ScientificForm[v, 3], \" m/s  (\", NumberForm[100 v/cLight, 3], \" % of c)\"}]},
      {\"period T = 2\\[Pi]m/qB\", Row[{ScientificForm[T, 3], \" s  (\", ScientificForm[1/T, 3], \" rev/s)\"}]},
      {\"cyclotron frequency \\[Omega] = qB/m\", Row[{ScientificForm[q b/m, 3], \" rad/s\"}]},
      {\"force qvB = mv\\.b2/r\", Row[{ScientificForm[q v b, 3], \" N\"}]}}]}, Spacings -> 1]],
 {{rcm, 14., \"orbit radius r (cm)\"}, 0.01, 50, 0.01, Appearance -> \"Labeled\"},
 {{b, 0.35, \"field B (T)\"}, 0.01, 2, 0.01, Appearance -> \"Labeled\"},
 {{part, \"proton\", \"particle\"}, {\"proton\", \"electron\", \"alpha\"}},
 {{phdeg, 30, \"position on the orbit (\\[Degree])\"}, 0, 360, 2, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {rcm, b, part, phdeg}]", "Input"],

Cell["What if? - an electron at the same speed", "Section"],

Cell["(* r is proportional to m at fixed q, B and v: the electron's radius is smaller by m_e/m_p. *)
With[{v = vOrbit[qe, 0.35, 0.14, mp]}, {me v/(qe 0.35), 0.14 me/mp}]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* m dv/dt = q v x B integrated numerically for one period: the orbit closes, the radius and the speed stay constant. *)
With[{q = qe, m = mp, b = 0.35, r = 0.14},
 Module[{v = vOrbit[q, b, r, m], T = periodT[q, b, m], sol},
  sol = NDSolve[{m x''[t] == q (y'[t] (-b)), m y''[t] == -q (x'[t] (-b)), x[0] == r, y[0] == 0, x'[0] == 0, y'[0] == v}, {x, y}, {t, 0, T}, MaxSteps -> 10^5][[1]];
  Grid[{{\"v = qBr/m (m/s)\", v}, {\"distance from the start after one period (m)\", Norm[{x[T] - r, y[T]} /. sol]}, {\"radius at T/4, T/2 (m)\", {Norm[{x[T/4], y[T/4]} /. sol], Norm[{x[T/2], y[T/2]} /. sol]}},
    {\"speed at T/3 (m/s)\", Norm[{x'[T/3], y'[T/3]} /. sol]}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
