(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 28.4 - Force on a Semicircular Conductor", "Title"],

Cell["PHYS 193 \:00b7 Week 8 \:00b7 Chapter 28 \:00b7 Lecture slide 58 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A wire bent into a semicircle of radius R forms a closed circuit carrying a current I, in the xy plane, in a uniform field B along +y. Find the force on the straight portion and on the curved portion.", "Text"],

Cell["Straight portion: F1 = I (2R) B out of the page. Curved portion: dF2 = -I B sin(theta) R dtheta, integrated from 0 to Pi: F2 = -2 I R B (into the page). The curved wire feels the same force as a straight wire between its ends, and the closed loop feels no net force.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 28.20: a closed loop made of a straight portion along the x axis and a semicircle of radius R, carrying a current I, in a uniform field B along +y. The element ds at angle \:03b8 feels a force into the page; the straight portion feels a force out of the page. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the magnetic force on moving charges and currents, circular motion in a field, the torque on a current loop and the Hall effect; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
qe = 1.602 10.^-19; me = 9.109 10.^-31; mp = 1.673 10.^-27; cLight = 2.998 10.^8;
particleG[p_, sign_, r_ : 0.08] := {{If[sign < 0, blue, maroon], Disk[p, r]}, {ink, Circle[p, r]}, Text[Style[If[sign < 0, \"\\[Minus]\", \"+\"], White, Bold, 12], p]};
(* z component of I Integral ds x B along a parametrised path p[t], t from 0 to Pi, for B = {bx, by, 0} *)
tangent[p_, t_] := (p[t + 10.^-5] - p[t - 10.^-5])/(2 10.^-5);     (* numerical derivative, safe for piecewise paths *)
forceZ[p_, i_, {bx_, by_}] := i NIntegrate[tangent[p, t][[1]] by - tangent[p, t][[2]] bx, {t, 10.^-4, Pi - 10.^-4}];
semi[r_][t_] := r {Cos[t], Sin[t]};
tri[r_][t_] := If[t < Pi/2, {r - r t/(Pi/2), 1.2 r t/(Pi/2)}, {-r (t - Pi/2)/(Pi/2), 1.2 r (1 - (t - Pi/2)/(Pi/2))}];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{r = rcm/100., bv = b {Cos[al Degree], Sin[al Degree]}, f1, f2, path, pts, p, tang, dF, fig},
  path = If[shape == \"semicircle\", semi[r], tri[r]]; f1 = 2 i r b Sin[al Degree]; f2 = forceZ[path, i, bv];
  pts = Table[path[t], {t, 0, Pi, Pi/120}]; p = path[th Degree]; tang = Normalize[(path[th Degree + 0.001] - path[th Degree - 0.001])]; dF = i (tang[[1]] bv[[2]] - tang[[2]] bv[[1]]);
  fig = Graphics[{With[{u = {Cos[al Degree], Sin[al Degree]}, nv = {-Sin[al Degree], Cos[al Degree]}}, Table[{green, Opacity[0.5], Arrowheads[0.02], Arrow[{k 0.35 r nv - 1.6 r u + {0, 0.55 r}, k 0.35 r nv + 1.6 r u + {0, 0.55 r}}]}, {k, -5, 5}]],
     {GrayLevel[0.6], AbsoluteThickness[7], Line[pts], Line[{{-r, 0}, {r, 0}}]}, {GrayLevel[0.75], Line[{{-1.4 r, 0}, {1.4 r, 0}}], Line[{{0, -0.3 r}, {0, 1.5 r}}]},
     Text[Style[\"x\", Italic, 12], {1.45 r, -0.08 r}], Text[Style[\"y\", Italic, 12], {0.08 r, 1.5 r}],
     {RGBColor[0.48, 0.25, 0.69], AbsoluteThickness[2], Arrowheads[0.035], Arrow[{{-0.2 r, -0.14 r}, {0.2 r, -0.14 r}}]}, Text[Style[\"I\", Italic, Bold, 12, RGBColor[0.48, 0.25, 0.69]], {0.3 r, -0.14 r}],
     {maroon, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{p, p + 0.3 r tang}]}, Text[Style[\"ds\", Italic, Bold, 12, maroon], p + 0.42 r tang],
     If[shape == \"semicircle\", {{GrayLevel[0.7], Dashed, Line[{{0, 0}, p}]}, Text[Style[\"R\", Italic, 12], 0.5 p + {-0.1 r, 0}], {gold, Circle[{0, 0}, 0.25 r, {0, th Degree}]}, Text[Style[\"\\[Theta]\", Italic, 12, gold], 0.35 r {Cos[th Degree/2], Sin[th Degree/2]}]}, {}],
     If[dF < 0, crossG[p - 0.2 r {-tang[[2]], tang[[1]]}, 0.05 r + 0.06 r Abs[dF]/(i r b), blue], dotG[p - 0.2 r {-tang[[2]], tang[[1]]}, 0.05 r + 0.06 r Abs[dF]/(i r b), blue]],
     If[f1 > 0, dotG[{0, 0}, 0.08 r, blue], crossG[{0, 0}, 0.08 r, blue]],
     Text[Style[Row[{\"F1 = \", NumberForm[Abs[f1], 3], \" N \", If[f1 >= 0, \"out of\", \"into\"], \" the page\"}], 11, Bold, blue], {0, -0.32 r}],
     Text[Style[Row[{\"F2 = \", NumberForm[Abs[f2], 3], \" N \", If[f2 < 0, \"into\", \"out of\"], \" the page\"}], 11, Bold, blue], {0, 1.62 r}]},
    PlotRange -> {{-1.5 r, 1.5 r}, {-0.45 r, 1.75 r}}, AspectRatio -> Automatic, ImageSize -> 420];
  Column[{fig,
    Plot[i (tangent[path, t][[1]] bv[[2]] - tangent[path, t][[2]] bv[[1]]), {t, 0.001, Pi - 0.001}, PlotStyle -> Directive[blue, Thick], Filling -> Axis, Frame -> True, FrameLabel -> {\"\\[Theta] (rad)\", \"dF2/d\\[Theta] (N/rad)\"},
     GridLines -> {{th Degree}, None}, GridLinesStyle -> Directive[gold, Dashed], ImageSize -> 420],
    results[{
      {\"F1 on the straight portion = 2IRB sin \\[Alpha]\", Row[{NumberForm[f1, 4], \" N (+z = out of the page)\"}]},
      {\"F2 on the curved portion\", Row[{NumberForm[f2, 4], \" N\"}]},
      {\"F1 + F2\", Row[{NumberForm[Chop[f1 + f2, 10^-9], 3], \" N: no net force on the closed loop\"}]}}]}, Spacings -> 1]],
 {{i, 5., \"current I (A)\"}, 0.5, 20, 0.5, Appearance -> \"Labeled\"},
 {{rcm, 10., \"radius R (cm)\"}, 2, 30, 0.5, Appearance -> \"Labeled\"},
 {{b, 0.5, \"field B (T)\"}, 0.05, 2, 0.05, Appearance -> \"Labeled\"},
 {{al, 90, \"field direction from +x (\\[Degree])\"}, 0, 180, 5, Appearance -> \"Labeled\"},
 {{shape, \"semicircle\", \"shape of the curved part\"}, {\"semicircle\", \"triangle\"}},
 {{th, 60, \"element position \\[Theta] (\\[Degree])\"}, 1, 179, 1, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {i, rcm, b, al, shape, th}]", "Input"],

Cell["The integral, symbolically", "Section"],

Cell["(* -I R B Integral sin(theta) dtheta from 0 to Pi = -2 I R B, and the force on any curved wire between the same ends: I (Integral ds) x B. *)
{-I0 R0 B0 Integrate[Sin[t], {t, 0, Pi}], Cross[{2 R0, 0, 0}, {0, B0, 0}] I0}", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The force on the semicircle and on a triangle between the same ends, summed numerically, against 2 I R B; the straight portion; the sum. *)
With[{i = 5., r = 0.10, b = 0.5},
 Grid[{{\"F2 semicircle, numerical (N)\", forceZ[semi[r], i, {0, b}]}, {\"F2 triangle between the same ends (N)\", forceZ[tri[r], i, {0, b}]}, {\"-2IRB (N)\", -2 i r b}, {\"F1 = +2IRB (N)\", 2 i r b},
   {\"F1 + F2 (N)\", Chop[2 i r b + forceZ[semi[r], i, {0, b}], 10^-9]}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
