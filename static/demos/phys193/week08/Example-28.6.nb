(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 28.6 - The Hall Effect for Copper", "Title"],

Cell["PHYS 193 \:00b7 Week 8 \:00b7 Chapter 28 \:00b7 Lecture slide 83 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A copper strip 1.5 cm wide and 0.10 cm thick carries 5.0 A. Find the Hall voltage for a 1.2-T field perpendicular to the strip.", "Text"],

Cell["With one conduction electron per atom, n = N_A rho/M = 8.46 x 10^28 m^-3, and DeltaV_H = I B/(n q t) = 0.44 microvolt; the width cancels. What if? A semiconductor with n = 10^20 m^-3 and I = 0.10 mA gives 7.5 mV, easily measured.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 28.26: a flat conductor of width d and thickness t carries a current I along x in a magnetic field B along y. The carriers, drifting with velocity v_d, are pushed by the magnetic force F_B toward the top edge (c) whether they are negative or positive; the Hall voltage is measured between a and c. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from the magnetic force on moving charges and currents, circular motion in a field, the torque on a current loop and the Hall effect; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];(* inductor between p0 and p1: n semicircular bumps on the nv side *)
inductorG[p0_, p1_, n_ : 4, len_ : 0.7] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, r},
   a = m - u len/2; r = len/(2 n);
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{m + u len/2, p1}],
    maroon, AbsoluteThickness[2.5], Table[Circle[a + u r (2 k + 1), r, {0, Pi} + ArcTan @@ u], {k, 0, n - 1}]}];
(* AC source centred at p with radius r: a gold disc with a sine wave inside *)
acSourceG[p_, r_ : 0.22] :=
  {{gold, Disk[p, r]}, {maroon, AbsoluteThickness[1.8], Circle[p, r],
    Line[Table[p + {x, 0.55 r Sin[Pi x/(0.6 r)]}, {x, -0.6 r, 0.6 r, 0.05 r}]]}};
(* field/current marks: dotG = out of the page, crossG = into the page *)
dotG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Disk[p, 0.3 r]};
crossG[p_, r_ : 0.08, col_ : maroon] := {col, AbsoluteThickness[1.5], Circle[p, r], Line[{p + 0.6 r {-1, -1}, p + 0.6 r {1, 1}}], Line[{p + 0.6 r {-1, 1}, p + 0.6 r {1, -1}}]};
mu0 = 4 Pi 10.^-7;
qe = 1.602 10.^-19; me = 9.109 10.^-31; mp = 1.673 10.^-27; cLight = 2.998 10.^8;
particleG[p_, sign_, r_ : 0.08] := {{If[sign < 0, blue, maroon], Disk[p, r]}, {ink, Circle[p, r]}, Text[Style[If[sign < 0, \"\\[Minus]\", \"+\"], White, Bold, 12], p]};
nA = 6.022 10.^23; nCu = nA 8920./0.0635;
hallV[i_, b_, n_, t_] := i b/(n qe t);                 (* Equation 28.23 solved for the Hall voltage *)", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{i = 10.^logI, n = 10.^logn, t = tcm/100., d = dcm/100., vd, eh, vh, fig, sgn = If[carriers == \"holes\", 1, -1]},
  vd = i/(n qe t d); eh = vd b; vh = eh d;
  fig = Graphics[{Table[dotG[{x, y}, 0.03, RGBColor[0.18, 0.49, 0.31, 0.4]], {x, -1.2, 1.2, 0.3}, {y, -0.7, 0.7, 0.3}], Text[Style[\"B out of the page\", 10, green], {0.8, 0.75}],
     {GrayLevel[0.92], EdgeForm[{ink, Thick}], Rectangle[{-1, -0.4}, {1, 0.4}]},
     {RGBColor[0.48, 0.25, 0.69], AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{{-1.35, 0}, {-1.02, 0}}], Arrow[{{1.02, 0}, {1.35, 0}}]}, Text[Style[\"I\", Italic, Bold, 13, RGBColor[0.48, 0.25, 0.69]], {1.25, 0.12}],
     Table[{particleG[{x, 0.06 (-1)^k}, sgn, 0.06], {If[sgn > 0, maroon, blue], Arrowheads[0.03], Arrow[{{x + 0.1 sgn, 0.06 (-1)^k}, {x + 0.3 sgn, 0.06 (-1)^k}}]}, {gold, Arrowheads[0.03], Arrow[{{x, 0.06 (-1)^k - 0.08}, {x, 0.06 (-1)^k - 0.28}}]}}, {k, 0, 3}, {x, {-0.6 + 0.4 k}}] // Flatten,
     Text[Style[\"v_d\", Italic, Bold, 11, If[sgn > 0, maroon, blue]], {-0.6 + 0.35 sgn, 0.2}], Text[Style[\"F_B\", Bold, 11, gold], {0.1, -0.36}],
     (* q v x B pushes both kinds of carrier toward the bottom edge (a): the bottom carries the carriers' sign *)
     Table[Text[Style[If[sgn > 0, \"\\[Minus]\", \"+\"], 12, Bold, If[sgn > 0, blue, maroon]], {x, 0.33}], {x, -0.9, 0.9, 0.2}], Table[Text[Style[If[sgn > 0, \"+\", \"\\[Minus]\"], 12, Bold, If[sgn > 0, maroon, blue]], {x, -0.33}], {x, -0.9, 0.9, 0.2}],
     {RGBColor[0.54, 0.08, 0.22], Arrowheads[0.03], Arrow[If[sgn > 0, {{0.85, -0.25}, {0.85, 0.25}}, {{0.85, 0.25}, {0.85, -0.25}}]]}, Text[Style[\"E_H\", Bold, 10, RGBColor[0.54, 0.08, 0.22]], {0.95, 0}],
     Text[Style[\"c\", Italic, 12], {0, 0.5}], Text[Style[\"a\", Italic, 12], {0, -0.52}],
     Text[Style[Row[{\"\\[CapitalDelta]V_H = \", ScientificForm[vh, 3], \" V, \", If[sgn > 0, \"a\", \"c\"], \" positive\"}], 11, Bold, RGBColor[0.54, 0.08, 0.22]], {0, -0.85}]},
    PlotRange -> {{-1.45, 1.45}, {-0.95, 0.85}}, AspectRatio -> Automatic, ImageSize -> 420];
  Column[{fig,
    LogLogPlot[hallV[i, b, nn, t], {nn, 10^18, 10^29}, PlotStyle -> Directive[RGBColor[0.54, 0.08, 0.22], Thick], Frame -> True, FrameLabel -> {\"n (1/m\\.b3)\", \"\\[CapitalDelta]V_H (V)\"},
     GridLines -> {{n}, None}, GridLinesStyle -> Directive[gold, Dashed], Epilog -> {PointSize[0.02], blue, Point[Log[{nCu, hallV[5., 1.2, nCu, 0.001]}]], maroon, Point[Log[{10^20, hallV[10^-4, 1.2, 10^20, 0.001]}]], gold, Point[Log[{n, vh}]],
       Text[Style[\"copper, 5.0 A\", 9, blue], Log[{nCu, hallV[5., 1.2, nCu, 0.001]}], {1.2, -1}], Text[Style[\"silicon, 0.10 mA\", 9, maroon], Log[{10^20, hallV[10^-4, 1.2, 10^20, 0.001]}], {-1.2, -1}]}, ImageSize -> 420],
    results[{
      {\"carrier density n\", Row[{ScientificForm[n, 3], \" 1/m\\.b3\"}]},
      {\"drift speed v_d = I/nqA\", Row[{ScientificForm[vd, 3], \" m/s\"}]},
      {\"Hall field E_H = v_d B\", Row[{ScientificForm[eh, 3], \" V/m\"}]},
      {\"Hall voltage \\[CapitalDelta]V_H = E_H d = IB/nqt\", Row[{ScientificForm[vh, 3], \" V = \", NumberForm[10^6 vh, 3], \" \\[Mu]V\"}]}}]}, Spacings -> 1]],
 {{logI, Log10[5.], \"current I: log10(I/A)\"}, -4, 1, 0.05, Appearance -> \"Labeled\"},
 {{b, 1.2, \"field B (T)\"}, 0.05, 2, 0.05, Appearance -> \"Labeled\"},
 {{tcm, 0.1, \"thickness t (cm)\"}, 0.01, 0.5, 0.01, Appearance -> \"Labeled\"},
 {{dcm, 1.5, \"width d (cm)\"}, 0.2, 5, 0.1, Appearance -> \"Labeled\"},
 {{logn, Log10[nCu], \"carrier density: log10(n m\\.b3)\"}, 18, 29, 0.05, Appearance -> \"Labeled\"},
 {{carriers, \"electrons\", \"carriers\"}, {\"electrons\", \"holes\"}},
 ControlPlacement -> Left, TrackedSymbols :> {logI, b, tcm, dcm, logn, carriers}]", "Input"],

Cell["What if? - a semiconductor", "Section"],

Cell["(* The Hall voltage varies as 1/n: silicon with n = 10^20 and 0.10 mA gives millivolts. *)
{hallV[5., 1.2, nCu, 0.001], hallV[10.^-4, 1.2, 10.^20, 0.001]}", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* n for copper from N_A rho/M; the drift speed (which needs the width) and E_H d against I B/n q t (which does not). *)
With[{i = 5., b = 1.2, t = 0.001, d = 0.015},
 Module[{vd = i/(nCu qe t d)},
  Grid[{{\"n = N_A \\[Rho]/M (1/m\\.b3)\", nCu}, {\"v_d = I/(n q t d) (m/s)\", vd}, {\"\\[CapitalDelta]V_H = v_d B d (V)\", vd b d}, {\"\\[CapitalDelta]V_H = IB/nqt (V)\", hallV[i, b, nCu, t]}, {\"what if: 10^20 1/m\\.b3, 0.10 mA (V)\", hallV[10.^-4, 1.2, 10.^20, t]}},
   Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
