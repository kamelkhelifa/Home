(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Conceptual Example 30.5 - A Loop Moving Through a Magnetic Field", "Title"],

Cell["PHYS 193 \:00b7 Week 11 \:00b7 Chapter 30 \:00b7 Lecture slide 49 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A rectangular metallic loop of dimensions l and w and resistance R moves with constant speed v to the right as in Figure 30.14a, through a uniform magnetic field B into the page that extends a distance 3w along the x axis. x is the position of the right side of the loop. (A) Plot the flux through the loop against x. (B) Plot the induced motional emf against x. (C) Plot the applied force needed to keep v constant against x.", "Text"],

Cell["Flux: zero, then rising linearly to B l w while the loop enters, constant while it is fully inside, falling linearly while it leaves. emf: -B l v while entering (counterclockwise current), zero inside, +B l v while leaving (clockwise). Force: B^2 l^2 v/R while entering and leaving, zero inside. The book gives no numbers; the model uses B = 0.50 T, l = 10 cm, w = 5.0 cm, R = 0.20 ohm, v = 2.0 m/s.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 30.14a: a conducting rectangular loop of width w and height \:2113 moving with velocity v through a uniform magnetic field into the page that extends a distance 3w along the x axis. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from Faraday\:2019s law and Lenz\:2019s law; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
(* x in units of w; the field occupies 0 <= x <= 3 *)
overlap[xw_, w_] := w Max[0, Min[xw, 3] - Max[xw - 1, 0]];
fluxLoop[xw_, b_, l_, w_] := b l overlap[xw, w];
emfLoop[xw_, b_, l_, v_] := Piecewise[{{-b l v, 0 < xw < 1}, {b l v, 3 < xw < 4}}, 0];
forceLoop[xw_, b_, l_, v_, r_] := Piecewise[{{b^2 l^2 v/r, 0 < xw < 1 || 3 < xw < 4}}, 0];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{l = lcm/100., w = wcm/100., e, fr, fl, fig},
  e = emfLoop[x, b, l, v]; fr = fluxLoop[x, b, l, w]; fl = forceLoop[x, b, l, v, r];
  fig = Graphics[{
     {gold, Opacity[0.12], Rectangle[{0, -0.3}, {3, 1.8}]},
     Table[{gold, Text[Style[\"\\[Times]\", 11], {i, j}]}, {i, 0.15, 2.9, 0.3}, {j, -0.15, 1.7, 0.3}],
     {ink, AbsoluteThickness[4], Line[{{x - 1, 0.2}, {x, 0.2}, {x, 0.2 + l/w}, {x - 1, 0.2 + l/w}, {x - 1, 0.2}}]},
     {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{{x - 0.7, 0.45 + l/w}, {x - 0.3, 0.45 + l/w}}]}, Text[Style[\"v\", 13, Bold, Italic, maroon], {x - 0.5, 0.65 + l/w}],
     If[e != 0, {
       {RGBColor[0.48, 0.25, 0.69], AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{{x + 0.12, If[e < 0, 0.3, 0.1 + l/w]}, {x + 0.12, If[e < 0, 0.1 + l/w, 0.3]}}]},
       Text[Style[If[e < 0, \"I counterclockwise\", \"I clockwise\"], 11, Bold, RGBColor[0.48, 0.25, 0.69]], {x - 0.5, 0.2 + l/(2 w)}],
       {blue, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{{If[0 < x < 3, x, x - 1], 0.2 + 0.25 l/w}, {If[0 < x < 3, x, x - 1] - 0.5, 0.2 + 0.25 l/w}}]},
       {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{{x + 0.05, 0.2 + 0.75 l/w}, {x + 0.55, 0.2 + 0.75 l/w}}]}, Text[Style[\"F_app\", 11, Bold, maroon], {x + 0.8, 0.2 + 0.75 l/w}]}, {}],
     {GrayLevel[0.5], Line[{{-1.5, -0.4}, {4.6, -0.4}}]}, Table[Text[Style[ToString[k] <> \"w\", 10, Gray], {k, -0.6}], {k, 0, 4}]},
    PlotRange -> {{-1.6, 4.8}, {-0.8, 2.2 + l/w}}, AspectRatio -> Automatic, ImageSize -> 560];
  Column[{fig,
    GraphicsColumn[{
      Plot[1000 fluxLoop[s, b, l, w], {s, -0.5, 4.5}, PlotStyle -> Directive[green, Thick], Frame -> True, FrameLabel -> {\"\", \"(A) flux (mWb)\"}, GridLines -> {{0, 1, 3, 4, x}, {0}}, PlotRange -> All],
      Plot[emfLoop[s, b, l, v], {s, -0.5, 4.5}, PlotStyle -> Directive[maroon, Thick], Exclusions -> None, Frame -> True, FrameLabel -> {\"\", \"(B) emf (V)\"}, GridLines -> {{0, 1, 3, 4, x}, {0}}, PlotRange -> All],
      Plot[forceLoop[s, b, l, v, r], {s, -0.5, 4.5}, PlotStyle -> Directive[blue, Thick], Exclusions -> None, Frame -> True, FrameLabel -> {\"x / w\", \"(C) F (N)\"}, GridLines -> {{0, 1, 3, 4, x}, {0}}, PlotRange -> All]}, ImageSize -> 560],
    results[{{\"(A) flux\", Row[{NumberForm[1000 fr, 4], \" mWb\"}]}, {\"(B) emf\", Row[{NumberForm[e, 4], \" V\"}]}, {\"current\", Row[{NumberForm[Abs[e]/r, 4], \" A\"}]}, {\"(C) applied force\", Row[{NumberForm[fl, 4], \" N\"}]}}]}, Spacings -> 1.2]],
 {{b, 0.5, \"B (T)\"}, 0.1, 1.5, 0.05, Appearance -> \"Labeled\"},
 {{lcm, 10, \"l (cm)\"}, 2, 20, 0.5, Appearance -> \"Labeled\"},
 {{wcm, 5, \"w (cm)\"}, 2, 10, 0.5, Appearance -> \"Labeled\"},
 {{r, 0.2, \"R (ohm)\"}, 0.05, 2, 0.05, Appearance -> \"Labeled\"},
 {{v, 2, \"v (m/s)\"}, 0.2, 5, 0.1, Appearance -> \"Labeled\"},
 {{x, 0.5, \"x / w\"}, -0.5, 4.5, ControlType -> Animator, AnimationRate -> 0.8, AnimationRunning -> False},
 ControlPlacement -> Left, TrackedSymbols :> {b, lcm, wcm, r, v, x}]", "Input"],

Cell["Going further - where does the work go?", "Section"],

Cell["(* Over the whole trip the work by the applied force equals the heat in the loop, 2 (B^2 l^2 v/R) w. *)
With[{b = 0.5, l = 0.1, w = 0.05, r = 0.2, v = 2.},
 Grid[{{\"work, integral of F dx (J)\", NIntegrate[forceLoop[s, b, l, v, r] w, {s, -0.5, 0, 1, 3, 4, 4.5}]},
   {\"heat, integral of I\\.b2 R dt (J)\", NIntegrate[(emfLoop[s, b, l, v]/r)^2 r, {s, -0.5, 0, 1, 3, 4, 4.5}] w/v},
   {\"2 (B\\.b2 l\\.b2 v/R) w (J)\", 2 b^2 l^2 v/r w}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* The emf as the numerical time derivative of the geometric flux, against the piecewise formula. *)
With[{b = 0.5, l = 0.1, w = 0.05, v = 2., dt = 10.^-7},
 Grid[Prepend[Table[{xw, NumberForm[-(fluxLoop[xw + v dt/w, b, l, w] - fluxLoop[xw - v dt/w, b, l, w])/(2 dt), 6], NumberForm[emfLoop[xw, b, l, v], 6]}, {xw, {-0.3, 0.5, 1.5, 2.5, 3.5, 4.3}}],
   {\"x / w\", \"-dPhi/dt numerical (V)\", \"formula (V)\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
