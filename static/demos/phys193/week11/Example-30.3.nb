(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 30.3 - Motional emf Induced in a Rotating Bar", "Title"],

Cell["PHYS 193 \:00b7 Week 11 \:00b7 Chapter 30 \:00b7 Lecture slide 36 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A conducting bar of length l rotates with a constant angular speed omega about a pivot at one end. A uniform magnetic field B is directed perpendicular to the plane of rotation (Figure 30.10). Find the motional emf induced between the ends of the bar.", "Text"],

Cell["Each segment dr at distance r moves at v = r omega and contributes d(emf) = B v dr; the segments are in series, so emf = B omega integral of r dr = (1/2) B omega l^2. The What If? estimates a Ferris-wheel spoke in the Earth's field: about 1 mV, far too small to light a bulb, and any current would brake the wheel.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 30.10: a conducting bar of length \:2113 rotating about a pivot at one end in a uniform magnetic field perpendicular to the plane of rotation; a segment dr at distance r moves with speed v = r\:03c9. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from Faraday\:2019s law and Lenz\:2019s law; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
emfRot[b_, w_, l_] := b w l^2/2;", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{b = 10.^lb, w = 10.^lw, l = 10.^ll, e, fig, pts},
  e = emfRot[b, w, l];
  pts = Table[{k l/n, Sum[b ((j - 1/2) l/n w) l/n, {j, k}]}, {k, n}];
  fig = Graphics[{
     Table[{gold, Text[Style[\"\\[Times]\", 12], {i, j}]}, {i, -1.3, 1.3, 0.26}, {j, -1.3, 1.3, 0.26}],
     {GrayLevel[0.6], Dashed, Circle[{0, 0}, 1.08]},
     Rotate[{EdgeForm[ink], GrayLevel[0.93], Rectangle[{0, -0.05}, {1, 0.05}], Table[{ink, Line[{{k/n, -0.05}, {k/n, 0.05}}]}, {k, n - 1}]}, th, {0, 0}],
     Table[With[{r = (k - 1/2)/n}, {maroon, AbsoluteThickness[2], Arrowheads[0.03], Arrow[{r {Cos[th], Sin[th]}, r {Cos[th], Sin[th]} + 0.6 r {-Sin[th], Cos[th]}}]}], {k, n}],
     {Black, Disk[{0, 0}, 0.04]}, Text[Style[\"pivot (+)\", 11], {0, -0.14}],
     Text[Style[\"\\[Minus]\", 16, Bold, blue], 1.12 {Cos[th], Sin[th]}],
     Text[Style[\"\\[Omega] counterclockwise, B into the page\", 11, Gray], {0, 1.42}]},
    PlotRange -> 1.5, ImageSize -> 400];
  Column[{fig,
    Show[Plot[b w x^2/2, {x, 0, l}, PlotStyle -> Directive[maroon, Thick], PlotRange -> {0, 1.1 e}, Frame -> True, FrameLabel -> {\"distance from the pivot r (m)\", \"emf (V)\"},
      GridLines -> {None, {e}}, GridLinesStyle -> Directive[gold, Dashed], ImageSize -> 400],
     ListPlot[pts, PlotStyle -> {maroon, PointSize[0.015]}]],
    results[{
      {\"emf = (1/2) B \\[Omega] l\\.b2\", Row[{If[e < 0.01, Row[{NumberForm[1000 e, 4], \" mV\"}], Row[{NumberForm[e, 4], \" V\"}]]}]},
      {\"speed of the tip \\[Omega] l\", Row[{NumberForm[w l, 4], \" m/s\"}]},
      {\"sum over the n slices\", Row[{NumberForm[Last[pts][[2]], 4], \" V\"}]}}]}, Spacings -> 1.2]],
 {{lb, Log10[0.5], \"log10(B / T)\"}, -5, Log10[2], Appearance -> \"Labeled\"},
 {{lw, 1, \"log10(\\[Omega] / (rad/s))\"}, Log10[0.05], Log10[50], Appearance -> \"Labeled\"},
 {{ll, 0, \"log10(l / m)\"}, -1, Log10[20], Appearance -> \"Labeled\"},
 {{n, 6, \"slices\"}, 2, 20, 1, Appearance -> \"Labeled\"},
 {{th, 0.6, \"angle of the bar\"}, 0, 2 Pi, ControlType -> Animator, AnimationRate -> 1, AnimationRunning -> False},
 Delimiter,
 Row[{Button[\"Book-style values\", lb = Log10[0.5]; lw = 1; ll = 0], Button[\"Ferris wheel\", lb = Log10[0.5 10.^-4]; lw = Log10[2 Pi/10]; ll = 1]}],
 ControlPlacement -> Left, TrackedSymbols :> {lb, lw, ll, n, th}]", "Input"],

Cell["What if? A Ferris wheel in the Earth's field", "Section"],

Cell["(* B = 0.5 x 10^-4 T, spoke l ~ 10 m, period ~ 10 s: emf ~ 1 mV. *)
With[{b = 0.5 10.^-4, l = 10., w = 2 Pi/10.},
 Grid[{{\"\\[Omega] = 2\\[Pi]/T (1/s)\", NumberForm[w, 3]}, {\"emf = (1/2) B \\[Omega] l\\.b2 (V)\", ScientificForm[emfRot[b, w, l], 3]}, {\"in millivolts\", NumberForm[1000 emfRot[b, w, l], 3]}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Three routes for B = 0.5 T, omega = 10 rad/s, l = 1 m: the integral, the rate of sweeping flux B dA/dt with A = l^2 theta/2, and B l times the average speed. *)
With[{b = 0.5, w = 10., l = 1.},
 Grid[{{\"(1/2) B \\[Omega] l\\.b2\", emfRot[b, w, l]}, {\"NIntegrate[B \\[Omega] r, {r, 0, l}]\", NIntegrate[b w r, {r, 0, l}]},
   {\"B dA/dt, A = l\\.b2 \\[Theta]/2, \\[Theta] = \\[Omega] t\", b D[l^2 w t/2, t]}, {\"B l (\\[Omega] l/2)\", b l w l/2}}, Frame -> All, Alignment -> Left, FrameStyle -> GrayLevel[0.8]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
