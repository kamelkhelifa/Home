(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 30.2 - Magnetic Force Acting on a Sliding Bar", "Title"],

Cell["PHYS 193 \:00b7 Week 11 \:00b7 Chapter 30 \:00b7 Lecture slide 30 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["The conducting bar of Figure 30.9 moves on two frictionless parallel rails in a uniform magnetic field into the page. The bar has mass m and length l. It is given an initial velocity v_i to the right and released at t = 0. (A) Using Newton's laws, find the speed of the bar as a function of time. (B) Show that the same result is found by an energy approach.", "Text"],

Cell["The moving bar is a source of emf B l v, which drives I = B l v/R; the force on the current, -I l B, brakes the bar: m dv/dt = -(B^2 l^2/R) v, so v = v_i e^(-t/tau) with tau = m R/(B^2 l^2). The energy route, d(1/2 m v^2)/dt = -I^2 R, gives the same equation. The bar stops after a finite distance v_i tau. The book gives no numbers; the model starts from m = 0.100 kg, l = 0.400 m, B = 0.800 T, R = 0.500 ohm, v_i = 2.00 m/s.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 30.9: a conducting bar of length \:2113 sliding to the right with velocity v on two parallel rails in a uniform magnetic field into the page. The induced current I in the bar gives a magnetic force F_B opposite to the motion. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from Faraday\:2019s law and Lenz\:2019s law; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
tau[m_, r_, b_, l_] := m r/(b^2 l^2);
speed[t_, vi_, m_, r_, b_, l_] := vi Exp[-t/tau[m, r, b, l]];
position[t_, vi_, m_, r_, b_, l_] := vi tau[m, r, b, l] (1 - Exp[-t/tau[m, r, b, l]]);", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{tt = tau[m, r, b, l], v, x, fig, xmax},
  v = speed[t, vi, m, r, b, l]; x = position[t, vi, m, r, b, l]; xmax = vi tt;
  fig = Graphics[{
     Table[{gold, Text[Style[\"\\[Times]\", 12], {i, j}]}, {i, 0.3, 4.5, 0.4}, {j, 0.2, 2.8, 0.4}],
     {GrayLevel[0.6], AbsoluteThickness[6], Line[{{0, 0.5}, {4.6, 0.5}}], Line[{{0, 2.5}, {4.6, 2.5}}]},
     wire[{{0, 0.5}, {0, 1.1}}], wire[{{0, 1.9}, {0, 2.5}}], resistorG[{0, 1.1}, {0, 1.9}], lbl[\"R\", {-0.35, 1.5}, Italic],
     {RGBColor[0.72, 0.45, 0.1], Rectangle[{0.5 + 3.4 x/(1.05 xmax) - 0.08, 0.35}, {0.5 + 3.4 x/(1.05 xmax) + 0.08, 2.65}]},
     currentG[{0.5 + 3.4 x/(1.05 xmax) + 0.3, 1.9}, {0.5 + 3.4 x/(1.05 xmax) + 0.3 + 1.2 v/vi, 1.9}, 1, \"v\", 0, 1.2 v/vi],
     {blue, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{{0.5 + 3.4 x/(1.05 xmax) - 0.2, 1.0}, {0.5 + 3.4 x/(1.05 xmax) - 0.2 - 1.2 v/vi, 1.0}}]},
     Text[Style[\"F_B\", 12, Bold, blue], {0.5 + 3.4 x/(1.05 xmax) - 0.5 - 1.2 v/vi, 1.0}],
     {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{{0.5 + 3.4 x/(1.05 xmax), 1.2}, {0.5 + 3.4 x/(1.05 xmax), 1.8}}]},
     Text[Style[\"I\", 12, Bold, Italic, maroon], {0.5 + 3.4 x/(1.05 xmax) + 0.18, 1.5}],
     {gold, Dashed, Line[{{0.5 + 3.4/1.05, 0.3}, {0.5 + 3.4/1.05, 2.7}}]}, Text[Style[\"stops here\", 11, gold], {0.5 + 3.4/1.05, 2.85}]},
    PlotRange -> {{-0.7, 4.8}, {0, 3}}, AspectRatio -> Automatic, ImageSize -> 520];
  Column[{fig,
    Plot[{speed[s, vi, m, r, b, l]/vi, position[s, vi, m, r, b, l]/xmax}, {s, 0, 5 tt}, PlotStyle -> {Directive[maroon, Thick], Directive[blue, Thick]},
     PlotLegends -> Placed[{\"v / vi\", \"x / (vi tau)\"}, {Right, Center}], Frame -> True, FrameLabel -> {\"t (s)\", \"fraction\"}, GridLines -> {{tt}, None},
     Epilog -> {PointSize[0.02], maroon, Point[{t, v/vi}], blue, Point[{t, x/xmax}]}, ImageSize -> 520],
    results[{
      {\"tau = m R/(B\\.b2 l\\.b2)\", Row[{NumberForm[tt, 4], \" s\"}]},
      {\"v(t) = vi e^(-t/tau)\", Row[{NumberForm[v, 4], \" m/s\"}]},
      {\"I = B l v/R\", Row[{NumberForm[b l v/r, 4], \" A\"}]},
      {\"distance to rest, vi tau\", Row[{NumberForm[xmax, 4], \" m\"}]}}]}, Spacings -> 1.2]],
 {{vi, 2., \"initial speed vi (m/s)\"}, 0.2, 6, 0.1, Appearance -> \"Labeled\"},
 {{m, 0.1, \"mass m (kg)\"}, 0.02, 0.5, 0.01, Appearance -> \"Labeled\"},
 {{r, 0.5, \"resistance R (ohm)\"}, 0.1, 3, 0.05, Appearance -> \"Labeled\"},
 {{b, 0.8, \"field B (T)\"}, 0.1, 2, 0.05, Appearance -> \"Labeled\"},
 {{l, 0.4, \"bar length l (m)\"}, 0.1, 1, 0.01, Appearance -> \"Labeled\"},
 {{t, 0, \"time t (s)\"}, 0, 3, ControlType -> Animator, AnimationRate -> 0.5, AnimationRunning -> False},
 ControlPlacement -> Left, TrackedSymbols :> {vi, m, r, b, l, t}]", "Input"],

Cell["What if? Making the bar go farther", "Section"],

Cell["(* The distance is vi tau = vi m R/(B^2 l^2). Doubling vi or R doubles it; halving B quadruples it, because B is squared. *)
With[{d0 = 2. 0.1 0.5/(0.8^2 0.4^2)},
 Grid[Prepend[Table[{lab, NumberForm[fv 2. 0.1 fr 0.5/((fb 0.8)^2 0.4^2), 4], NumberForm[fv fr/fb^2, 3]},
     {{lab, fv, fr, fb}, {{\"none\", 1, 1, 1}, {\"vi x 2\", 2, 1, 1}, {\"R x 2\", 1, 2, 1}, {\"B x 1/2\", 1, 1, 0.5}, {\"vi x 1/2\", 0.5, 1, 1}, {\"B x 2\", 1, 1, 2}}}],
   {\"change\", \"distance (m)\", \"x starting distance\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]]]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Newton's law integrated numerically (NDSolve) against vi e^(-t/tau); and the energy balance: the kinetic energy lost equals the heat in the resistor. *)
With[{vi = 2., m = 0.1, r = 0.5, b = 0.8, l = 0.4},
 Module[{tt = tau[m, r, b, l], sol},
  sol = NDSolveValue[{m v'[s] == -b^2 l^2 v[s]/r, v[0] == vi}, v, {s, 0, 5 tt}, AccuracyGoal -> 12, PrecisionGoal -> 10];
  Column[{
    Grid[Prepend[Table[{k, NumberForm[sol[k tt], 8], NumberForm[speed[k tt, vi, m, r, b, l], 8]}, {k, {0.5, 1, 2, 3, 4}}], {\"t / tau\", \"NDSolve (m/s)\", \"formula (m/s)\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]],
    Row[{\"1/2 m vi\\.b2 = \", m vi^2/2, \" J;   integral of I\\.b2 R dt = \", NIntegrate[(b l speed[s, vi, m, r, b, l]/r)^2 r, {s, 0, Infinity}], \" J\"}]}]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
