(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Conceptual Example 30.4 - Application of Lenz's Law", "Title"],

Cell["PHYS 193 \:00b7 Week 11 \:00b7 Chapter 30 \:00b7 Lecture slide 47 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A magnet is placed near a metal loop as shown in Figure 30.13a. (A) Find the direction of the induced current in the loop when the magnet is pushed toward the loop. (B) Find the direction of the induced current when the magnet is pulled away.", "Text"],

Cell["Lenz's law: the induced current makes a field that opposes the change of flux. Magnet pushed in (flux to the right increasing): induced field to the left, the loop's near face is a north pole and repels the magnet. Magnet pulled away: induced field to the right, the near face is a south pole and attracts it. The model treats the magnet as a dipole of moment 1.0 A m^2 on the axis of a loop of radius 3.0 cm and resistance 0.10 ohm, so that the flux, emf and current can be plotted; the directions do not depend on these numbers.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 30.13a: a bar magnet moved toward a stationary metal loop with velocity v. Which way does the induced current flow? Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from Faraday\:2019s law and Lenz\:2019s law; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
mu0 = 4 Pi 10.^-7; mom = 1.0; aLoop = 0.03; rLoop = 0.10;
(* flux through the loop (positive to the right) for the magnet's centre a distance z to the left of the loop; sgn = +1 for the N pole facing the loop *)
flux[z_, sgn_] := mu0 sgn mom aLoop^2/(2 (aLoop^2 + z^2)^(3/2));
(* emf = -dPhi/dt with dz/dt = zdot (negative when pushed in). Positive current = clockwise seen from the magnet *)
emfLoop[z_, sgn_, zdot_] := -D[flux[zz, sgn], zz] zdot /. zz -> z;", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{sgn = If[pole == \"north\", 1, -1], zdot = If[motion == \"pushed toward the loop\", -1, 1] v, e, i, left, fig},
  e = emfLoop[z, sgn, zdot]; i = e/rLoop; left = If[i > 0, \"S\", \"N\"];
  fig = Graphics[{
     {GrayLevel[0.4], Rectangle[{-z - 0.06, -0.012}, {-z, 0.012}]}, {RGBColor[0.78, 0.18, 0.23], Rectangle[{-z, -0.012}, {-z + 0.06, 0.012}]},
     Text[Style[If[sgn > 0, \"S\", \"N\"], 13, Bold, White], {-z - 0.03, 0}], Text[Style[If[sgn > 0, \"N\", \"S\"], 13, Bold, White], {-z + 0.03, 0}],
     {maroon, AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{{-z, 0.03}, {-z + 0.03 Sign[zdot], 0.03}}]},
     Table[{green, Line[{{-z + 0.06, 0.006 k}, {0, 0.02 k}, {0.08, 0.035 k}}]}, {k, -2, 2}],
     {GrayLevel[0.7], AbsoluteThickness[5], Circle[{0, 0}, {0.006, aLoop}]},
     If[Abs[i] > 10^-9, {
       {RGBColor[0.48, 0.25, 0.69], AbsoluteThickness[3], Arrowheads[0.05], Arrow[{{0.009, If[i < 0, 0.012, -0.012]}, {0.009, If[i < 0, -0.012, 0.012]}}]},
       {RGBColor[0.48, 0.25, 0.69], AbsoluteThickness[2.5], Arrowheads[0.04], Arrow[{{-0.012 Sign[i], -0.02}, {0.012 Sign[i], -0.02}}]},
       Text[Style[\"induced B\", 10, RGBColor[0.48, 0.25, 0.69]], {0, -0.027}],
       Text[Style[left, 14, Bold, RGBColor[0.48, 0.25, 0.69]], {-0.016, 0.036}], Text[Style[If[left == \"S\", \"N\", \"S\"], 14, Bold, RGBColor[0.48, 0.25, 0.69]], {0.016, 0.036}]}, {}]},
    PlotRange -> {{-0.2, 0.09}, {-0.05, 0.05}}, AspectRatio -> Automatic, ImageSize -> 520];
  Column[{fig,
    Plot[Evaluate[{10^6 flux[x, sgn], 10^3 emfLoop[x, sgn, zdot]/rLoop}], {x, 0.02, 0.14}, PlotStyle -> {Directive[green, Thick], Directive[RGBColor[0.48, 0.25, 0.69], Thick]},
     PlotLegends -> Placed[{\"flux (\\[Mu]Wb)\", \"current (mA), clockwise seen from the magnet\"}, Below], Frame -> True, FrameLabel -> {\"distance z (m)\", \"\"},
     GridLines -> {{z}, {0}}, ImageSize -> 520],
    results[{
      {\"flux is\", If[motion == \"pushed toward the loop\", \"increasing in size\", \"decreasing in size\"]},
      {\"induced current\", Row[{NumberForm[1000 Abs[i], 3], \" mA, \", If[i < 0, \"counterclockwise\", \"clockwise\"], \" as seen from the magnet\"}]},
      {\"loop's faces (toward magnet | away)\", Row[{left, \" | \", If[left == \"S\", \"N\", \"S\"]}]},
      {\"force on the magnet\", If[left == If[sgn > 0, \"N\", \"S\"], \"repulsion\", \"attraction\"]}}]}, Spacings -> 1.2]],
 {{motion, \"pushed toward the loop\"}, {\"pushed toward the loop\", \"pulled away\"}},
 {{pole, \"north\", \"pole facing the loop\"}, {\"north\", \"south\"}},
 {{v, 0.3, \"speed (m/s)\"}, 0.05, 1, 0.01, Appearance -> \"Labeled\"},
 {{z, 0.08, \"distance z (m)\"}, 0.02, 0.14, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {motion, pole, v, z}]", "Input"],

Cell["Going further - all four cases", "Section"],

Cell["(* Whatever is done, the force on the magnet opposes its motion: the energy heating the loop comes from the work done against that force. *)
Grid[Prepend[Table[With[{e = emfLoop[0.06, sgn, zd], sgnN = sgn},
    With[{left = If[e > 0, \"S\", \"N\"], facing = If[sgnN > 0, \"N\", \"S\"]},
     {If[zd < 0, \"pushed in\", \"pulled away\"], facing, left, If[left == facing, \"repulsion\", \"attraction\"], If[(left == facing) == (zd < 0), \"yes\", \"NO\"]}]],
   {sgn, {1, -1}}, {zd, {-1, 1}}] // Flatten[#, 1] &,
  {\"magnet\", \"pole facing the loop\", \"loop face toward the magnet\", \"force\", \"opposes the motion?\"}], Frame -> All, FrameStyle -> GrayLevel[0.8]]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* -dPhi/dt by numerical differentiation along the path, against the exact derivative, for the magnet pushed in at 0.3 m/s. *)
With[{sgn = 1, zdot = -0.3, z = 0.08, dt = 10.^-7},
 Grid[{{\"numerical (V)\", -(flux[z + zdot dt, sgn] - flux[z - zdot dt, sgn])/(2 dt)}, {\"exact (V)\", emfLoop[z, sgn, zdot]}}, Frame -> All, FrameStyle -> GrayLevel[0.8]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
