(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 30.6 - Electric Field Induced by a Changing Magnetic Field in a Solenoid", "Title"],

Cell["PHYS 193 \:00b7 Week 11 \:00b7 Chapter 30 \:00b7 Lecture slide 59 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A long solenoid of radius R has n turns per unit length and carries a current I = Imax cos(omega t) (Figure 30.16). (A) Find the magnitude of the induced electric field outside the solenoid, at r > R. (B) Inside, at r < R.", "Text"],

Cell["Faraday's law in integral form around a circle of radius r: E (2 pi r) = -dPhi/dt. Outside, the flux is B pi R^2 with B = mu0 n Imax cos(omega t), so E = mu0 n Imax omega R^2 sin(omega t)/(2 r). Inside the flux is B pi r^2, so E = mu0 n Imax omega r sin(omega t)/2. The two agree at r = R. The book gives no numbers; the model uses R = 2.0 cm, n = 1000 /m, Imax = 5.0 A, f = 60 Hz.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 30.16: a long solenoid of radius R carrying a time-varying current I = I_max cos \:03c9t, with a circular path of integration of radius r around its axis. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from Faraday\:2019s law and Lenz\:2019s law; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
mu0 = 4 Pi 10.^-7;
eField[r_, rr_, n_, imax_, w_, t_] := If[r < rr, mu0 n imax w r/2, mu0 n imax w rr^2/(2 r)] Sin[w t];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{rr = rcm/100., w = 2 Pi f, t, k, em, ccw, fig},
  t = ph Degree/w; k = mu0 n imax w; em = k rr/2; ccw = Sin[ph Degree] > 0;
  fig = Graphics[{
     {green, Opacity[0.15], Disk[{0, 0}, 1]}, {ink, Circle[{0, 0}, 1]},
     Table[If[i^2 + j^2 < 0.85, {green, Text[Style[If[Cos[ph Degree] > 0, \"\\[CircleDot]\", \"\\[Times]\"], 11], {i, j}]}, {}], {i, -0.9, 0.9, 0.2}, {j, -0.9, 0.9, 0.2}],
     Table[With[{rp = fr, ev = eField[fr rr, rr, n, imax, w, t]/em},
       {{GrayLevel[0.7], Dashed, Circle[{0, 0}, rp]},
        If[Abs[ev] > 0.05, Table[With[{a = 2 Pi kk/nn + 0.3}, {maroon, AbsoluteThickness[2], Arrowheads[0.025],
            Arrow[{rp {Cos[a], Sin[a]} - 0.25 Abs[ev] If[ccw, 1, -1] {-Sin[a], Cos[a]}, rp {Cos[a], Sin[a]} + 0.25 Abs[ev] If[ccw, 1, -1] {-Sin[a], Cos[a]}}]}], {kk, nn}], {}]}],
      {{fr, nn}, {{0.35, 6}, {0.7, 6}, {1.25, 10}, {1.6, 10}, {2.0, 12}}}],
     Text[Style[Row[{\"B \", If[Cos[ph Degree] > 0, \"out of the page\", \"into the page\"], \", \", If[(Sin[ph Degree] > 0) == (Cos[ph Degree] > 0), \"decreasing\", \"increasing\"]}], 11, green], {0, 2.3}],
     Text[Style[Row[{\"E \", If[Abs[Sin[ph Degree]] < 0.02, \"= 0 at this instant\", If[ccw, \"counterclockwise\", \"clockwise\"]]}], 11, Bold, maroon], {0, -2.3}]},
    PlotRange -> 2.5, ImageSize -> 400];
  Column[{fig,
    Plot[{eField[x/100, rr, n, imax, w, t], If[x/100 < rr, k x/100/2, k rr^2/(2 x/100)], -If[x/100 < rr, k x/100/2, k rr^2/(2 x/100)]}, {x, 0.001, 4 rcm},
     PlotStyle -> {Directive[maroon, Thick], Directive[Gray, Dashed], Directive[Gray, Dashed]}, PlotLegends -> Placed[{\"E now\", \"amplitude\", \"\"}, {Right, Top}],
     Frame -> True, FrameLabel -> {\"r (cm)\", \"E (V/m)\"}, GridLines -> {{rcm}, {0}}, ImageSize -> 480],
    results[{
      {\"B inside = \\[Mu]0 n I\", Row[{NumberForm[1000 mu0 n imax Cos[ph Degree], 4], \" mT\"}]},
      {\"E at the wall r = R\", Row[{NumberForm[1000 eField[rr, rr, n, imax, w, t], 4], \" mV/m\"}]},
      {\"amplitude at the wall, \\[Mu]0 n Imax \\[Omega] R/2\", Row[{NumberForm[1000 em, 4], \" mV/m\"}]}}]}, Spacings -> 1.2]],
 {{rcm, 2., \"solenoid radius R (cm)\"}, 0.5, 5, 0.1, Appearance -> \"Labeled\"},
 {{n, 1000, \"turns per metre n\"}, 100, 5000, 50, Appearance -> \"Labeled\"},
 {{imax, 5., \"Imax (A)\"}, 0.5, 20, 0.5, Appearance -> \"Labeled\"},
 {{f, 60., \"frequency f (Hz)\"}, 10, 1000, Appearance -> \"Labeled\"},
 {{ph, 90, \"phase \\[Omega]t (degrees)\"}, 0, 360, ControlType -> Animator, AnimationRate -> 60, AnimationRunning -> False},
 ControlPlacement -> Left, TrackedSymbols :> {rcm, n, imax, f, ph}]", "Input"],

Cell["Going further - the direction of E", "Section"],

Cell["(* Lenz's law for the induced E: while B (out of the page) decreases, E circulates counterclockwise so as to drive a current that would restore B. The arrows flip when sin(omega t) changes sign, i.e. when I is at an extreme and B is momentarily not changing. E is largest when I passes through zero. *)
Plot[{Cos[x], Sin[x]}, {x, 0, 4 Pi}, PlotStyle -> {Directive[green, Thick], Directive[maroon, Thick]}, PlotLegends -> Placed[{\"I and B, \\[Proportional] cos \\[Omega]t\", \"E, \\[Proportional] sin \\[Omega]t\"}, Below],
 Frame -> True, FrameLabel -> {\"\\[Omega]t\", \"\"}, GridLines -> {Range[0, 4 Pi, Pi/2], {0}}, ImageSize -> 480]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Faraday's law tested numerically: the flux through a circle of radius r (NIntegrate over the area, B = 0 beyond the wall) differentiated in time, against 2 pi r E from the formulas. *)
With[{rr = 0.02, n = 1000, imax = 5., w = 2 Pi 60., t = 0.25/60.},
 Module[{bf, fl},
  bf[s_, tt_] := If[s < rr, mu0 n imax Cos[w tt], 0];
  fl[r_, tt_] := NIntegrate[2 Pi s bf[s, tt], {s, 0, Min[r, rr]}];
  Grid[Prepend[Table[With[{r = f rr, dt = 10.^-8},
      {f, NumberForm[-(fl[r, t + dt] - fl[r, t - dt])/(2 dt), 7], NumberForm[2 Pi r eField[r, rr, n, imax, w, t], 7]}], {f, {0.3, 0.8, 1., 1.5, 3.}}],
    {\"r / R\", \"-dPhi/dt numerical (V)\", \"2 \\[Pi] r E formula (V)\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
