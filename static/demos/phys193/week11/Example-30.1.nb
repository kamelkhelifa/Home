(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 30.1 - Inducing an emf in a Coil", "Title"],

Cell["PHYS 193 \:00b7 Week 11 \:00b7 Chapter 30 \:00b7 Lecture slide 17 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["A coil consists of 200 turns of wire. Each turn is a square of side d = 18 cm, and a uniform magnetic field directed perpendicular to the plane of the coil is turned on. From t = 0 to t = 0.80 s the field changes linearly from 0 to 0.50 T; after t = 0.80 s it decays as B = Bmax exp(-a t), with Bmax = 0.50 T and a unknown. (A) Magnitude of the induced emf between t = 0 and t = 0.80 s? (B) After t = 0.80 s?", "Text"],

Cell["Faraday's law: emf = -N dPhi/dt = -N d^2 dB/dt. During the ramp the emf is constant, N d^2 Bmax/Delta t = 4.0 V; afterwards it is 3.2 a e^(-a t) V and decays. The model writes the decay as Bmax e^(-a (t - 0.80 s)) so that the field is continuous at the peak, as in Figure 30.6. The What If? connects the coil to a 2.0-ohm circuit: I = 2.0 A during the ramp.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 30.6: the magnitude of the uniform magnetic field through the coil rises linearly to B_max at t = 0.80 s and then decays exponentially. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from Faraday\:2019s law and Lenz\:2019s law; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
bField[t_, bmax_, tr_, a_] := Piecewise[{{bmax t/tr, 0 <= t <= tr}, {bmax Exp[-a (t - tr)], t > tr}}, 0];
emf[t_, n_, d_, bmax_, tr_, a_] := -n d^2 D[bField[tt, bmax, tr, a], tt] /. tt -> t;", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{d = dcm/100., e1, et, bt},
  e1 = n d^2 bmax/tr; bt = bField[t, bmax, tr, a]; et = emf[t, n, d, bmax, tr, a];
  Column[{
    Plot[bField[x, bmax, tr, a], {x, 0, 3}, PlotStyle -> Directive[green, Thick], PlotRange -> {0, 1.15 bmax}, Exclusions -> None,
     Frame -> True, FrameLabel -> {\"t (s)\", \"B (T)\"}, GridLines -> {{tr}, None}, Epilog -> {maroon, PointSize[0.02], Point[{t, bt}]}, ImageSize -> 480],
    Plot[emf[x, n, d, bmax, tr, a], {x, 0, 3}, PlotStyle -> Directive[maroon, Thick], Exclusions -> {tr}, ExclusionsStyle -> Dashed,
     Frame -> True, FrameLabel -> {\"t (s)\", \"emf (V)\"}, GridLines -> {{tr}, {0}}, Epilog -> {maroon, PointSize[0.02], Point[{t, et}]}, ImageSize -> 480],
    results[{
      {\"(A) |emf| during the ramp, N d\\.b2 Bmax/\\[CapitalDelta]t\", Row[{NumberForm[e1, 4], \" V\"}]},
      {\"B(t)\", Row[{NumberForm[bt, 4], \" T\"}]},
      {\"emf at t\", Row[{NumberForm[et, 4], \" V\"}]},
      {\"(B) after the ramp: |emf| = a N d\\.b2 Bmax e^(-a(t - tr))\", Row[{NumberForm[n d^2 bmax, 3], \" a e^(-a(t - \", NumberForm[tr, 2], \"))  V\"}]},
      {\"What if? current with R connected\", If[connected, Row[{NumberForm[Abs[et]/r, 4], \" A\"}], \"0 (ends open)\"]}}]}, Spacings -> 1.2]],
 {{n, 200, \"turns N\"}, 1, 400, 1, Appearance -> \"Labeled\"},
 {{dcm, 18, \"side d (cm)\"}, 2, 40, 1, Appearance -> \"Labeled\"},
 {{bmax, 0.50, \"Bmax (T)\"}, 0.05, 1.5, 0.05, Appearance -> \"Labeled\"},
 {{tr, 0.80, \"ramp time (s)\"}, 0.1, 2, 0.05, Appearance -> \"Labeled\"},
 {{a, 2., \"decay constant a (1/s), not given\"}, 0.5, 10, 0.1, Appearance -> \"Labeled\"},
 {{t, 0.4, \"time t (s)\"}, 0, 3, 0.01, Appearance -> \"Labeled\"},
 {{connected, False, \"ends connected (What if?)\"}, {False, True}},
 {{r, 2.0, \"total resistance R (ohm)\"}, 0.5, 10, 0.1, Appearance -> \"Labeled\"},
 ControlPlacement -> Left, TrackedSymbols :> {n, dcm, bmax, tr, a, t, connected, r}]", "Input"],

Cell["What if? The current while the field ramps", "Section"],

Cell["(* With the ends joined through a total resistance of 2.0 ohm, I = |emf|/R = 4.0 V / 2.0 ohm = 2.0 A. With the ends open there is no current at all. *)
With[{e1 = 200 (0.18)^2 0.50/0.80}, Grid[{{\"|emf| (V)\", e1}, {\"I = |emf|/R (A), R = 2.0 ohm\", e1/2.0}}, Frame -> All, FrameStyle -> GrayLevel[0.8]]]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Book values. The emf by numerical differentiation of N Phi(t), against the formulas; and the integral of the emf over the ramp against -N A Bmax. *)
With[{n = 200, d = 0.18, bmax = 0.50, tr = 0.80, a = 2.},
 Module[{phi, num},
  phi[t_] := n d^2 bField[t, bmax, tr, a];
  num[t_] := -(phi[t + 10.^-6] - phi[t - 10.^-6])/(2 10.^-6);
  Column[{
    Grid[Prepend[Table[{t, NumberForm[num[t], 7], NumberForm[emf[t, n, d, bmax, tr, a], 7]}, {t, {0.2, 0.5, 0.9, 1.3, 2.3}}], {\"t (s)\", \"numerical (V)\", \"formula (V)\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]],
    Row[{\"integral of the emf over the ramp: \", NIntegrate[emf[t, n, d, bmax, tr, a], {t, 0, tr}], \"   -N A Bmax: \", -n d^2 bmax}]}]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
