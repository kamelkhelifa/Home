(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{

Cell["Example 30.7 - emf Induced in a Generator", "Title"],

Cell["PHYS 193 \:00b7 Week 11 \:00b7 Chapter 30 \:00b7 Lecture slide 75 \:00b7 Serway & Jewett, Physics for Scientists and Engineers, 11th ed.", "Subtitle"],

Cell["The coil in an AC generator consists of 8 turns of wire, each of area A = 0.0900 m^2, and the total resistance of the wire is 12.0 ohm. The coil rotates in a 0.500-T magnetic field at a constant frequency of 60.0 Hz. (A) Find the maximum induced emf in the coil. (B) What is the maximum induced current when the output terminals are connected to a low-resistance conductor?", "Text"],

Cell["The flux is N A B cos(omega t), so emf = N A B omega sin(omega t) with peak N A B omega = 136 V, and Imax = 136 V / 12.0 ohm = 11.3 A. The emf peaks when the flux passes through zero.", "Text"],

Cell["Figure", "Subsection"],

Cell["Figure 30.18a: an AC generator. A coil rotates in a magnetic field; the induced emf is taken out through slip rings and brushes to an external circuit. Redrawn after the figure in Serway & Jewett, Physics for Scientists and Engineers, 11th ed. (The picture appears when the notebook is evaluated; the cell that holds it is collapsed.)", "Text"],

Cell["Image[ImportByteArray[BaseDecode[\"\"], \"PNG\"], ImageSize -> 440]", "Input", CellOpen -> False],

Cell["Evaluate the cells in order (Evaluation menu, Evaluate Notebook). Every number and figure is computed from Faraday\:2019s law and Lenz\:2019s law; the web version of this solution has the same physics.", "Text"],

Cell["Definitions - evaluate first", "Section"],

Cell["(* ---------- colours and circuit-drawing helpers (plain Graphics primitives) ---------- *)
maroon = RGBColor[0.54, 0.08, 0.22]; gold = RGBColor[0.66, 0.48, 0.18];
blue = RGBColor[0.14, 0.34, 0.72]; green = RGBColor[0.18, 0.49, 0.31]; ink = GrayLevel[0.15];
unitV[p0_, p1_] := (p1 - p0)/Norm[p1 - p0];
perpV[p0_, p1_] := With[{u = unitV[p0, p1]}, {-u[[2]], u[[1]]}];
(* a plain wire through a list of points *)
wire[pts_] := {ink, AbsoluteThickness[2], Line[pts]};
(* resistor between p0 and p1: a zigzag of length len (drawing units) in the middle of the segment *)
resistorG[p0_, p1_, col_ : maroon, len_ : 0.7, amp_ : 0.1] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, a, b},
   a = m - u len/2; b = m + u len/2;
   {ink, AbsoluteThickness[2], Line[{p0, a}], Line[{b, p1}],
    col, AbsoluteThickness[2.5], Line[Table[a + u len k/12 + nv amp {0, 1, 0, -1}[[Mod[k, 4] + 1]], {k, 0, 12}]]}];
(* battery between p0 and p1; the long thin plate is the positive terminal, on the p1 side when plusAtP1 is True *)
batteryG[p0_, p1_, plusAtP1_ : True] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.07, pl, mi},
   {pl, mi} = If[TrueQ[plusAtP1], {m + u g, m - u g}, {m - u g, m + u g}];
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    green, AbsoluteThickness[2.5], Line[{pl - nv 0.22, pl + nv 0.22}],
    AbsoluteThickness[5], Line[{mi - nv 0.11, mi + nv 0.11}],
    Text[Style[\"+\", 12, Bold, green], pl + 0.32 nv + 1.6 (pl - mi)]}];
(* capacitor between p0 and p1 *)
capacitorG[p0_, p1_] :=
  Module[{u = unitV[p0, p1], nv = perpV[p0, p1], m = (p0 + p1)/2, g = 0.06},
   {ink, AbsoluteThickness[2], Line[{p0, m - u g}], Line[{m + u g, p1}],
    blue, AbsoluteThickness[3], Line[{m - u g - 0.22 nv, m - u g + 0.22 nv}], Line[{m + u g - 0.22 nv, m + u g + 0.22 nv}]}];
(* arrow for a current i on the segment p0 -> p1, reversed when i < 0, drawn a distance off beside the wire *)
currentG[p0_, p1_, i_, lab_ : \"\", off_ : 0.18, len_ : 0.35] :=
  If[Abs[i] < 10^-12, {},
   Module[{u = Sign[i] unitV[p0, p1], nv = perpV[p0, p1], m},
    m = (p0 + p1)/2 + off nv;
    {maroon, AbsoluteThickness[2.5], Arrowheads[0.035], Arrow[{m - u len/2, m + u len/2}],
     If[lab === \"\", {}, Text[Style[lab, 12, Bold, maroon], m + 1.3 off nv]]}]];
(* a junction or labelled point *)
nodeG[p_, lab_ : \"\", d_ : {0.15, 0.15}] := {Black, PointSize[0.014], Point[p], If[lab === \"\", {}, Text[Style[lab, Italic, 14], p + d]]};
lbl[t_, p_, sty___] := Text[Style[t, 12, sty], p];
(* a small boxed table of results *)
results[rows_] := Grid[rows, Alignment -> Left, Frame -> All, FrameStyle -> GrayLevel[0.8], Spacings -> {2, 0.8}];
emfMax[n_, a_, b_, w_] := n a b w;
emfGen[t_, n_, a_, b_, w_] := n a b w Sin[w t];", "Input"],

Cell["Interactive solution", "Section"],

Cell["Manipulate[
 Module[{w = 2 Pi f, em, th = thd Degree, t, fig},
  em = emfMax[n, a, b, w]; t = th/w;
  fig = Graphics[{
     Table[{green, Arrowheads[0.025], Arrow[{{-1.4, y}, {1.4, y}}]}, {y, -0.9, 0.9, 0.3}], Text[Style[\"B\", 13, Bold, green], {1.5, 1.05}],
     {ink, AbsoluteThickness[6], Line[{-{Sin[th], Cos[th]}, {Sin[th], Cos[th]}}]}, {White, EdgeForm[ink], Disk[{0, 0}, 0.05]},
     {maroon, AbsoluteThickness[4], Line[{{1.2, -Abs[Cos[th]]}, {1.2, Abs[Cos[th]]}}]}, Text[Style[\"A cos \\[Theta]\", 11, maroon], {1.2, -1.15}],
     {GrayLevel[0.7], Dashed, Line[{{Sin[th], Cos[th]}, {1.2, Cos[th]}}], Line[{-{Sin[th], Cos[th]}, {1.2, -Cos[th]}}]},
     {gold, Circle[{0, 0}, 0.45, {Pi/2 - th, Pi/2}]}, Text[Style[\"\\[Theta]\", 13, Italic, gold], 0.58 {Sin[th/2], Cos[th/2]}]},
    PlotRange -> {{-1.6, 1.7}, {-1.3, 1.3}}, ImageSize -> 380];
  Column[{fig,
    Plot[{n a b Cos[w s]/(n a b), emfGen[s, n, a, b, w]/em}, {s, 0, 2 (2 Pi/w)}, PlotStyle -> {Directive[green, Thick], Directive[maroon, Thick]},
     PlotLegends -> Placed[{\"N\\[CapitalPhi]/(NAB)\", \"emf/emfmax\"}, Below], Frame -> True, FrameLabel -> {\"t (s)\", \"\"}, GridLines -> {{t}, {0}},
     Epilog -> {PointSize[0.02], green, Point[{t, Cos[th]}], maroon, Point[{t, Sin[th]}]}, ImageSize -> 480],
    results[{
      {\"(A) emfmax = N A B \\[Omega]\", Row[{NumberForm[em, 4], \" V\"}]},
      {\"(B) Imax = emfmax/R\", Row[{NumberForm[em/r, 4], \" A\"}]},
      {\"emf at this angle\", Row[{NumberForm[em Sin[th], 4], \" V\"}]},
      {\"flux N A B cos \\[Theta]\", Row[{NumberForm[n a b Cos[th], 4], \" Wb\"}]}}]}, Spacings -> 1.2]],
 {{n, 8, \"turns N\"}, 1, 50, 1, Appearance -> \"Labeled\"},
 {{a, 0.09, \"area A (m\\.b2)\"}, 0.01, 0.5, 0.005, Appearance -> \"Labeled\"},
 {{b, 0.5, \"B (T)\"}, 0.05, 1.5, 0.01, Appearance -> \"Labeled\"},
 {{f, 60., \"frequency f (Hz)\"}, 1, 120, 0.5, Appearance -> \"Labeled\"},
 {{r, 12., \"resistance R (ohm)\"}, 1, 50, 0.5, Appearance -> \"Labeled\"},
 {{thd, 30, \"angle \\[Theta] = \\[Omega]t (degrees)\"}, 0, 360, ControlType -> Animator, AnimationRate -> 90, AnimationRunning -> False},
 ControlPlacement -> Left, TrackedSymbols :> {n, a, b, f, r, thd}]", "Input"],

Cell["Going further - flux and emf a quarter cycle apart", "Section"],

Cell["(* The emf is zero when the flux is largest (theta = 0: not changing for an instant) and largest when the flux is zero (theta = 90 degrees: changing fastest). *)
Simplify[-D[nn aa bb Cos[ww tt], tt]]", "Input"],

Cell["Check the numbers", "Section"],

Cell["(* Book values: the emf by numerical differentiation of the flux against N A B omega sin(omega t), and the peak over one cycle. *)
With[{n = 8, a = 0.09, b = 0.5, w = 2 Pi 60., r = 12.},
 Module[{phi, dt = 10.^-8},
  phi[t_] := n a b Cos[w t];
  Column[{
    Grid[Prepend[Table[With[{t = d Degree/w}, {d, NumberForm[-(phi[t + dt] - phi[t - dt])/(2 dt), 7], NumberForm[emfGen[t, n, a, b, w], 7]}], {d, {0, 30, 90, 150, 270}}], {\"\\[Omega]t (deg)\", \"numerical (V)\", \"formula (V)\"}], Frame -> All, Alignment -> Right, FrameStyle -> GrayLevel[0.8]],
    Row[{\"peak over a cycle: \", NMaximize[{Abs[emfGen[t, n, a, b, w]], 0 <= t <= 2 Pi/w}, t][[1]], \"   N A B \\[Omega] = \", emfMax[n, a, b, w], \"   Imax = \", emfMax[n, a, b, w]/r, \" A\"}]}]]]", "Input"]

}, WindowSize -> {1280, 900}, WindowMargins -> Automatic, StyleDefinitions -> "Default.nb"]
